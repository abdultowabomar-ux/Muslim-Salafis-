    { id: 733, question: "ما حكم بيع الشتلات؟", answer: "بيع الشتلات جائز، لزراعتها، وهي من المباحات، وبيعها حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["شتلات", "بيع", "فقه", "زراعة"] },
    { id: 734, question: "ما حكم بيع الأسمدة؟", answer: "بيع الأسمدة جائز، لتحسين التربة، وهي من المباحات، وبيعها حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسمدة", "بيع", "فقه", "زراعة"] },
