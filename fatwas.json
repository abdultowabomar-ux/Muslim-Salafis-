    { id: 724, question: "ما حكم بيع البطاطين المستعملة؟", answer: "بيع البطاطين المستعملة جائز، مع غسلها وتنظيفها، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["بطاطين", "مستعملة", "بيع", "فقه"] },
    { id: 725, question: "ما حكم بيع الوسائد المستعملة؟", answer: "بيع الوسائد المستعملة جائز، مع غسلها وتنظيفها، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["وسائد", "مستعملة", "بيع", "فقه"] },
    { id: 726, question: "ما حكم بيع المفروشات المستعملة؟", answer: "بيع المفروشات المستعملة (سجاد، ستائر) جائز، مع تنظيفها، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مفروشات", "مستعملة", "بيع", "فقه"] },
    { id: 727, question: "ما حكم بيع الهدايا المستعملة؟", answer: "بيع الهدايا المستعملة جائز، إذا كانت في حالة جيدة، وليس فيها محذور شرعي.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["هدايا", "مستعملة", "بيع", "فقه"] },
    { id: 728, question: "ما حكم بيع الورود الطبيعية؟", answer: "بيع الورود الطبيعية جائز، وهي من النباتات المباحة، وبيعها حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ورود", "طبيعية", "بيع", "فقه"] },
    { id: 729, question: "ما حكم بيع الورود الصناعية؟", answer: "بيع الورود الصناعية (البلاستيكية) جائز، للزينة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ورود", "صناعية", "بيع", "فقه"] },
    { id: 730, question: "ما حكم بيع النباتات المنزلية؟", answer: "بيع النباتات المنزلية (الزينة) جائز، وهي من المباحات، وبيعها حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["نباتات", "منزلية", "بيع", "فقه"] },
