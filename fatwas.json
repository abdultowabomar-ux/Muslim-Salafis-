    { id: 815, question: "ما حكم بيع أجهزة التحكم في الجودة؟", answer: "بيع أجهزة التحكم في الجودة جائز، لفحص المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "جودة", "بيع", "فقه"] },
    { id: 816, question: "ما حكم بيع أجهزة القياس بالليزر؟", answer: "بيع أجهزة القياس بالليزر جائز، للقياس الدقيق، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 817, question: "ما حكم بيع أجهزة المسح بالليزر؟", answer: "بيع أجهزة المسح بالليزر (لقياس المسافات) جائز، للاستخدام في الهندسة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "مسح", "بيع", "فقه"] },
    { id: 818, question: "ما حكم بيع أجهزة التصوير الحراري؟", answer: "بيع أجهزة التصوير الحراري جائز، للكشف عن الحرارة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 819, question: "ما حكم بيع أجهزة التصوير بالأشعة تحت الحمراء؟", answer: "بيع أجهزة التصوير بالأشعة تحت الحمراء جائز، للرؤية الليلية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 820, question: "ما حكم بيع أجهزة الرؤية الليلية؟", answer: "بيع أجهزة الرؤية الليلية جائز، للاستخدام في الأمن والدفاع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "رؤية", "بيع", "فقه"] },
    { id: 821, question: "ما حكم بيع أجهزة تحديد المواقع الجغرافية (GPS)؟", answer: "بيع أجهزة تحديد المواقع الجغرافية (GPS) جائز، للملاحة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحديد", "بيع", "فقه"] },
    { id: 822, question: "ما حكم بيع أجهزة التتبع عبر الأقمار الصناعية؟", answer: "بيع أجهزة التتبع عبر الأقمار الصناعية جائز، للتتبع المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تتبع", "بيع", "فقه"] },
    { id: 823, question: "ما حكم بيع هوائيات الاستقبال الفضائي؟", answer: "بيع هوائيات الاستقبال الفضائي (الدش) جائز، إذا استقبلت القنوات المباحة، أما إذا استقبلت المحرم فحرام.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["هوائيات", "فضائي", "بيع", "فقه"] },
    { id: 824, question: "ما حكم بيع أجهزة استقبال البث الفضائي؟", answer: "بيع أجهزة استقبال البث الفضائي (ريسيفر) جائز، مع التحذير من استقبال المحرمات، وإلا فيحرم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "استقبال", "بيع", "فقه"] },
    { id: 825, question: "ما حكم بيع مشغلات الأقراص المدمجة؟", answer: "بيع مشغلات الأقراص المدمجة (CD, DVD) جائز، للاستماع إلى المباح، ولا يؤثم البائع باستعمالها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مشغلات", "أقراص", "بيع", "فقه"] },
    { id: 826, question: "ما حكم بيع مشغلات الأقراص الرقمية (MP3, MP4)؟", answer: "بيع مشغلات الأقراص الرقمية (MP3, MP4) جائز، للاستماع إلى المباح (قرآن، محاضرات)، ولا يؤثم البائع باستعمالها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مشغلات", "رقمية", "بيع", "فقه"] },
    { id: 827, question: "ما حكم بيع أجهزة التسجيل الصوتي؟", answer: "بيع أجهزة التسجيل الصوتي جائز، لتسجيل العلم والمحاضرات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تسجيل", "بيع", "فقه"] },
    { id: 828, question: "ما حكم بيع أجهزة التسجيل المرئي؟", answer: "بيع أجهزة التسجيل المرئي (كاميرات فيديو) جائز، للتصوير المباح، محرم للتصوير المحرم.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["أجهزة", "تسجيل", "بيع", "فقه"] },
    { id: 829, question: "ما حكم بيع أجهزة البث المباشر؟", answer: "بيع أجهزة البث المباشر جائز، للبث المباح، محرم للبث المحرم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "بث", "بيع", "فقه"] },
    { id: 830, question: "ما حكم بيع أجهزة البث الإذاعي؟", answer: "بيع أجهزة البث الإذاعي جائز، للبث المباح (قرآن، وعظ)، ولا يؤثم البائع باستعمالها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "بث", "بيع", "فقه"] },
    { id: 831, question: "ما حكم بيع أجهزة التلفاز؟", answer: "بيع أجهزة التلفاز جائز، إذا استقبلت القنوات المباحة، ولا يؤثم البائع باستعمالها في الحرام, والأولى ترك بيعها لمن يعلم أنه يستعملها في المحرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تلفاز", "أجهزة", "بيع", "فقه"] },
    { id: 832, question: "ما حكم بيع أجهزة الراديو؟", answer: "بيع أجهزة الراديو جائز، للاستماع إلى المباح (قرآن، أخبار)، ولا يؤثم البائع باستعمالها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["راديو", "أجهزة", "بيع", "فقه"] },
    { id: 833, question: "ما حكم بيع أجهزة الاتصال اللاسلكي؟", answer: "بيع أجهزة الاتصال اللاسلكي (ووكي توكي) جائز، للاستخدام المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "اتصال", "بيع", "فقه"] },
    { id: 834, question: "ما حكم بيع أجهزة النداء الآلي (بيجر)؟", answer: "بيع أجهزة النداء الآلي (البيجر) جائز، للاستخدام المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "نداء", "بيع", "فقه"] },
    { id: 835, question: "ما حكم بيع أجهزة الاستدعاء اللاسلكي؟", answer: "بيع أجهزة الاستدعاء اللاسلكي جائز، للاستخدام في المطاعم والمستشفيات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استدعاء", "بيع", "فقه"] },
    { id: 836, question: "ما حكم بيع أجهزة الاتصال عبر الإنترنت (VOIP)؟", answer: "بيع أجهزة الاتصال عبر الإنترنت (VOIP) جائز، للاتصال المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "اتصال", "بيع", "فقه"] },
    { id: 837, question: "ما حكم بيع أجهزة التشفير؟", answer: "بيع أجهزة التشفير جائز، للاستخدام المشروع (حماية البيانات)، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تشفير", "بيع", "فقه"] },
    { id: 838, question: "ما حكم بيع أجهزة الاختراق؟", answer: "بيع أجهزة الاختراق (لشبكات الحاسوب) محرم، لأنها تستعمل في الحرام والاعتداء على الآخرين.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "اختراق", "بيع", "فقه"] },
    { id: 839, question: "ما حكم بيع أجهزة الحماية من الاختراق؟", answer: "بيع أجهزة الحماية من الاختراق (فيروسات، هاكرز) جائز، لحماية الأنظمة، وهو من الإعانة على البر.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["أجهزة", "حماية", "بيع", "فقه"] },
    { id: 840, question: "ما حكم بيع أجهزة النسخ الاحتياطي؟", answer: "بيع أجهزة النسخ الاحتياطي (باك أب) جائز، لحماية البيانات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "نسخ", "بيع", "فقه"] },
    { id: 841, question: "ما حكم بيع خوادم الحاسوب (سيرفرات)؟", answer: "بيع خوادم الحاسوب (السيرفرات) جائز، للاستخدام المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["خوادم", "حاسوب", "بيع", "فقه"] },
    { id: 842, question: "ما حكم بيع أجهزة التخزين (هارد ديسك)؟", answer: "بيع أجهزة التخزين (الهارد ديسك) جائز، لتخزين البيانات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تخزين", "بيع", "فقه"] },
    { id: 843, question: "ما حكم بيع أجهزة التخزين السحابية؟", answer: "بيع أجهزة التخزين السحابية (خدمة وليس جهازاً) جائز، إذا كانت الخدمة مباحة وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تخزين", "بيع", "فقه"] },
    { id: 844, question: "ما حكم بيع أجهزة الطاقة الشمسية؟", answer: "بيع أجهزة الطاقة الشمسية (ألواح، بطاريات) جائز، لتوليد الكهرباء، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طاقة", "بيع", "فقه"] },
    { id: 845, question: "ما حكم بيع أجهزة طاقة الرياح؟", answer: "بيع أجهزة طاقة الرياح (توربينات) جائز، لتوليد الكهرباء، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طاقة", "بيع", "فقه"] },
    { id: 846, question: "ما حكم بيع أجهزة تحلية المياه بالطاقة الشمسية؟", answer: "بيع أجهزة تحلية المياه بالطاقة الشمسية جائز، للحصول على مياه صالحة للشرب، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحلية", "بيع", "فقه"] },
    { id: 847, question: "ما حكم بيع أجهزة معالجة مياه الصرف الصحي؟", answer: "بيع أجهزة معالجة مياه الصرف الصحي جائز، للحفاظ على البيئة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "معالجة", "بيع", "فقه"] },
    { id: 848, question: "ما حكم بيع أجهزة تنقية الهواء؟", answer: "بيع أجهزة تنقية الهواء جائز، لتنقية الهواء من الملوثات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تنقية", "بيع", "فقه"] },
    { id: 849, question: "ما حكم بيع أجهزة ترطيب الهواء؟", answer: "بيع أجهزة ترطيب الهواء جائز، لتحسين جودة الهواء، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ترطيب", "بيع", "فقه"] },
    { id: 850, question: "ما حكم بيع أجهزة قياس جودة الهواء؟", answer: "بيع أجهزة قياس جودة الهواء جائز، لمراقبة التلوث، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 851, question: "ما حكم بيع أجهزة قياس الإشعاع؟", answer: "بيع أجهزة قياس الإشعاع جائز، للكشف عن الإشعاعات الضارة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 852, question: "ما حكم بيع أجهزة الكشف عن المعادن؟", answer: "بيع أجهزة الكشف عن المعادن جائز، للبحث عن المعادن والآثار، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 853, question: "ما حكم بيع أجهزة الكشف عن المياه الجوفية؟", answer: "بيع أجهزة الكشف عن المياه الجوفية جائز، للبحث عن المياه، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 854, question: "ما حكم بيع أجهزة المسح الجيولوجي؟", answer: "بيع أجهزة المسح الجيولوجي جائز، للدراسات الجيولوجية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "مسح", "بيع", "فقه"] },
    { id: 855, question: "ما حكم بيع أجهزة قياس الزلازل؟", answer: "بيع أجهزة قياس الزلازل (سيزموجراف) جائز، لرصد الزلازل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 856, question: "ما حكم بيع أجهزة الأرصاد الجوية؟", answer: "بيع أجهزة الأرصاد الجوية جائز، لرصد الطقس، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "أرصاد", "بيع", "فقه"] },
    { id: 857, question: "ما حكم بيع أجهزة قياس سرعة الرياح؟", answer: "بيع أجهزة قياس سرعة الرياح (أنيمومتر) جائز، للدراسات المناخية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 858, question: "ما حكم بيع أجهزة قياس شدة الإضاءة؟", answer: "بيع أجهزة قياس شدة الإضاءة (لوكس ميتر) جائز، لقياس الإضاءة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 859, question: "ما حكم بيع أجهزة قياس الرطوبة؟", answer: "بيع أجهزة قياس الرطوبة (هيجروميتر) جائز، لقياس الرطوبة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 860, question: "ما حكم بيع أجهزة قياس الحرارة (ثيرمومتر)؟", answer: "بيع أجهزة قياس الحرارة (ثيرمومتر) جائز، لقياس درجات الحرارة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 861, question: "ما حكم بيع أجهزة قياس الضغط الجوي؟", answer: "بيع أجهزة قياس الضغط الجوي (بارومتر) جائز، لقياس الضغط الجوي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 862, question: "ما حكم بيع أجهزة قياس الصوت (ديسيبل ميتر)؟", answer: "بيع أجهزة قياس الصوت (ديسيبل ميتر) جائز، لقياس شدة الصوت، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 863, question: "ما حكم بيع أجهزة قياس التردد؟", answer: "بيع أجهزة قياس التردد (فريكونسي ميتر) جائز، لقياس التردد الكهربائي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 864, question: "ما حكم بيع أجهزة قياس المقاومة الكهربائية؟", answer: "بيع أجهزة قياس المقاومة الكهربائية (أوم ميتر) جائز، لقياس المقاومة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 865, question: "ما حكم بيع أجهزة قياس التيار الكهربائي؟", answer: "بيع أجهزة قياس التيار الكهربائي (أميتر) جائز، لقياس التيار، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 866, question: "ما حكم بيع أجهزة قياس الجهد الكهربائي؟", answer: "بيع أجهزة قياس الجهد الكهربائي (فولتميتر) جائز، لقياس الجهد، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 867, question: "ما حكم بيع أجهزة قياس الطاقة الكهربائية؟", answer: "بيع أجهزة قياس الطاقة الكهربائية (عدادات الكهرباء) جائز، لقياس الاستهلاك، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 868, question: "ما حكم بيع أجهزة اختبار المواد؟", answer: "بيع أجهزة اختبار المواد (شد، ضغط) جائز، لاختبار المواد، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "اختبار", "بيع", "فقه"] },
