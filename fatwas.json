    { id: 716, question: "ما حكم بيع السماعات الطبية المستعملة؟", answer: "بيع السماعات الطبية المستعملة جائز، مع تعقيمها، وبيان عيوبها، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سماعات", "طبية", "بيع", "فقه"] },
    { id: 717, question: "ما حكم بيع النظارات المستعملة؟", answer: "بيع النظارات المستعملة (الطبية والشمسية) جائز، مع بيان عيوبها، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["نظارات", "مستعملة", "بيع", "فقه"] },
    { id: 718, question: "ما حكم بيع العدسات اللاصقة المستعملة؟", answer: "بيع العدسات اللاصقة المستعملة محرم، لأنها مستعملة على عين الغير، وفيها ضرر صحي، ويجوز بيع الجديدة فقط.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["عدسات", "لاصقة", "بيع", "فقه"] },
    { id: 719, question: "ما حكم بيع فرشاة الأسنان المستعملة؟", answer: "بيع فرشاة الأسنان المستعملة محرم، لأنها مستعملة في فم الغير، وفيها ضرر صحي، ويجوز بيع الجديدة فقط.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["فرشاة", "أسنان", "بيع", "فقه"] },
    { id: 720, question: "ما حكم بيع الملابس الداخلية المستعملة؟", answer: "بيع الملابس الداخلية المستعملة محرم، لأنها من العورات، وفيها ضرر صحي، ويجوز بيع الجديدة فقط.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["ملابس", "داخلية", "بيع", "فقه"] },
    { id: 721, question: "ما حكم بيع الجوارب المستعملة؟", answer: "بيع الجوارب المستعملة مكروه، والأفضل عدمه، وفيها ضرر صحي، ويجوز بيع الجديدة.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["جوارب", "مستعملة", "بيع", "فقه"] },
    { id: 722, question: "ما حكم بيع المناشف المستعملة؟", answer: "بيع المناشف المستعملة جائز، مع غسلها وتطهيرها، وليس فيها محذور شرعي إن طهرت.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مناشف", "مستعملة", "بيع", "فقه"] },
