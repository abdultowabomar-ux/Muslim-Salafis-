{ id: 1, question: "ما هي شهادة أن لا إله إلا الله؟", answer: "معناها لا معبود بحق إلا الله، وهي تنفي الإلهية عن كل ما سوى الله وتثبتها لله وحده.", hadith: "عن ابن عمر رضي الله عنهما قال: قال رسول الله صلى الله عليه وسلم: 'بني الإسلام على خمس: شهادة أن لا إله إلا الله وأن محمداً رسول الله...' متفق عليه.", tags: ["شهادة", "توحيد", "عقيدة", "لا إله إلا الله"] },
    { id: 2, question: "ما حكم من استهزأ بالله أو رسوله؟", answer: "من استهزأ بالله أو رسوله أو القرآن فهو كافر مرتد عن الإسلام، ولو كان مستهزئاً غير جاد.", hadith: "وَلَئِن سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ ۚ قُلْ أَبِاللَّهِ وَآيَاتِهِ وَرَسُولِهِ كُنتُمْ تَسْتَهْزِئُونَ (65) لَا تَعْتَذِرُوا قَدْ كَفَرْتُم بَعْدَ إِيمَانِكُمْ (التوبة)", tags: ["استهزاء", "ردة", "كفر", "عقيدة"] },
    { id: 3, "حكم", "طهارة"] },
    { id: 4, question: "ما حكم ترك الصلاة؟", answer: "ترك الصلاة كفر أكبر مخرج من الملة على الراجح من أقوال العلماء، سواء تركها تهاوناً أو جحوداً.", hadith: "عن جابر بن عبد الله قال: قال رسول الله صلى الله عليه وسلم: 'بين الرجل وبين الشرك والكفر ترك الصلاة' رواه مسلم.", tags: ["صلاة", "ترك الصلاة", "كفر", "عقيدة"] },
    { id: 5, question: "ما هي الغيبة؟", answer: "الغيبة هي ذكرك أخاك بما يكره، سواء كان في بدنه أو دينه أو دنياه أو نفسه أو خلقه.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'أتدرون ما الغيبة؟' قالوا: الله ورسوله أعلم، قال: 'ذكرك أخاك بما يكره' قيل: أفرأيت إن كان في أخي ما أقول؟ قال: 'إن كان فيه ما تقول فقد اغتبته، وإن لم يكن فيه فقد بهته' رواه مسلم.", tags: ["غيبة", "أخلاق", "محرمات", "لسان"] },
    { id: 6, question: "ما حكم النجاسة إذا أصابت الثوب؟", answer: "يجب غسلها بالماء حتى تزول النجاسة وأثرها، وإن كانت نجاسة خفيفة كبول الصبي فتكفي النضح.", hadith: "عن أسماء بنت أبي بكر قالت: جاءت امرأة إلى النبي صلى الله عليه وسلم فقالت: أرأيت إحدانا إذا أصاب ثوبها الدم من الحيضة كيف تصنع؟ فقال: 'تحته ثم تقرصه بالماء ثم تنضحه وتصلي فيه' متفق عليه.", tags: ["نجاسة", "ثوب", "طهارة", "غسل"] },
    { id: 7, question: "ما هي أركان الصلاة؟", answer: "أركان الصلاة أربعة عشر ركناً: القيام، تكبيرة الإحرام، قراءة الفاتحة، الركوع، الرفع منه، السجود، الرفع منه، الجلسة بين السجدتين، الطمأنينة، التشهد الأخير، الجلوس له، الصلاة على النبي، التسليم، الترتيب.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'صلوا كما رأيتموني أصلي' رواه البخاري.", tags: ["صلاة", "أركان الصلاة", "فقه", "عبادات"] },
    { id: 8, question: "ما حكم صيام يوم الشك؟", answer: "يحرم صيام يوم الشك وهو اليوم الثلاثون من شعبان إذا لم تثبت الرؤية، وهو من صيام الدهر أو الاحتياط للرمضان.", hadith: "عن عمار بن ياسر قال: 'من صام اليوم الذي يشك فيه فقد عصى أبا القاسم صلى الله عليه وسلم' رواه أبو داود والترمذي.", tags: ["صيام", "شعبان", "شك", "رمضان"] },
    { id: 9, question: "ما هي شروط وجوب الزكاة؟", answer: "شروط وجوب الزكاة: الإسلام، الحرية، ملك النصاب، الحول، والزيادة على الحوائج الأصلية.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'بني الإسلام على خمس: شهادة أن لا إله إلا الله وأن محمداً رسول الله، وإقام الصلاة، وإيتاء الزكاة...' متفق عليه.", tags: ["زكاة", "شروط", "أموال", "عبادات"] },
    { id: 10, question: "ما حكم الربا؟", answer: "الربا محرم تحريماً شديداً، وهو من كبائر الذنوب، ومن يتعامل بالربا فقد حارب الله ورسوله.", hadith: "عن جابر قال: 'لعن رسول الله صلى الله عليه وسلم آكل الربا وموكله وكاتبه وشاهديه' وقال: 'هم سواء' رواه مسلم.", tags: ["ربا", "بيوع", "محرمات", "أموال"] },
    { id: 11, question: "ما حكم التصوير؟", answer: "تصوير ذوات الأرواح محرم للأدلة الشرعية، إلا للضرورة كالتعريف أو التذكرة أو التعليم بشروط.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["تصوير", "صور", "محرمات", "فقه"] },
    { id: 12, question: "ما حكم الغناء؟", answer: "الغناء المحرم هو المصحوب بالآلات والمعازف والموسيقى والكلمات الفاحشة أو الداعية للمعاصي.", hadith: "عن أبي مالك الأشعري قال: قال رسول الله صلى الله عليه وسلم: 'ليكونن من أمتي أقوام يستحلون الحر والحرير والخمر والمعازف' رواه البخاري.", tags: ["غناء", "موسيقى", "لهو", "محرمات"] },
    { id: 13, question: "ما حكم لعبة الشطرنج؟", answer: "الشطرنج محرمة إذا كانت تشغل عن الواجب أو كان فيها رهان أو تضر بالدين، والأولى تركها مطلقاً.", hadith: "عن علي بن أبي طالب قال: 'الشطرنج من الميسر' رواه أحمد وأبو داود.", tags: ["شطرنج", "لهو", "ألعاب", "محرمات"] },
    { id: 14, question: "ما حكم الدخان؟", answer: "الدخان حرام لما فيه من ضرر وإضاعة مال وإيذاء للغير وإدمان.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'كل مسكر خمر وكل مسكر حرام' رواه مسلم.", tags: ["دخان", "سجائر", "محرمات", "ضرر"] },
    { id: 15, question: "ما حكم الاحتفال بالمولد النبوي؟", answer: "الاحتفال بالمولد بدعة محدثة لم يفعلها النبي ولا أصحابه، والخير في اتباعهم.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'من أحدث في أمرنا هذا ما ليس منه فهو رد' متفق عليه.", tags: ["مولد", "بدعة", "احتفال", "عقيدة"] },
    { id: 16, question: "ما حكم التبرك بالأشجار والأحجار؟", answer: "التبرك بالأشجار والأحجار والقبور شرك أكبر إذا اعتقد أنها تنفع أو تضر من دون الله.", hadith: "قُلْ أَفَرَأَيْتُم مَّا تَدْعُونَ مِن دُونِ اللَّهِ إِنْ أَرَادَنِيَ اللَّهُ بِضُرٍّ هَلْ هُنَّ كَاشِفَاتُ ضُرِّهِ أَوْ أَرَادَنِي بِرَحْمَةٍ هَلْ هُنَّ مُمْسِكَاتُ رَحْمَتِهِ (الزمر:38)", tags: ["تبرك", "شرك", "عقيدة", "قبور"] },
    { id: 17, question: "ما حكم الذبح لغير الله؟", answer: "الذبح لغير الله شرك أكبر، سواء ذبح للجن أو للأولياء أو للأموات.", hadith: "لعن رسول الله صلى الله عليه وسلم من ذبح لغير الله. رواه مسلم.", tags: ["ذبح", "شرك", "عقيدة", "قبور"] },
    { id: 18, question: "ما هي علامات الساعة الصغرى؟", answer: "علامات الساعة الصغرى كثيرة، منها: بعثة النبي، فتح بيت المقدس، موتان، ظهور الفتن، كثرة الزنا، كثرة شرب الخمر.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا تقوم الساعة حتى تقتتل فئتان عظيمتان...' متفق عليه.", tags: ["ساعة", "علامات", "آخر الزمان", "عقيدة"] },
    { id: 19, question: "ما حكم قراءة السحر والكهانة؟", answer: "قراءة السحر والكهانة شرك وذنب عظيم، ومن أتى عرافاً أو كاهناً فصدقه فقد كفر بما أنزل على محمد.", hadith: "عن أبي هريرة عن النبي صلى الله عليه وسلم قال: 'من أتى عرافاً فصدقه بما يقول فقد كفر بما أنزل على محمد' رواه أبو داود.", tags: ["سحر", "كهانة", "شرك", "عقيدة"] },
    { id: 20, question: "ما حكم السباحة؟", answer: "السباحة جائزة ومستحبة لتعلم المهارات الحربية، بشرط ستر العورة وخلوها من المحاذير الشرعية.", hadith: "عن عقبة بن عامر قال: سمعت رسول الله صلى الله عليه وسلم يقول: 'كل شيء ليس من ذكر الله فهو لهو أو سهو إلا أربعاً... ومُعَلِّمُ السباحة' رواه الطبراني.", tags: ["سباحة", "رياضة", "جائز", "فقه"] },
    { id: 21, question: "ما حكم كشف المرأة وجهها؟", answer: "يجب على المرأة ستر وجهها عن الأجانب على الراجح من أقوال العلماء، لعموم الأدلة.", hadith: "عن عائشة قالت: 'كان الركبان يمرون بنا ونحن مع رسول الله صلى الله عليه وسلم محرمات، فإذا حاذوا بنا سدلت إحدانا جلبابها على وجهها' رواه أبو داود.", tags: ["حجاب", "وجه", "مرأة", "فقه"] },
    { id: 22, question: "ما حكم لبس الذهب للرجل؟", answer: "لبس الذهب حرام على الرجال، وهو مخصوص بالنساء.", hadith: "عن علي بن أبي طالب قال: أخذ رسول الله صلى الله عليه وسلم حريراً فجعله في يمينه وذهباً فجعله في شماله ثم قال: 'إن هذين حرام على ذكور أمتي' رواه أبو داود.", tags: ["ذهب", "رجال", "حرام", "لباس"] },
    { id: 23, question: "ما حكم لبس الحرير للرجل؟", answer: "لبس الحرير حرام على الرجال بإجماع العلماء، إلا للضرورة كالحكة.", hadith: "عن عمر بن الخطاب قال: قال رسول الله صلى الله عليه وسلم: 'لا تلبسوا الحرير فإن من لبسه في الدنيا لم يلبسه في الآخرة' متفق عليه.", tags: ["حرير", "رجال", "حرام", "لباس"] },
    { id: 24, question: "ما حكم السباحة في المسابح المختلطة؟", answer: "لا تجوز السباحة في المسابح المختلطة لما فيها من نظر واختلاط محرم وفتنة.", hadith: "عن جرير بن عبد الله قال: سألت رسول الله صلى الله عليه وسلم عن نظر الفجأة فأمرني أن أصرف بصري. رواه مسلم.", tags: ["سباحة", "اختلاط", "حرام", "فتنة"] },
    { id: 25, question: "ما حكم لبس البنطلون؟", answer: "لبس البنطلون جائز للرجل إذا كان ساتراً للعورة وغير ضيق وليس تشبهاً بالنساء.", hadith: "لعن رسول الله صلى الله عليه وسلم المتشبهين من الرجال بالنساء والمتشبهات من النساء بالرجال. رواه البخاري.", tags: ["بنطلون", "لباس", "رجال", "فقه"] },
    { id: 26, question: "ما حكم النقاب؟", answer: "النقاب واجب على الراجح، وهو ستر الوجه كله بما فيه العينان بشفاف، أو إسدال غطاء من أعلى الرأس.", hadith: "عن عائشة قالت: 'كانت المرأة إذا أحرمت مع رسول الله صلى الله عليه وسلم سترت وجهها' رواه أحمد.", tags: ["نقاب", "حجاب", "مرأة", "فقه"] },
    { id: 27, question: "ما حكم الصلاة في الطائرة؟", answer: "تصح الصلاة في الطائرة مع استقبال القبلة ما أمكن، والركوع والسجود بالإيماء إن تعذر السجود على الأرض.", hadith: "وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ ۚ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ (البقرة:115)", tags: ["صلاة", "طائرة", "سفر", "فقه"] },
    { id: 28, question: "ما حكم صيام الست من شوال؟", answer: "صيام ستة أيام من شوال سنة مستحبة، ويبدأ من ثاني أيام العيد.", hadith: "عن أبي أيوب قال: قال رسول الله صلى الله عليه وسلم: 'من صام رمضان ثم أتبعه ستاً من شوال كان كصيام الدهر' رواه مسلم.", tags: ["صيام", "شوال", "ست", "نافلة"] },
    { id: 29, question: "ما حكم صيام يوم عرفة؟", answer: "صيام يوم عرفة سنة لغير الحاج، ويكفر سنتين ماضية ومستقبلة.", hadith: "عن أبي قتادة قال: قال رسول الله صلى الله عليه وسلم: 'صيام يوم عرفة أحتسب على الله أن يكفر السنة التي قبله والسنة التي بعده' رواه مسلم.", tags: ["عرفة", "صيام", "نافلة", "حج"] },
    { id: 30, question: "ما حكم صيام عاشوراء؟", answer: "صيام عاشوراء سنة، والأفضل صيام التاسع معه مخالفة لليهود.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'لئن بقيت إلى قابل لأصومن التاسع' رواه مسلم.", tags: ["عاشوراء", "صيام", "محرّم", "نافلة"] },
    { id: 31, question: "ما هي زكاة الفطر؟", answer: "زكاة الفطر صاع من طعام يخرجه المسلم عن نفسه وعمن يعول قبل صلاة العيد.", hadith: "عن ابن عمر قال: 'فرض رسول الله صلى الله عليه وسلم زكاة الفطر صاعاً من تمر أو صاعاً من شعير' متفق عليه.", tags: ["زكاة", "فطر", "رمضان", "زكاة الفطر"] },
    { id: 32, question: "ما هي مصارف الزكاة؟", answer: "مصارف الزكاة ثمانية: الفقراء، المساكين، العاملون عليها، المؤلفة قلوبهم، الرقاب، الغارمون، في سبيل الله، ابن السبيل.", hadith: "إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ وَالْعَامِلِينَ عَلَيْهَا وَالْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِي الرِّقَابِ وَالْغَارِمِينَ وَفِي سَبِيلِ اللَّهِ وَابْنِ السَّبِيلِ (التوبة:60)", tags: ["زكاة", "مصارف", "أموال", "فقه"] },
    { id: 33, question: "ما حكم بيع الخمر؟", answer: "بيع الخمر محرم، وثمنه سحت، ومن أعد العنب لمسلم ليصير خمراً فقد ساعد على الإثم.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["خمر", "بيع", "حرام", "بيوع"] },
    { id: 34, question: "ما حكم بيع الكلاب؟", answer: "بيع الكلاب محرم إلا كلب الصيد والحرث والماشية، وثمنه حرام.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'ثمن الكلب حرام' متفق عليه.", tags: ["كلاب", "بيع", "حرام", "بيوع"] },
    { id: 35, question: "ما حكم بيع العينة؟", answer: "بيع العينة محرم وهو أن يبيع سلعة بثمن مؤجل ثم يشتريها بثمن أقل نقداً.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'إذا تبايعتم بالعينة... فانتظروا الساعة' رواه أبو داود.", tags: ["عينة", "ربا", "بيوع", "حرام"] },
    { id: 36, question: "ما حكم القرض بفائدة؟", answer: "القرض بفائدة ربا محرم، سواء كان من بنك ربوي أو فرد.", hadith: "الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ (البقرة:275)", tags: ["ربا", "قرض", "فائدة", "بيوع"] },
    { id: 37, question: "ما حكم التأمين التجاري؟", answer: "التأمين التجاري محرم لأنه يدخل في الغرر والميسر والربا.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم.", tags: ["تأمين", "غرر", "حرام", "بيوع"] },
    { id: 38, question: "ما حكم الأسهم في البورصة؟", answer: "الأسهم جائزة إن كانت للشركات المباحة، ولا يجوز الاستثمار في شركات الربا أو الخمر أو الحرام.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أسهم", "بورصة", "استثمار", "بيوع"] },
    { id: 39, question: "ما حكم العملات الرقمية؟", answer: "العملات الرقمية (البيتكوين) محرمة إذا كانت فيها غرر كبير أو استخدمت في محرمات، أو كانت بلا غطاء شرعي.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب، والفضة بالفضة، والبر بالبر، والشعير بالشعير، والتمر بالتمر، والملح بالملح، مثلاً بمثل، سواءً بسواء، يداً بيد، فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["بيتكوين", "عملات", "رقمية", "بيوع"] },
    { id: 40, question: "ما حكم التجارة في العملات؟", answer: "تجارة العملات (الفوركس) محرمة إذا كان فيها ربا أو غرر أو تأجيل أو تداول هامشي.", hadith: "لا تبيعوا الذهب بالذهب إلا مثلاً بمثل، ولا تشفوا بعضها على بعض. متفق عليه.", tags: ["فوركس", "عملات", "ربا", "بيوع"] },
    { id: 41, question: "ما حكم الكفالة في البنوك الربوية؟", answer: "الكفالة في البنوك الربوية محرمة لأنها معاونة على الربا والإثم.", hadith: "لعن رسول الله صلى الله عليه وسلم آكل الربا وموكله وكاتبه وشاهديه. رواه مسلم.", tags: ["كفالة", "بنوك", "ربا", "حرام"] },
    { id: 42, question: "ما حكم الرهن؟", answer: "الرهن جائز في الشرع لضمان الدين، وهو من أسباب التوثيق المباحة.", hadith: "وَإِن كُنتُمْ عَلَىٰ سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَّقْبُوضَةٌ (البقرة:283)", tags: ["رهن", "توثيق", "بيوع", "جائز"] },
    { id: 43, question: "ما حكم الحجر على المفلس؟", answer: "الحجر على المفلس جائز لحماية حقوق الدائنين، ويحجر عليه بالحكم القضائي.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'أيما رجل مات وعليه دين فليس منا' رواه أحمد.", tags: ["حجر", "مفلس", "ديون", "فقه"] },
    { id: 44, question: "ما حكم الغصب؟", answer: "الغصب حرام، وهو أخذ مال الغير بغير حق، وفيه ضمان المال المغصوب.", hadith: "عن عبد الله بن عمرو أن النبي صلى الله عليه وسلم قال: 'من أخذ شبراً من الأرض ظلماً طوقه الله من سبع أرضين يوم القيامة' متفق عليه.", tags: ["غصب", "ظلم", "حرام", "أموال"] },
    { id: 45, question: "ما حكم السرقة؟", answer: "السرقة حرام، وهي من كبائر الذنوب، وفيها قطع اليد إذا بلغ النصاب.", hadith: "وَالسَّارِقُ وَالسَّارِقَةُ فَاقْطَعُوا أَيْدِيَهُمَا جَزَاءً بِمَا كَسَبَا نَكَالًا مِّنَ اللَّهِ (المائدة:38)", tags: ["سرقة", "حد", "حرام", "عقوبة"] },
    { id: 46, question: "ما حكم اليمين الغموس؟", answer: "اليمين الغموس هي التي يقصد بها الحنث وكذب، وهي من كبائر الذنوب.", hadith: "عن عبد الله بن عمرو قال: قال رسول الله صلى الله عليه وسلم: 'الكبائر: الإشراك بالله، وعقوق الوالدين... واليمين الغموس' رواه البخاري.", tags: ["يمين", "غموس", "كبيرة", "ذنوب"] },
    { id: 47, question: "ما حكم النذر؟", answer: "النذر جائز، ويكره، والأفضل تركه، ويلزم الوفاء به إذا نذر طاعة.", hadith: "عن ابن عمر قال: 'نهى النبي صلى الله عليه وسلم عن النذر وقال: إنه لا يأتي بخير، وإنما يستخرج به من البخيل' متفق عليه.", tags: ["نذر", "يمين", "عبادات", "فقه"] },
    { id: 48, question: "ما حكم الأضحية؟", answer: "الأضحية سنة مؤكدة عن القادر عليها، وتذبح أيام التشريق.", hadith: "عن أنس قال: 'ضحى النبي صلى الله عليه وسلم بكبشين أملحين أقرنين' متفق عليه.", tags: ["أضحية", "أضاحي", "عيد", "عبادات"] },
    { id: 49, question: "ما حكم العقيقة؟", answer: "العقيقة سنة عن المولود، تذبح شاتان عن الغلام وشاة عن الجارية يوم السابع.", hadith: "عن سمرة قال: قال رسول الله صلى الله عليه وسلم: 'كل غلام رهينة بعقيقته، تذبح عنه يوم سابعه، ويحلق، ويسمى' رواه أبو داود.", tags: ["عقيقة", "مولود", "وليمة", "عبادات"] },
    { id: 50, question: "ما حكم الوليمة؟", answer: "الوليمة مستحبة عند النكاح، والإجابة إليها واجبة إن دعي المسلم.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'إذا دعي أحدكم إلى وليمة فليأتها' متفق عليه.", tags: ["وليمة", "عرس", "دعوة", "عبادات"] },
    { id: 51, question: "ما حكم التشبه بالكفار؟", answer: "تشبه المسلمين بالكفار في عباداتهم وأعيادهم وخصائصهم محرم وقد يصل إلى الكفر.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من تشبه بقوم فهو منهم' رواه أبو داود.", tags: ["تشبه", "كفار", "بدعة", "عقيدة"] },
    { id: 52, question: "ما حكم الاحتفال برأس السنة الميلادية؟", answer: "الاحتفال برأس السنة الميلادية حرام لأنه تشبه بالنصارى وبدعة في الدين.", hadith: "عن أنس قال: قدم النبي صلى الله عليه وسلم المدينة ولهم يومان يلعبون فيهما فقال: 'إن الله أبدلكم بهما خيراً منهما: يوم الفطر ويوم الأضحى' رواه أبو داود.", tags: ["رأس السنة", "أعياد", "بدعة", "تشبه"] },
    { id: 53, question: "ما حكم تهنئة النصارى بأعيادهم؟", answer: "تهنئة النصارى بأعيادهم محرمة لأنها إقرار لهم على باطلهم وتشبه بهم.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من تشبه بقوم فهو منهم' رواه أبو داود.", tags: ["تهنئة", "نصارى", "أعياد", "حرام"] },
    { id: 54, question: "ما حكم وضع الصور في البيت؟", answer: "وضع الصور لذوات الأرواح محرم، والملائكة لا تدخل بيتاً فيه صورة أو كلب.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'لا تدخل الملائكة بيتاً فيه كلب ولا صورة' متفق عليه.", tags: ["صور", "بيت", "حرام", "ملائكة"] },
    { id: 55, question: "ما حكم السباحة للنساء؟", answer: "تباح السباحة للنساء بشروط: في مكان مخصص للنساء فقط، مع ستر العورة، وعدم الاختلاط.", hadith: "عن النبي صلى الله عليه وسلم أنه قال: 'المرأة عورة' رواه الترمذي.", tags: ["سباحة", "نساء", "ستر", "فقه"] },
    { id: 56, question: "ما حكم كشف العورة في الحمامات العامة؟", answer: "يحرم كشف العورة في الحمامات العامة، ويجب سترها حتى عن النظر.", hadith: "عن معاوية بن حيدة قال: قلت: يا رسول الله، عوراتنا ما نأتي منها وما نذر؟ قال: 'احفظ عورتك إلا من زوجتك أو ما ملكت يمينك' رواه أبو داود.", tags: ["عورة", "حمامات", "ستر", "حرام"] },
    { id: 57, question: "ما حكم البناء على القبور؟", answer: "البناء على القبور محرم، ونهى النبي عن تجصيص القبور والبناء عليها.", hadith: "عن جابر قال: 'نهى رسول الله صلى الله عليه وسلم أن يجصص القبر، وأن يقعد عليه، وأن يبنى عليه' رواه مسلم.", tags: ["قبور", "بناء", "حرام", "جنائز"] },
    { id: 58, question: "ما حكم شد الرحال لغير المساجد الثلاثة؟", answer: "لا يجوز شد الرحل بقصد العبادة لغير المساجد الثلاثة: المسجد الحرام، والمسجد النبوي، والمسجد الأقصى.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا تشد الرحال إلا إلى ثلاثة مساجد' متفق عليه.", tags: ["مساجد", "زيارة", "أقصى", "عبادات"] },
    { id: 59, question: "ما حكم زيارة القبور للنساء؟", answer: "زيارة القبور للنساء جائزة بشروط، والأفضل تركها للخوف من الفتنة، والرجال مأمورون بها.", hadith: "عن أنس بن مالك قال: قال رسول الله صلى الله عليه وسلم: 'كنت نهيتكم عن زيارة القبور، ألا فزوروها' رواه مسلم.", tags: ["قبور", "زيارة", "نساء", "فقه"] },
    { id: 60, question: "ما حكم البكاء على الميت؟", answer: "البكاء على الميت جائز بدون ندب أو نياحة، وهو رحمة، والنياحة محرمة.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'الميت يعذب ببكاء أهله عليه' وكان ابن عمر يحدث به، ثم قال: عمر: إنما قال النبي صلى الله عليه وسلم: 'إن الميت ليعذب ببعض بكاء أهله عليه' متفق عليه.", tags: ["جنائز", "بكاء", "نياحة", "فقه"] },
    { id: 61, question: "ما حكم الصلاة على الغائب؟", answer: "صلاة الجنازة على الغائب جائزة إذا لم يصل عليه في بلده، كالنجاشي.", hadith: "عن أبي هريرة: 'أن النبي صلى الله عليه وسلم نعى النجاشي في اليوم الذي مات فيه، وخرج بهم إلى المصلى وكبر أربعاً' متفق عليه.", tags: ["جنائز", "غائب", "صلاة", "فقه"] },
    { id: 62, question: "ما حكم تغسيل المرأة زوجها؟", answer: "يجوز للمرأة أن تغسل زوجها بعد موته، والزوج يغسل زوجته، وهما من أشد الناس اتصالاً.", hadith: "عن عائشة قالت: 'لو استقبلت من أمري ما استدبرت ما غسل رسول الله صلى الله عليه وسلم إلا نساؤه' رواه أبو داود.", tags: ["جنائز", "تغسيل", "زوج", "فقه"] },
    { id: 63, question: "ما حكم الذبائح الإلكترونية؟", answer: "الذبائح الإلكترونية وهي التي تذبح بالصعق الكهربائي حلال إذا ذبحت ذبحاً شرعياً، أما موتها بالكهرباء بدون ذبح فهي ميتة.", hadith: "وَطَعَامُ الَّذِينَ أُوتُوا الْكِتَابَ حِلٌّ لَّكُمْ (المائدة:5)", tags: ["ذبائح", "كهرباء", "أطعمة", "فقه"] },
    { id: 64, question: "ما حكم أكل لحم الخيل؟", answer: "لحم الخيل حلال عند جمهور العلماء، ومكروه عند البعض، والأصل الإباحة.", hadith: "عن أسماء قالت: 'نحرنا فرساً على عهد رسول الله صلى الله عليه وسلم فأكلناه' متفق عليه.", tags: ["خيل", "لحوم", "حلال", "أطعمة"] },
    { id: 65, question: "ما حكم أكل لحم الأرنب؟", answer: "لحم الأرنب حلال بالإجماع، وقد أثبت الصحابة أكله.", hadith: "عن أنس قال: 'أجرنا أرنباً فعدوا عليها فذبحها رجل منا، ثم أتى بها النبي صلى الله عليه وسلم فأمر بأكلها' رواه البخاري.", tags: ["أرنب", "لحوم", "حلال", "أطعمة"] },
    { id: 66, question: "ما حكم أكل لحم الضبع؟", answer: "لحم الضبع حلال عند الحنفية والحنابلة، مكروه عند المالكية، حرام عند الشافعية، والراجح الحل.", hadith: "عن جابر قال: سئل رسول الله صلى الله عليه وسلم عن الضبع فقال: 'هو صيد، وفيه كبش إذا أصابه المحرم' رواه الترمذي.", tags: ["ضبع", "لحوم", "حلال", "أطعمة"] },
    { id: 67, question: "ما حكم أكل لحم الحمار الأهلي؟", answer: "لحم الحمار الأهلي حرام، حرمه النبي صلى الله عليه وسلم يوم خيبر.", hadith: "عن جابر قال: 'أكلنا لحوم الخيل، وحرم علينا لحوم الحمر الأهلية' رواه البخاري.", tags: ["حمار", "لحوم", "حرام", "أطعمة"] },
    { id: 68, question: "ما حكم أكل الحشرات؟", answer: "أكل الحشرات محرم إلا الجراد، فقد أباحه النبي صلى الله عليه وسلم.", hadith: "عن ابن أبي أوفى قال: 'غزونا مع رسول الله صلى الله عليه وسلم سبع غزوات، كنا نأكل الجراد' متفق عليه.", tags: ["حشرات", "جراد", "حلال", "أطعمة"] },
    { id: 69, question: "ما حكم الأكل والشرب في آنية الذهب والفضة؟", answer: "الأكل والشرب في آنية الذهب والفضة محرم على الرجال والنساء.", hadith: "عن حذيفة قال: قال النبي صلى الله عليه وسلم: 'لا تشربوا في آنية الذهب والفضة، ولا تأكلوا في صحافهما' رواه البخاري.", tags: ["آنية", "ذهب", "فضة", "طعام"] },
    { id: 70, question: "ما حكم تنظيف الأسنان بالمعجون المحتوي على الكحول؟", answer: "جائز إذا كان الكحول مستهلكاً غير مسكر، أو كان للتعقيم وليس للإسكار.", hadith: "ما أسكر كثيره فقليله حرام. رواه أبو داود.", tags: ["كحول", "معجون", "طهارة", "فقه"] },
    { id: 71, question: "ما حكم التيمم؟", answer: "التيمم بديل عن الوضوء والغسل عند عدم وجود الماء أو العجز عن استعماله، ويضرب بيديه على التراب.", hadith: "فَلَمْ تَجِدُوا مَاءً فَتَيَمَّمُوا صَعِيدًا طَيِّبًا فَامْسَحُوا بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُ (المائدة:6)", tags: ["تيمم", "طهارة", "ماء", "فقه"] },
    { id: 72, question: "ما هي نواقض الوضوء؟", answer: "نواقض الوضوء: الخارج من السبيلين، الريح، النوم، زوال العقل، أكل لحم الإبل، مس الفرج.", hadith: "عن زيد بن خالد الجهني قال: سمعت رسول الله صلى الله عليه وسلم يقول: 'لولا أن أشق على أمتي لأمرتهم بالسواك عند كل صلاة، وأخرت صلاة العشاء إلى ثلث الليل' متفق عليه.", tags: ["وضوء", "نواقض", "طهارة", "فقه"] },
    { id: 73, question: "ما حكم مس المصحف لغير المتوضئ؟", answer: "لا يجوز مس المصحف إلا بطهارة من الحدثين، لقوله تعالى: لا يمسه إلا المطهرون.", hadith: "لا يمس القرآن إلا طاهر. رواه مالك.", tags: ["مصحف", "وضوء", "طهارة", "قرآن"] },
    { id: 74, question: "ما حكم قراءة القرآن للجنب والحائض؟", answer: "لا يجوز للجنب والحائض قراءة القرآن، ويجوز لهما الذكر والدعاء.", hadith: "عن علي قال: كان النبي صلى الله عليه وسلم يقرئنا القرآن ما لم يكن جنباً. رواه أبو داود.", tags: ["جنب", "حيض", "قرآن", "طهارة"] },
    { id: 75, question: "ما حكم المضمضة والاستنشاق في الوضوء؟", answer: "المضمضة والاستنشاق سنتان في الوضوء، واجبان في الغسل من الجنابة.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'عشر من الفطرة: قص الشارب، وإعفاء اللحية، والسواك، والاستنشاق...' رواه مسلم.", tags: ["مضمضة", "استنشاق", "وضوء", "فقه"] },
    { id: 76, question: "ما حكم الماء المستعمل في الطهارة؟", answer: "الماء المستعمل في إزالة الخبث طاهر غير مطهر، وفي الرفع حدث طهور.", hadith: "عن ابن عباس قال: 'اغتسل بعض أزواج النبي صلى الله عليه وسلم، فجاء النبي يتوضأ منه، فقالت: إني كنت جنباً، فقال: إن الماء لا يجنب' رواه الترمذي.", tags: ["ماء", "طهارة", "مستعمل", "فقه"] },
    { id: 77, question: "ما حكم الماء المتغير بنجاسة؟", answer: "إذا تغير الماء بطعم أو لون أو رائحة نجاسة فهو نجس، وإن لم يتغير فهو طهور.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'إذا بلغ الماء قلتين لم يحمل الخبث' رواه أحمد.", tags: ["ماء", "نجاسة", "طهارة", "فقه"] },
    { id: 78, question: "ما حكم الاستنجاء بالحجارة؟", answer: "الاستنجاء بالحجارة جائز مع شرط أن تكون ثلاثاً طاهرات منقيات، والأفضل الجمع بين الحجر والماء.", hadith: "عن عائشة قالت: 'قولوا لأزواجكن: إن النبي صلى الله عليه وسلم كان لا يستنجي إلا بثلاثة أحجار' رواه الطبراني.", tags: ["استنجاء", "حجارة", "طهارة", "فقه"] },
    { id: 79, question: "ما حكم استعمال فضلات الحيوانات في الطهارة؟", answer: "لا يجوز الاستجمار بروث الحيوانات ولا عظامها، لأنها نجسة وغير مطهرة.", hadith: "عن ابن مسعود قال: أتى النبي صلى الله عليه وسلم الغائط فأمرني بثلاثة أحجار فوجدت حجرين والتمست الثالث فلم أجده، فأخذت روثة فأتى بها النبي صلى الله عليه وسلم، فقال: 'هذا ركس' رواه البخاري.", tags: ["استجمار", "روث", "طهارة", "فقه"] },
    { id: 80, question: "ما هي مبطلات الصيام؟", answer: "مبطلات الصيام: الأكل، الشرب، الجماع، إنزال المني، القيء عمداً، خروج دم الحيض والنفاس.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من نسي وهو صائم فأكل أو شرب فليتم صومه، فإنما أطعمه الله وسقاه' متفق عليه.", tags: ["صيام", "مبطلات", "رمضان", "فقه"] },
    { id: 81, question: "ما حكم صيام يوم السبت منفرداً؟", answer: "يكره إفراد يوم السبت بالصيام، إلا أن يوافق عادة كصيام داود، أو وافق يوماً مشروعاً كعرفة.", hadith: "عن عبد الله بن بسر قال: قال رسول الله صلى الله عليه وسلم: 'لا تصوموا يوم السبت إلا فيما افترض عليكم' رواه أحمد.", tags: ["صيام", "سبت", "كره", "فقه"] },
    { id: 82, question: "ما حكم القضاء والكفارة في الصيام؟", answer: "القضاء واجب على من أفطر بعذر، والكفارة على من أفطر بالجماع في نهار رمضان: عتق رقبة، فإن لم يجد فصيام شهرين متتابعين، فإن لم يستطع فإطعام ستين مسكيناً.", hadith: "عن أبي هريرة قال: 'جاء رجل إلى النبي صلى الله عليه وسلم فقال: هلكت يا رسول الله، قال: وما أهلكك؟ قال: وقعت على امرأتي في رمضان...' الحديث، متفق عليه.", tags: ["صيام", "قضاء", "كفارة", "رمضان"] },
    { id: 83, question: "ما حكم صيام من أصبح جنباً؟", answer: "صيامه صحيح إذا كان الجنابة من احتلام أو جماع قبل الفجر، ويغتسل بعد الفجر.", hadith: "عن عائشة وأم سلمة: 'أن النبي صلى الله عليه وسلم كان يصبح جنباً من جماع غير احتلام ثم يصوم' متفق عليه.", tags: ["صيام", "جنابة", "فقه", "رمضان"] },
    { id: 84, question: "ما حكم السواك للصائم؟", answer: "السواك للصائم سنة، ولا يفطر، والأفضل تأخيره إلى بعد الزوال، لكنه جائز قبله وبعده.", hadith: "عن عامر بن ربيعة قال: 'رأيت النبي صلى الله عليه وسلم ما لا أحصي يتسوك وهو صائم' رواه البخاري.", tags: ["صيام", "سواك", "فقه", "رمضان"] },
    { id: 85, question: "ما حكم صيام الدهر؟", answer: "صيام الدهر مكروه، ومن صام الأبد فقد ترك الفطر، وخالف السنة.", hadith: "عن عبد الله بن عمرو قال: قال لي رسول الله صلى الله عليه وسلم: 'ألم أخبر أنك تصوم النهار وتقوم الليل؟ قلت: بلى، قال: فلا تفعل، صم وأفطر، قم ونم، فإن لجسدك عليك حقاً...' متفق عليه.", tags: ["صيام", "دهر", "كره", "فقه"] },
    { id: 86, question: "ما حكم قضاء الصيام عن الميت؟", answer: "يجوز الولي قضاء الصيام عن الميت إذا كان عليه صيام واجب كالنذر أو رمضان.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'من مات وعليه صيام صام عنه وليه' متفق عليه.", tags: ["صيام", "ميت", "قضاء", "فقه"] },
    { id: 87, question: "ما حكم كفارة الظهار؟", answer: "كفارة الظهار: عتق رقبة، فإن لم يجد فصيام شهرين متتابعين، فإن لم يستطع فإطعام ستين مسكيناً.", hadith: "وَالَّذِينَ يُظَاهِرُونَ مِن نِّسَائِهِمْ ثُمَّ يَعُودُونَ لِمَا قَالُوا فَتَحْرِيرُ رَقَبَةٍ مِّن قَبْلِ أَن يَتَمَاسَّا (المجادلة:3)", tags: ["ظهار", "كفارة", "صيام", "فقه"] },
    { id: 88, question: "ما حكم إفطار الحامل والمرضع؟", answer: "للحامل والمرضع الفطر في رمضان إذا خافتا على نفسيهما أو ولديهما، وعليهما القضاء فقط، والطعام إن خافتا على الولدين.", hadith: "عن أنس بن مالك الكعبي أن رسول الله صلى الله عليه وسلم قال: 'إن الله وضع عن المسافر الصوم وشطر الصلاة، وعن الحامل والمرضع' رواه الترمذي.", tags: ["حامل", "مرضع", "صيام", "فقه"] },
    { id: 89, question: "ما حكم من جامع في نهار رمضان ناسياً؟", answer: "لا شيء عليه، وصومه صحيح، ولا قضاء ولا كفارة عليه لأنه ناسٍ.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من نسي وهو صائم فأكل أو شرب فليتم صومه، فإنما أطعمه الله وسقاه' متفق عليه.", tags: ["جماع", "صيام", "نسيان", "فقه"] },
    { id: 90, question: "ما حكم الصيام للمسافر؟", answer: "للمسافر الإفطار والقضاء، والصيام أفضل لمن لا ضرر عليه في السفر، والفطر أفضل إن شق عليه.", hadith: "فَمَن كَانَ مِنكُم مَّرِيضًا أَوْ عَلَىٰ سَفَرٍ فَعِدَّةٌ مِّنْ أَيَّامٍ أُخَرَ (البقرة:184)", tags: ["سفر", "صيام", "رخصة", "فقه"] },
    { id: 91, question: "ما حكم مصافحة المرأة الأجنبية؟", answer: "لا يجوز للرجل أن يصافح المرأة الأجنبية، وهو من كبائر الذنوب.", hadith: "عن معقل بن يسار قال: قال رسول الله صلى الله عليه وسلم: 'لأن يطعن في رأس أحدكم بمخيط من حديد خير له من أن يمس امرأة لا تحل له' رواه الطبراني.", tags: ["مصافحة", "نساء", "حرام", "فقه"] },
    { id: 92, question: "ما حكم الخلوة بالمرأة الأجنبية؟", answer: "الخلوة بالأجنبية محرمة، وهي من أبواب الفتنة والزنا.", hadith: "عن النبي صلى الله عليه وسلم قال: 'لا يخلون رجل بامرأة فإن ثالثهما الشيطان' رواه الترمذي.", tags: ["خلوة", "نساء", "حرام", "فقه"] },
    { id: 93, question: "ما حكم النظر إلى المرأة الأجنبية؟", answer: "يحرم النظر إلى المرأة الأجنبية بشهوة أو بدونها، ويجب غض البصر.", hadith: "قُل لِّلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ (النور:30)", tags: ["نظر", "نساء", "حرام", "فقه"] },
    { id: 94, question: "ما حكم الزنا؟", answer: "الزنا من كبائر الذنوب، وفيه الحد: الرجم للمحصن، والجلد مئة للبكر.", hadith: "الزَّانِيَةُ وَالزَّانِي فَاجْلِدُوا كُلَّ وَاحِدٍ مِّنْهُمَا مِائَةَ جَلْدَةٍ (النور:2)", tags: ["زنا", "حد", "كبيرة", "فقه"] },
    { id: 95, question: "ما حكم اللواط؟", answer: "اللواط (المثلية) من أكبر الكبائر، وفيه القتل على الراجح، وهو من الفواحش العظيمة.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'من وجدتموه يعمل عمل قوم لوط فاقتلوا الفاعل والمفعول به' رواه أبو داود.", tags: ["لواط", "مثلية", "حرام", "حد"] },
    { id: 96, question: "ما حكم نكاح المتعة؟", answer: "نكاح المتعة حرام، وهو زواج مؤقت بوقت معين، وقد حرمه النبي صلى الله عليه وسلم.", hadith: "عن علي قال: 'نهى رسول الله صلى الله عليه وسلم عن متعة النساء يوم خيبر وعن لحوم الحمر الإنسية' متفق عليه.", tags: ["متعة", "زواج", "حرام", "نكاح"] },
    { id: 97, question: "ما حكم الزواج بغير ولي؟", answer: "لا يصح عقد النكاح إلا بولي، وأبعد الولي عصبة المرأة.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'أيما امرأة نكحت بغير إذن وليها فنكاحها باطل، فنكاحها باطل، فنكاحها باطل' رواه أبو داود.", tags: ["زواج", "ولي", "نكاح", "فقه"] },
    { id: 98, question: "ما حكم الزواج بلا شهود؟", answer: "يشترط لصحة النكاح شهود، لقوله صلى الله عليه وسلم: 'لا نكاح إلا بولي وشاهدي عدل' رواه البيهقي.", tags: ["زواج", "شهود", "نكاح", "فقه"] },
    { id: 99, question: "ما حكم الزواج من الكتابية؟", answer: "يجوز للمسلم الزواج من الكتابية (يهودية أو نصرانية) بشروط: العفة، وألا تكون حربية، والأولى تركها.", hadith: "الْيَوْمَ أُحِلَّ لَكُمُ الطَّيِّبَاتُ ۖ وَطَعَامُ الَّذِينَ أُوتُوا الْكِتَابَ حِلٌّ لَّكُمْ وَطَعَامُكُمْ حِلٌّ لَّهُمْ ۖ وَالْمُحْصَنَاتُ مِنَ الْمُؤْمِنَاتِ وَالْمُحْصَنَاتُ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِن قَبْلِكُمْ (المائدة:5)", tags: ["زواج", "كتابية", "نصرانية", "نكاح"] },
    { id: 100, question: "ما حكم تعدد الزوجات؟", answer: "تعدد الزوجات جائز إلى أربع، بشرط العدل بينهن، والأصل الإباحة، وقد توجب للحاجة.", hadith: "فَانكِحُوا مَا طَابَ لَكُم مِّنَ النِّسَاءِ مَثْنَىٰ وَثُلَاثَ وَرُبَاعَ (النساء:3)", tags: ["تعدد", "زواج", "نكاح", "فقه"] },
    { id: 101, question: "ما حكم الخلع؟", answer: "الخلع جائز وهو فسخ النكاح بطلب الزوجة ورد المهر أو بعضه، بشرط رضا الزوج أو القضاء.", hadith: "عن ابن عباس أن امرأة ثابت بن قيس أتت النبي صلى الله عليه وسلم فقالت: لا أعيب عليه في خلق ولا دين ولكني أكره الكفر في الإسلام، فقال النبي: 'أتردين حديقته؟' قالت: نعم، فأمره أن يأخذ منها ويخلعها. رواه البخاري.", tags: ["خلع", "طلاق", "نكاح", "فقه"] },
    { id: 102, question: "ما حكم الحلف بالطلاق؟", answer: "الحلف بالطلاق يقع به الطلاق إذا حنث، وهو مكروه لأنه من أيمان الفساق.", hadith: "عن ابن عمر قال: 'كانت اليمين بالطلاق في الجاهلية، فلما جاء الإسلام قال النبي صلى الله عليه وسلم: من كان حالفاً فليحلف بالله أو ليصمت' متفق عليه.", tags: ["طلاق", "يمين", "حلف", "فقه"] },
    { id: 103, question: "ما حكم النشوز؟", answer: "النشوز هو عصيان الزوجة لزوجها بغير حق، وفيه مراتب: الوعظ، الهجر في المضجع، الضرب غير المبرح.", hadith: "وَاللَّاتِي تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَاهْجُرُوهُنَّ فِي الْمَضَاجِعِ وَاضْرِبُوهُنَّ (النساء:34)", tags: ["نشوز", "زوجة", "فقه", "أسرة"] },
    { id: 104, question: "ما حكم الإيلاء؟", answer: "الإيلاء هو حلف الزوج على ترك وطء زوجته أربعة أشهر فصاعداً، فإن مضت أربعة أشهر وجب الفيء أو الطلاق.", hadith: "لِّلَّذِينَ يُؤْلُونَ مِن نِّسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ ۖ فَإِن فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَّحِيمٌ (البقرة:226)", tags: ["إيلاء", "زوج", "فقه", "أسرة"] },
    { id: 105, question: "ما حكم الظهار؟", answer: "الظهار محرم، وهو قول الرجل لزوجته: أنت علي كظهر أمي، وفيه كفارة.", hadith: "قَدْ سَمِعَ اللَّهُ قَوْلَ الَّتِي تُجَادِلُكَ فِي زَوْجِهَا وَتَشْتَكِي إِلَى اللَّهِ وَاللَّهُ يَسْمَعُ تَحَاوُرَكُمَا (المجادلة:1)", tags: ["ظهار", "زوجة", "فقه", "أسرة"] },
    { id: 106, question: "ما حكم اللعان؟", answer: "اللعان شهادة مقترنة بلعن وتغليظ، يشرع عند اتهام الزوج زوجته بالزنا أو نفي الولد.", hadith: "وَالَّذِينَ يَرْمُونَ أَزْوَاجَهُمْ وَلَمْ يَكُن لَّهُمْ شُهَدَاءُ إِلَّا أَنفُسُهُمْ فَشَهَادَةُ أَحَدِهِمْ أَرْبَعُ شَهَادَاتٍ بِاللَّهِ (النور:6)", tags: ["لعان", "زنا", "فقه", "أسرة"] },
    { id: 107, question: "ما حكم الرضاع؟", answer: "الرضاع المحرم ما كان في الحولين خمس رضعات مشبعات، وينشر الحرمة كالنسب.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'يحرم من الرضاع ما يحرم من الولادة' متفق عليه.", tags: ["رضاع", "حرمة", "فقه", "أسرة"] },
    { id: 108, question: "ما حكم الحضانة؟", answer: "الحضانة حق للأم ما لم تتزوج، ثم للأب، ثم للأجداد، وهي حق الطفل وليس حق الأبوين.", hadith: "عن عبد الله بن عمرو أن امرأة قالت: يا رسول الله، إن ابني هذا كان بطني له وعاء، وثديي له سقاء، وحجري له حواء، وإن أباه طلقني وأراد أن ينتزعه مني، فقال لها: 'أنت أحق به ما لم تنكحي' رواه أحمد.", tags: ["حضانة", "طفل", "فقه", "أسرة"] },
    { id: 109, question: "ما حكم النفقة على الزوجة والأولاد؟", answer: "نفقة الزوجة والأولاد واجبة على الزوج والأب، بالمعروف وكفايتهم.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'اتقوا الله في النساء فإنكم أخذتموهن بأمان الله، واستحللتم فروجهن بكلمة الله، ولهن عليكم رزقهن وكسوتهن بالمعروف' رواه مسلم.", tags: ["نفقة", "زوجة", "أولاد", "فقه"] },
    { id: 110, question: "ما حكم عقد القران في رمضان؟", answer: "عقد القران جائز في رمضان، ولا يؤثر على الصيام، أما الدخلة في النهار فتفطر.", hadith: "عن عائشة قالت: 'تزوجني رسول الله صلى الله عليه وسلم في شوال، وبنى بي في شوال' رواه مسلم.", tags: ["زواج", "رمضان", "عقد", "فقه"] },
    { id: 111, question: "ما حكم استخدام حبوب منع الحمل؟", answer: "استخدام حبوب منع الحمل جائز لضرورة أو حاجة معتبرة، بشرط ألا تضر بالمرأة، ويكون بإذن الزوج.", hadith: "عن جابر قال: 'كنا نعزل على عهد رسول الله صلى الله عليه وسلم والقرآن ينزل' متفق عليه.", tags: ["منع حمل", "زواج", "فقه", "أسرة"] },
    { id: 112, question: "ما حكم التلقيح الصناعي؟", answer: "التلقيح الصناعي بمني الزوج وبويضة الزوجة جائز، وحرام إذا كان من متبرع.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الولد للفراش وللعاهر الحجر' متفق عليه.", tags: ["تلقيح", "إنجاب", "فقه", "طب"] },
    { id: 113, question: "ما حكم تأجير الأرحام؟", answer: "تأجير الأرحام محرم قطعاً، لأنه يخلط الأنساب، ويتسبب في مفاسد عظيمة.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'لا تدخلوا على المغيبات'، وقد فسرها العلماء بمن ليس لها محرم، وكذلك تدخل في تأجير الأرحام. رواه البخاري.", tags: ["رحِم", "تأجير", "حرام", "فقه"] },
    { id: 114, question: "ما حكم استئصال الرحم؟", answer: "استئصال الرحم جائز إذا كان لضرورة طبية كالسرطان، ولا يجوز للتعقيم الدائم.", hadith: "عن عبد الله بن مسعود قال: 'نهانا رسول الله صلى الله عليه وسلم عن قطع الذكر' متفق عليه.", tags: ["رحم", "جراحة", "فقه", "طب"] },
    { id: 115, question: "ما حكم الإجهاض؟", answer: "الإجهاض محرم بعد نفخ الروح (120 يوماً)، ويحرم قبلها إلا لعذر شديد كخطر على الأم.", hadith: "عن عبد الله بن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'إن أحدكم يجمع خلقه في بطن أمه أربعين يوماً، ثم يكون في ذلك علقة مثل ذلك، ثم يكون في ذلك مضغة مثل ذلك، ثم يرسل الملك فينفخ فيه الروح...' متفق عليه.", tags: ["إجهاض", "جنين", "حرام", "فقه"] },
    { id: 116, question: "ما حكم الختان؟", answer: "الختان واجب للرجال، ومكرمة للنساء، وهو من سنن الفطرة.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الفطرة خمس: الختان، والاستحداد، وقص الشارب، وتقليم الأظفار، ونتف الإبط' متفق عليه.", tags: ["ختان", "فطرة", "طهارة", "فقه"] },
    { id: 117, question: "ما حكم الحناء للرجال؟", answer: "يجوز للرجل استخدام الحناء للتداوي أو للزينة بشرط عدم التشبه بالنساء.", hadith: "عن أنس قال: 'كان النبي صلى الله عليه وسلم يصبغ به - يعني الحناء - رأسه ولحيته' رواه البخاري.", tags: ["حناء", "رجال", "زينة", "فقه"] },
    { id: 118, question: "ما حكم صبغ الشعر بالسواد؟", answer: "صبغ الشعر بالسواد حرام، لما فيه من تغيير خلق الله وتدليس.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'غيروا هذا الشيب، واجتنبوا السواد' رواه مسلم.", tags: ["صبغ", "شعر", "حرام", "زينة"] },
    { id: 119, question: "ما حكم الوصل في الشعر؟", answer: "وصل الشعر محرم، وهو من كبائر الذنوب، وفيه لعن الواصلة والمستوصلة.", hadith: "عن أسماء بنت أبي بكر قالت: 'لعن رسول الله صلى الله عليه وسلم الواصلة والمستوصلة' متفق عليه.", tags: ["شعر", "وصل", "حرام", "زينة"] },
    { id: 120, question: "ما حكم الوشم؟", answer: "الوشم محرم، وهو من كبائر الذنوب، وفيه لعن الواشمة والمستوشمة.", hadith: "عن ابن عمر قال: 'لعن رسول الله صلى الله عليه وسلم الواصلة والمستوصلة، والواشمة والمستوشمة' متفق عليه.", tags: ["وشم", "حرام", "زينة", "فقه"] },
    { id: 121, question: "ما حكم النمص؟", answer: "النمص (نتف شعر الحاجبين) محرم، وهو من كبائر الذنوب.", hadith: "لعن رسول الله صلى الله عليه وسلم النامصة والمتنمصة. متفق عليه.", tags: ["نمص", "حاجب", "حرام", "زينة"] },
    { id: 122, question: "ما حكم التفلج؟", answer: "التفلج (برد الأسنان للتباعد) محرم، وهو تغيير لخلق الله.", hadith: "لعن رسول الله صلى الله عليه وسلم المتفلجات للحسن المغيرات خلق الله. متفق عليه.", tags: ["أسنان", "تفلج", "حرام", "زينة"] },
    { id: 123, question: "ما حكم قص الأظفار؟", answer: "قص الأظفار من سنن الفطرة، ويستحب يوم الجمعة، ولا يترك فوق أربعين يوماً.", hadith: "عن أنس قال: 'وقت لنا في قص الشارب، وتقليم الأظفار، ونتف الإبط، وحلق العانة: ألا نترك أكثر من أربعين ليلة' رواه مسلم.", tags: ["أظفار", "فطرة", "نظافة", "فقه"] },
    { id: 124, question: "ما حكم حلق اللحية؟", answer: "حلق اللحية حرام، وهو من كبائر الذنوب، وإعفاؤها واجب.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'خالفوا المشركين: وفروا اللحى، وأحفوا الشوارب' متفق عليه.", tags: ["لحية", "حلق", "حرام", "فقه"] },
    { id: 125, question: "ما حكم إطالة الشارب؟", answer: "إطالة الشارب مكروهة، والأمر بقص الشارب وإحفائه.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من كان له شعر فليكرمه' رواه أبو داود، وفي رواية: 'قصوا الشارب وأعفوا اللحية' متفق عليه.", tags: ["شارب", "قص", "فطرة", "فقه"] },
    { id: 126, question: "ما حكم قص الأظفار للجنب؟", answer: "يجوز للجنب قص أظفاره، ولا حرج في ذلك، ولا يحتاج لاغتسال.", hadith: "عن عائشة قالت: 'كان رسول الله صلى الله عليه وسلم إذا اغتسل من الجنابة بدأ فغسل يديه، ثم توضأ كما يتوضأ للصلاة' متفق عليه، وليس فيه منع.", tags: ["جنب", "أظفار", "طهارة", "فقه"] },
    { id: 127, question: "ما حكم الصلاة خلف إمام يسب الصحابة؟", answer: "لا تصح الصلاة خلف من يسب الصحابة، لأنه كافر مرتد لسبه من ثبتت عدالتهم بالكتاب والسنة.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تسبوا أصحابي، فوالذي نفسي بيده لو أن أحدكم أنفق مثل أحد ذهباً ما بلغ مد أحدهم ولا نصيفه' متفق عليه.", tags: ["صلاة", "إمام", "صحابة", "فقه"] },
    { id: 128, question: "ما حكم الصلاة خلف الفاسق؟", answer: "تكره الصلاة خلف الفاسق الظاهر فسقه، وتصح مع الكراهة على الراجح، والأفضل إعادتها.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'يليكم منكم أولو الأحلام والنهى' رواه مسلم.", tags: ["صلاة", "فاسق", "إمامة", "فقه"] },
    { id: 129, question: "ما حكم ترك الجماعة للعذر؟", answer: "يجوز ترك صلاة الجماعة بعذر شرعي كمرض أو خوف أو مطر شديد.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'من سمع النداء فلم يأته فلا صلاة له، إلا من عذر' رواه ابن ماجه.", tags: ["جماعة", "عذر", "صلاة", "فقه"] },
    { id: 130, question: "ما حكم الجمع بين الصلاتين للمطر؟", answer: "يجوز الجمع بين الظهر والعصر، والمغرب والعشاء في المطر الشديد الذي يشق معه الذهاب للمسجد.", hadith: "عن ابن عباس قال: 'جمع رسول الله صلى الله عليه وسلم بين الظهر والعصر، والمغرب والعشاء بالمدينة من غير خوف ولا سفر' رواه مسلم.", tags: ["جمع", "صلاة", "مطر", "فقه"] },
    { id: 131, question: "ما حكم القصر والجمع للمسافر؟", answer: "للمسافر قصر الصلاة الرباعية إلى ركعتين، وجمع الظهر مع العصر والمغرب مع العشاء، من حين يخرج من بلده حتى يعود.", hadith: "عن ابن عمر قال: 'كان رسول الله صلى الله عليه وسلم إذا سافر يجمع بين المغرب والعشاء' متفق عليه.", tags: ["قصر", "جمع", "سفر", "صلاة"] },
    { id: 132, question: "ما هي مسافة القصر؟", answer: "مسافة القصر والجمع عند الجمهور نحو 83 كيلومتراً، وقيل 81 كيلومتراً، وقيل أقل، والأحوط ألا يقصر فيما دونها.", hadith: "عن يحيى بن يزيد الهنايي قال: سألت أنس بن مالك عن قصر الصلاة، فقال: 'كان رسول الله صلى الله عليه وسلم إذا خرج مسيرة ثلاثة أميال أو ثلاثة فراسخ صلى ركعتين' رواه مسلم.", tags: ["قصر", "مسافة", "سفر", "صلاة"] },
    { id: 133, question: "ما حكم صلاة الخوف؟", answer: "صلاة الخوف تصلى في حال الخوف من العدو، وهي ركعتان لكل طائفة، أو ركعة بطولها.", hadith: "وَإِذَا كُنتَ فِيهِمْ فَأَقَمْتَ لَهُمُ الصَّلَاةَ فَلْتَقُمْ طَائِفَةٌ مِّنْهُم مَّعَكَ وَلْيَأْخُذُوا أَسْلِحَتَهُمْ (النساء:102)", tags: ["خوف", "صلاة", "جهاد", "فقه"] },
    { id: 134, question: "ما حكم صلاة الكسوف؟", answer: "صلاة الكسوف سنة مؤكدة، وتصلى ركعتين في كل ركعة قراءتان وركوعان وسجدتان.", hadith: "عن عائشة قالت: 'خسفت الشمس في عهد رسول الله صلى الله عليه وسلم فصلى بالناس...' متفق عليه.", tags: ["كسوف", "خسوف", "صلاة", "فقه"] },
    { id: 135, question: "ما حكم صلاة الاستسقاء؟", answer: "صلاة الاستسقاء سنة عند الجدب، تصلى ركعتين، يخطب بعدها الإمام ويدعو ويستغفر.", hadith: "عن ابن عباس قال: 'خرج رسول الله صلى الله عليه وسلم متواضعاً متبذلاً متخشعاً متضرعاً فصلى ركعتين كما يصلي في العيد' رواه الترمذي.", tags: ["استسقاء", "مطر", "صلاة", "فقه"] },
    { id: 136, question: "ما حكم صلاة التطوع في البيت؟", answer: "صلاة التطوع في البيت أفضل من المسجد، إلا ما ورد استحبابه في المسجد كالتحية.", hadith: "عن زيد بن ثابت قال: قال رسول الله صلى الله عليه وسلم: 'صلاة المرء في بيته أفضل من صلاته في مسجدي هذا إلا المكتوبة' رواه أبو داود.", tags: ["تطوع", "بيت", "صلاة", "فقه"] },
    { id: 137, question: "ما حكم صلاة الضحى؟", answer: "صلاة الضحى سنة مؤكدة، أقلها ركعتان، وأوسطها أربع، وأكثرها ثمان، ووقتها من ارتفاع الشمس إلى قبيل الظهر.", hadith: "عن أبي هريرة قال: 'أوصاني خليلي صلى الله عليه وسلم بثلاث: صيام ثلاثة أيام من كل شهر، وركعتي الضحى، وأن أوتر قبل أن أنام' متفق عليه.", tags: ["ضحى", "تطوع", "صلاة", "فقه"] },
    { id: 138, question: "ما حكم صلاة الوتر؟", answer: "صلاة الوتر سنة مؤكدة، أقلها ركعة واحدة، وأكثرها إحدى عشرة ركعة، وقتها من بعد العشاء إلى طلوع الفجر.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'اجعلوا آخر صلاتكم بالليل وتراً' متفق عليه.", tags: ["وتر", "صلاة", "ليل", "فقه"] },
    { id: 139, question: "ما حكم صلاة الاستخارة؟", answer: "صلاة الاستخارة سنة لمن أراد أمراً مباحاً، يصلي ركعتين ثم يدعو بدعاء الاستخارة.", hadith: "عن جابر قال: 'كان رسول الله صلى الله عليه وسلم يعلمنا الاستخارة في الأمور كما يعلمنا السورة من القرآن' رواه البخاري.", tags: ["استخارة", "صلاة", "دعاء", "فقه"] },
    { id: 140, question: "ما حكم صلاة التوبة؟", answer: "صلاة التوبة سنة، يصلي العبد ركعتين ثم يستغفر الله ويتوب إليه.", hadith: "عن علي قال: قال رسول الله صلى الله عليه وسلم: 'ما من عبد يذنب ذنباً ثم يتوضأ ويصلي ركعتين ثم يستغفر الله إلا غفر له' رواه الترمذي.", tags: ["توبة", "صلاة", "استغفار", "فقه"] },
    { id: 141, question: "ما حكم صلاة الحاجة؟", answer: "صلاة الحاجة سنة ركعتان، ثم يدعو بحاجته، وليست بثابتة قوياً، والأفضل الدعاء في السجود.", hadith: "عن عبد الله بن أبي أوفى قال: قال رسول الله صلى الله عليه وسلم: 'من كانت له إلى الله حاجة أو إلى أحد من بني آدم فليتوضأ وليحسن الوضوء، ثم ليصل ركعتين...' رواه الترمذي.", tags: ["حاجة", "صلاة", "دعاء", "فقه"] },
    { id: 142, question: "ما حكم صلاة التسابيح؟", answer: "صلاة التسابيح غير ثابتة عن النبي صلى الله عليه وسلم على الصحيح، والأولى تركها والاشتغال بما صح.", hadith: "عن ابن عباس حديث صلاة التسابيح، قال عنه أبو داود: 'ليس هو بمحفوظ'، وقال أحمد: 'لا يصح'", tags: ["تسابيح", "صلاة", "بدعة", "فقه"] },
    { id: 143, question: "ما حكم السجود على الأرض؟", answer: "السجود يكون على الأرض أو ما نبت منها كالحصير، ولا يجوز السجود على ما ليس من الأرض كالفرش الناعم.", hadith: "عن أنس قال: 'كنا نصلي مع رسول الله صلى الله عليه وسلم في شدة الحر فيسجد أحدنا على ثوبه' متفق عليه.", tags: ["سجود", "تراب", "صلاة", "فقه"] },
    { id: 144, question: "ما حكم رفع اليدين في الصلاة؟", answer: "رفع اليدين في الصلاة سنة في أربعة مواضع: تكبيرة الإحرام، والركوع، والرفع منه، والقيام إلى الثالثة.", hadith: "عن ابن عمر قال: 'كان النبي صلى الله عليه وسلم يرفع يديه حذو منكبيه إذا افتتح الصلاة، وإذا كبر للركوع، وإذا رفع رأسه من الركوع رفعهما كذلك' متفق عليه.", tags: ["رفع", "يدين", "صلاة", "فقه"] },
    { id: 145, question: "ما حكم الجهر بالبسملة؟", answer: "الجهر بالبسملة في الصلاة الجهرية سنة عند الشافعية، وليس بسنة عند الجمهور، والأمر واسع.", hadith: "عن أنس قال: 'صليت خلف النبي صلى الله عليه وسلم وأبي بكر وعمر وعثمان فكانوا لا يجهرون ببسم الله الرحمن الرحيم' رواه النسائي.", tags: ["بسملة", "جهر", "صلاة", "فقه"] },
    { id: 146, question: "ما حكم وضع اليدين على الصدر في الصلاة؟", answer: "وضع اليدين على الصدر بعد القيام من الركوع سنة، واليد اليمنى على اليسرى، ووضعهما تحت الصدر وفوق السرة.", hadith: "عن وائل بن حجر قال: 'رأيت رسول الله صلى الله عليه وسلم وضع يمينه على شماله في الصلاة على صدره' رواه ابن خزيمة.", tags: ["يدين", "صدر", "صلاة", "فقه"] },
    { id: 147, question: "ما حكم السجود على المرفقين؟", answer: "يحرم السجود على المرفقين، والسنة وضع اليدين على الأرض وتجافي المرفقين عن الجنبين.", hadith: "عن أنس قال: قال رسول الله صلى الله عليه وسلم: 'اعتدلوا في السجود، ولا يبسط أحدكم ذراعيه انبساط الكلب' متفق عليه.", tags: ["سجود", "مرفق", "صلاة", "فقه"] },
    { id: 148, question: "ما حكم الالتفات في الصلاة؟", answer: "الالتفات في الصلاة بغير حاجة مكروه، وهو من اختلاس الشيطان من صلاة العبد.", hadith: "عن عائشة قالت: سألت رسول الله صلى الله عليه وسلم عن الالتفات في الصلاة فقال: 'هو اختلاس يختلسه الشيطان من صلاة العبد' رواه البخاري.", tags: ["التفات", "صلاة", "خشوع", "فقه"] },
    { id: 149, question: "ما حكم الصلاة بالنعال؟", answer: "الصلاة بالنعال جائزة، وتكون سنة إذا كانت النعال طاهرة، وفي المسجد الأفضل خلعها لما فيه من الأذى.", hadith: "عن شداد بن أوس قال: قال رسول الله صلى الله عليه وسلم: 'خالفوا اليهود، فإنهم لا يصلون في نعالهم ولا خفافهم' رواه أبو داود.", tags: ["نعال", "صلاة", "لباس", "فقه"] },
    { id: 150, question: "ما حكم الصلاة في المسجد الذي به قبر؟", answer: "لا تصح الصلاة في المسجد الذي به قبر، بل يجب نبش القبر أو هدم المسجد.", hadith: "عن عائشة وأم سلمة قالتا: 'لما نزل برسول الله صلى الله عليه وسلم طفق يطرح خميصة على وجهه، فإذا اغتم كشفها، فقال: لعنة الله على اليهود والنصارى اتخذوا قبور أنبيائهم مساجد' متفق عليه.", tags: ["قبر", "مسجد", "صلاة", "فقه"] },
    { id: 151, question: "ما حكم التكبير في العيدين؟", answer: "التكبير في العيدين سنة، ويبدأ من غروب شمس ليلة العيد إلى صلاة العيد، وفي الأضحى يستمر إلى آخر أيام التشريق.", hadith: "وَلِتُكْمِلُوا الْعِدَّةَ وَلِتُكَبِّرُوا اللَّهَ عَلَىٰ مَا هَدَاكُمْ (البقرة:185)", tags: ["تكبير", "عيد", "فطر", "أضحى"] },
    { id: 152, question: "ما حكم صلاة العيدين؟", answer: "صلاة العيدين سنة مؤكدة، أو واجبة على الرجال، تصلى ركعتين بسبع تكبيرات في الأولى وخمس في الثانية.", hadith: "عن أبي سعيد قال: 'كان رسول الله صلى الله عليه وسلم يخرج يوم الفطر والأضحى إلى المصلى' متفق عليه.", tags: ["عيد", "صلاة", "فطر", "أضحى"] },
    { id: 153, question: "ما حكم الخطبة بعد صلاة العيد؟", answer: "الخطبة بعد صلاة العيد سنة، ويستحب الاستماع لها، ومن شاء تركها جاز.", hadith: "عن ابن عباس قال: 'شهدت العيد مع النبي صلى الله عليه وسلم وأبي بكر وعمر وعثمان، فكلهم كانوا يصلون قبل الخطبة' متفق عليه.", tags: ["عيد", "خطبة", "صلاة", "فقه"] },
    { id: 154, question: "ما حكم الأضحية عن الميت؟", answer: "الأضحية عن الميت جائزة، وله أجرها إن شاء الله، خاصة إذا أوصى بها.", hadith: "عن سعد بن عبادة قال: قلت: يا رسول الله، إن أمي ماتت، أفأتصدق عنها؟ قال: 'نعم' قال: فأي الصدقة أفضل؟ قال: 'سقي الماء' رواه النسائي، والأضحية داخلة في الصدقة.", tags: ["أضحية", "ميت", "صدقة", "فقه"] },
    { id: 155, question: "ما حكم أكل الأضحية؟", answer: "يستحب أن يأكل من أضحيته، ويهدي، ويتصدق، والأكل أفضل من التصدق بالكل.", hadith: "عن سلمة بن الأكوع قال: قال رسول الله صلى الله عليه وسلم: 'كلوا وأطعموا وتزودوا' رواه البخاري.", tags: ["أضحية", "أكل", "صدقة", "فقه"] },
    { id: 156, question: "ما حكم العقيقة عن النفس؟", answer: "العقيقة عن النفس غير مشروعة، إنما هي عن المولود، وهو مما فعله السلف.", hadith: "عن سمرة قال: قال رسول الله صلى الله عليه وسلم: 'كل غلام رهينة بعقيقته' رواه الترمذي، والحديث في المولود.", tags: ["عقيقة", "نفس", "مولود", "فقه"] },
    { id: 157, question: "ما حكم تسمية المولود؟", answer: "تسمية المولود واجبة، وتكون يوم السابع مع العقيقة، ويستحب التسمية بأسماء الأنبياء والصالحين.", hadith: "عن أبي الدرداء قال: قال رسول الله صلى الله عليه وسلم: 'إنكم تدعون يوم القيامة بأسمائكم وأسماء آبائكم، فأحسنوا أسماءكم' رواه أبو داود.", tags: ["تسمية", "مولود", "اسم", "فقه"] },
    { id: 158, question: "ما حكم تغيير الأسماء القبيحة؟", answer: "تغيير الاسم القبيح أو الذي يعبر عن معنى سيئ مستحب، وكان النبي يغير الأسماء.", hadith: "عن ابن عمر أن رسول الله صلى الله عليه وسلم غير اسم عاصية وقال: 'أنت جميلة' رواه مسلم.", tags: ["اسم", "تغيير", "فقه", "أخلاق"] },
    { id: 159, question: "ما حكم التهنئة بالمولود؟", answer: "التهنئة بالمولود مستحبة، وتكون بالدعاء بالبركة والشكر لله.", hadith: "عن أبي موسى الأشعري قال: 'ولد لي غلام فأتيت به النبي صلى الله عليه وسلم فسماه إبراهيم وحنكه' متفق عليه، وهذا فيه تهنئة ضمنية.", tags: ["مولود", "تهنئة", "فقه", "أخلاق"] },
    { id: 160, question: "ما حكم العقيقة عن الإجهاض؟", answer: "إذا سقط الجنين بعد نفخ الروح (أربعة أشهر) فيعق عنه ويدفن ويسمى، وإذا سقط قبل ذلك فلا عقيقة عليه.", hadith: "عن المغيرة بن شعبة قال: قال رسول الله صلى الله عليه وسلم: 'السقط إذا استهل فورث وصلي عليه' رواه أبو داود.", tags: ["إجهاض", "عقيقة", "جنين", "فقه"] },
    { id: 161, question: "ما حكم دفن الجنين؟", answer: "الواجب دفن الجنين الساقط، سواء نفخت فيه الروح أم لا، ولا يصلى عليه إلا إذا استهل.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'السقط يصلى عليه ويدعى لوالديه بالمغفرة والرحمة' رواه أبو داود.", tags: ["جنين", "دفن", "جنائز", "فقه"] },
    { id: 162, question: "ما حكم البكاء على الميت؟", answer: "البكاء على الميت جائز بدون ندب، وهو رحمة، والنياحة محرمة.", hadith: "عن ابن عمر قال: 'أخذ رسول الله صلى الله عليه وسلم بيد عبد الله بن جعفر فرأى امرأة تبكي فقال: أرسلوا هذه فإن عيناً تدمع ونفساً تصاب وعهداً حديث' رواه ابن ماجه.", tags: ["بكاء", "ميت", "جنائز", "فقه"] },
    { id: 163, question: "ما حكم زيارة القبور للرجال؟", answer: "زيارة القبور للرجال سنة، لتذكر الآخرة والدعاء للأموات.", hadith: "عن بريدة قال: قال رسول الله صلى الله عليه وسلم: 'كنت نهيتكم عن زيارة القبور فزوروها فإنها تذكركم الآخرة' رواه مسلم.", tags: ["قبور", "زيارة", "رجال", "فقه"] },
    { id: 164, question: "ما هي آداب زيارة القبور؟", answer: "آدابها: السلام على الموتى، والدعاء لهم، والاستغفار، وقراءة ما تيسر من القرآن، وتجنب الجلوس على القبور والبناء عليها.", hadith: "عن عائشة قالت: قلت: كيف أقول لهم يا رسول الله؟ قال: 'قولي: السلام على أهل الديار من المؤمنين والمسلمين، ويرحم الله المستقدمين منا والمستأخرين، وإنا إن شاء الله بكم للاحقون' رواه مسلم.", tags: ["قبور", "آداب", "زيارة", "فقه"] },
    { id: 165, question: "ما حمن المشي على القبور؟", answer: "يحرم المشي على القبور، والجلوس عليها، والاتكاء عليها من غير حاجة.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'لأن أمشي على جمرة أو سيف أو أخصف نعلي برجلي أحب إلي من أن أمشي على قبر مسلم' رواه ابن ماجه.", tags: ["قبر", "مشي", "حرام", "جنائز"] },
    { id: 166, question: "ما حكم الجلوس على القبر؟", answer: "الجلوس على القبر محرم، لما فيه من إيذاء الميت وعدم احترام حرمته.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لأن يجلس أحدكم على جمرة فتحرق ثيابه فتخلص إلى جلده خير له من أن يجلس على قبر' رواه مسلم.", tags: ["قبر", "جلوس", "حرام", "جنائز"] },
    { id: 167, question: "ما حكم الكتابة على القبور؟", answer: "الكتابة على القبور محرمة، سواء كانت بآية قرآنية أو اسم الميت أو تاريخ وفاته.", hadith: "عن جابر قال: 'نهى رسول الله صلى الله عليه وسلم أن يجصص القبر، وأن يكتب عليه، وأن يبنى عليه' رواه الترمذي.", tags: ["قبر", "كتابة", "حرام", "جنائز"] },
    { id: 168, question: "ما حكم التكفين؟", answer: "التكفين فرض كفاية على المسلمين، وأقل ما يكفي ساتر لجميع البدن، والأفضل ثلاثة أثواب للرجل وخمسة للمرأة.", hadith: "عن عائشة قالت: 'كفن رسول الله صلى الله عليه وسلم في ثلاثة أثواب بيض سحولية ليس فيها قميص ولا عمامة' متفق عليه.", tags: ["تكفين", "جنائز", "فقه", "عبادات"] },
    { id: 169, question: "ما حكم تلقين الميت؟", answer: "تلقين الميت بعد الدفن سنة، وهو تذكيره بالشهادتين، والدعاء له بالتثبيت.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لقنوا موتاكم لا إله إلا الله' رواه مسلم.", tags: ["تلقين", "ميت", "جنائز", "فقه"] },
    { id: 170, question: "ما حكم وضع الجريد على القبر؟", answer: "وضع الجريد أو الخضرة على القبر سنة، تخفيفاً عن الميت ما دام رطباً.", hadith: "عن ابن عمر قال: 'كان رسول الله صلى الله عليه وسلم إذا خرج من الخاء نخل، أتي بقبرين فقال: إنهما ليعذبان وما يعذبان في كبير، أما أحدهما فكان لا يستتر من البول، وأما الآخر فكان يمشي بالنميمة، ثم أخذ جريدة رطبة فشقها نصفين ثم غرز على كل قبر واحدة، فقال: لعله يخفف عنهما ما لم ييبسا' متفق عليه.", tags: ["قبر", "جريد", "جنائز", "فقه"] },
    { id: 171, question: "ما حكم النياحة على الميت؟", answer: "النياحة (البكاء بصوت عال) محرمة، وهي من كبائر الذنوب، وفيه وعيد شديد.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'اثنتان في الناس هما بهم كفر: الطعن في النسب، والنياحة على الميت' رواه مسلم.", tags: ["نياحة", "ميت", "حرام", "جنائز"] },
    { id: 172, question: "ما حكم شق الجيوب على الميت؟", answer: "شق الجيوب ولطم الخدود ودعوى الجاهلية كلها محرمة، وفعلها من كبائر الذنوب.", hadith: "عن عبد الله بن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'ليس منا من شق الجيوب، وضرب الخدود، ودعا بدعوى الجاهلية' متفق عليه.", tags: ["ميت", "جنائز", "حرام", "جاهلية"] },
    { id: 173, question: "ما حكم إقامة العزاء؟", answer: "إقامة العزاء وتلقي التعازي مشروع للمصاب، وأما الاجتماعات الخاصة للعزاء فلم تثبت عن السلف.", hadith: "عن جرير بن عبد الله قال: 'كنا نعد الاجتماع إلى أهل الميت وصنعة الطعام بعد دفنه من النياحة' رواه أحمد.", tags: ["عزاء", "ميت", "فقه", "جنائز"] },
    { id: 174, question: "ما حكم الصدقة عن الميت؟", answer: "الصدقة عن الميت جائزة، وتصل إليه، وتنفعه بإذن الله، وله أجرها.", hadith: "عن عائشة أن رجلاً قال للنبي صلى الله عليه وسلم: إن أمي افتلتت نفسها، وأظنها لو تكلمت تصدقت، أفلها أجر إن تصدقت عنها؟ قال: 'نعم' متفق عليه.", tags: ["صدقة", "ميت", "فقه", "عبادات"] },
    { id: 175, question: "ما حكم الحج عن الميت؟", answer: "الحج عن الميت جائز إذا كان حجة الإسلام واجبة عليه، وعجز عن أدائها أو مات قبل أن يحج.", hadith: "عن ابن عباس أن امرأة قالت: يا رسول الله، إن فريضة الله على عباده في الحج أدركت أبي شيخاً كبيراً لا يستطيع أن يستوي على الراحلة، أفأحج عنه؟ قال: 'نعم' رواه البخاري.", tags: ["حج", "ميت", "فقه", "عبادات"] },
    { id: 176, question: "ما حكم قراءة القرآن للميت؟", answer: "قراءة القرآن وإهداء ثوابها للميت جائز عند جمهور العلماء، والخلاف فيه سائغ.", hadith: "عن معقل بن يسار عن النبي صلى الله عليه وسلم قال: 'اقرؤوا يس على موتاكم' رواه أبو داود.", tags: ["قرآن", "ميت", "فقه", "عبادات"] },
    { id: 177, question: "ما حكم عمل سرادق العزاء؟", answer: "عمل سرادقات العزاء والمآتم مكروه، لأنه لم يفعله السلف، وفيه إسراف وتشبه بالجاهلية.", hadith: "عن جرير بن عبد الله قال: 'كنا نعد الاجتماع إلى أهل الميت وصنعة الطعام بعد دفنه من النياحة' رواه أحمد.", tags: ["عزاء", "سرادق", "بدعة", "جنائز"] },
    { id: 178, question: "ما حكم الصيام عن الميت؟", answer: "الصيام عن الميت جائز إذا كان عليه صيام واجب كالنذر أو رمضان، وأما التطوع فلا يصل.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'من مات وعليه صيام صام عنه وليه' متفق عليه.", tags: ["صيام", "ميت", "قضاء", "فقه"] },
    { id: 179, question: "ما حكم الدعاء للميت؟", answer: "الدعاء للميت مشروع، وهو من أفضل ما يهدى له، وينفعه بإذن الله.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'إذا مات ابن آدم انقطع عمله إلا من ثلاث: صدقة جارية، أو علم ينتفع به، أو ولد صالح يدعو له' رواه مسلم.", tags: ["دعاء", "ميت", "فقه", "عبادات"] },
    { id: 180, question: "ما حكم ذكر الميت بالسوء؟", answer: "ذكر الميت بالسوء واغتيابه محرم، وأعراضهم محترمة كأعراض الأحياء.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'لا تسبوا الأموات فإنهم قد أفضوا إلى ما قدموا' رواه البخاري.", tags: ["ميت", "اغتياب", "حرام", "أخلاق"] },
    { id: 181, question: "ما حكم سؤال الميت وقضاء الحوائج عنده؟", answer: "سؤال الميت وقضاء الحوائج عنده شرك أكبر، لأنه لا يملك شيئاً من النفع والضر.", hadith: "وَالَّذِينَ تَدْعُونَ مِن دُونِهِ مَا يَمْلِكُونَ مِن قِطْمِيرٍ (فاطر:13)", tags: ["قبور", "شرك", "عقيدة", "عبادة"] },
    { id: 182, question: "ما حكم التوسل بالأموات؟", answer: "التوسل بالأموات ودعائهم شرك أكبر، والوسائل المشروعة هي التوسل بأسماء الله وصفاته أو بعمل صالح.", hadith: "عن أنس قال: 'كانوا إذا قحطوا استسقى النبي صلى الله عليه وسلم'، وعمر استسقى بالعباس، ولم يتوسل بأحد بعد موته. رواه البخاري.", tags: ["توسل", "قبور", "شرك", "عقيدة"] },
    { id: 183, question: "ما حكم الطواف بالقبور؟", answer: "الطواف بالقبور محرم، وهو من العبادات التي لا تكون إلا لله وحده، وفيه شرك.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'الطواف بالبيت صلاة' رواه الترمذي، والصلاة لا تكون إلا لله.", tags: ["طواف", "قبور", "شرك", "عقيدة"] },
    { id: 184, question: "ما حكم السجود للقبور؟", answer: "السجود للقبور أو لأصحابها شرك أكبر، والسجود لا يكون إلا لله وحده.", hadith: "وَأَنَّ الْمَسَاجِدَ لِلَّهِ فَلَا تَدْعُوا مَعَ اللَّهِ أَحَدًا (الجن:18)", tags: ["سجود", "قبور", "شرك", "عقيدة"] },
    { id: 185, question: "ما حكم ذبح الأضاحي عند القبور؟", answer: "ذبح الأضاحي عند القبور أو ذبحها لصاحب القبر شرك أكبر، والذبح لغير الله محرم.", hadith: "لعن رسول الله صلى الله عليه وسلم من ذبح لغير الله. رواه مسلم.", tags: ["ذبح", "قبور", "شرك", "عقيدة"] },
    { id: 186, question: "ما حكم إيقاد الشموع على القبور؟", answer: "إيقاد الشموع والمصابيح على القبور بدعة ووسيلة إلى الشرك، ولا تجوز.", hadith: "عن ابن عباس قال: 'لعن رسول الله صلى الله عليه وسلم زائرات القبور، والمتخذين عليها المساجد والسرج' رواه أبو داود.", tags: ["قبور", "شموع", "بدعة", "عقيدة"] },
    { id: 187, question: "ما حكم بناء المساجد على القبور؟", answer: "بناء المساجد على القبور محرم، وقد لعن النبي من فعل ذلك.", hadith: "عن عائشة وأم سلمة قالتا: 'لما نزل برسول الله صلى الله عليه وسلم طفق يطرح خميصة على وجهه، فإذا اغتم كشفها، فقال: لعنة الله على اليهود والنصارى اتخذوا قبور أنبيائهم مساجد' متفق عليه.", tags: ["مسجد", "قبر", "شرك", "عقيدة"] },
    { id: 188, question: "ما حكم تعليق التمائم والحرز؟", answer: "تعليق التمائم والحرز محرم، وهو شرك أصغر، وهو من عمل الجاهلية.", hadith: "عن ابن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'إن الرقى والتمائم والتولة شرك' رواه أبو داود.", tags: ["تمائم", "حرز", "شرك", "عقيدة"] },
    { id: 189, question: "ما حكم الكهانة والعرافة؟", answer: "الكهانة والعرافة حرام، والإتيان إليها وتصديقها كفر.", hadith: "عن أبي هريرة عن النبي صلى الله عليه وسلم قال: 'من أتى عرافاً فصدقه بما يقول فقد كفر بما أنزل على محمد' رواه أبو داود.", tags: ["كهانة", "عرافة", "شرك", "عقيدة"] },
    { id: 190, question: "ما حكم السحر؟", answer: "السحر حرام، وهو كفر، ومن تعلمه أو عمله فقد كفر بالله.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'اجتنبوا السبع الموبقات... السحر' متفق عليه.", tags: ["سحر", "كفر", "شرك", "عقيدة"] },
    { id: 191, question: "ما حكم الرقية الشرعية؟", answer: "الرقية الشرعية جائزة، وهي من العلاج بالقرآن والأدعية النبوية، بشرط ألا تكون شركاً.", hadith: "عن عوف بن مالك قال: 'كنا نرقي في الجاهلية، فقلنا: يا رسول الله، كيف ترى في ذلك؟ فقال: اعرضوا علي رقاكم، لا بأس بالرقى ما لم يكن فيه شرك' رواه مسلم.", tags: ["رقية", "علاج", "جائز", "فقه"] },
    { id: 192, question: "ما حكم التبرك بآثار النبي؟", answer: "التبرك بآثار النبي صلى الله عليه وسلم كشعره أو ثوبه أو ماء وضوئه جائز في حياته وبعد موته، بشرط أن يكون لطلب البركة لا لعبادتها.", hadith: "عن أنس قال: 'كان رسول الله صلى الله عليه وسلم إذا حلق رأسه أخذ أبو طلحة شعره فقسمه بين أصحابه' متفق عليه.", tags: ["تبرك", "آثار", "رسول", "عقيدة"] },
    { id: 193, question: "ما حكم التوسل بالنبي بعد موته؟", answer: "التوسل بالنبي بأن نسأله أو نستغيث به بعد موته شرك أكبر، وأما التوسل بدعائه في حياته فجائز.", hadith: "عن عثمان بن حنيف أن رجلاً ضريراً أتى النبي صلى الله عليه وسلم فقال: ادع الله أن يعافيني، فقال: 'إن شئت دعوت، وإن شئت صبرت فهو خير لك' قال: فادعه، فأمره أن يتوضأ ويصلي ركعتين ويدعو بهذا الدعاء: 'اللهم إني أسألك وأتوجه إليك بنبيك محمد نبي الرحمة...' رواه الترمذي. وأما بعد موته فلا.", tags: ["توسل", "رسول", "شرك", "عقيدة"] },
    { id: 194, question: "ما حكم الاستغاثة بغير الله؟", answer: "الاستغاثة بغير الله فيما لا يقدر عليه إلا الله شرك أكبر، كالاستغاثة بالأموات أو الغائبين.", hadith: "إِن تَدْعُوهُمْ لَا يَسْمَعُوا دُعَاءَكُمْ وَلَوْ سَمِعُوا مَا اسْتَجَابُوا لَكُمْ (فاطر:14)", tags: ["استغاثة", "شرك", "عقيدة", "عبادة"] },
    { id: 195, question: "ما حكم النذر لغير الله؟", answer: "النذر لغير الله شرك، والنذر عبادة لا تصرف إلا لله وحده.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'من نذر أن يطيع الله فليطعه، ومن نذر أن يعصيه فلا يعصه' رواه البخاري.", tags: ["نذر", "شرك", "عقيدة", "عبادة"] },
    { id: 196, question: "ما هي شروط لا إله إلا الله؟", answer: "شروطها: العلم، اليقين، القبول، الانقياد، الصدق، الإخلاص، المحبة.", hadith: "عن عثمان بن عفان قال: قال رسول الله صلى الله عليه وسلم: 'من مات وهو يعلم أن لا إله إلا الله دخل الجنة' رواه مسلم.", tags: ["لا إله إلا الله", "شروط", "توحيد", "عقيدة"] },
    { id: 197, question: "ما هي نواقض الإسلام؟", answer: "نواقض الإسلام: الشرك بالله، من جعل بينه وبين الله وسائط، من لم يكفر المشركين، من اعتقد أن غير هدي النبي أكمل، من أبغض شيئاً مما جاء به الرسول، الاستهزاء بالله أو رسوله، السحر، ترك الصلاة.", hadith: "وَلَقَدْ أُوحِيَ إِلَيْكَ وَإِلَى الَّذِينَ مِن قَبْلِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ الْخَاسِرِينَ (الزمر:65)", tags: ["نواقض", "إسلام", "ردة", "عقيدة"] },
    { id: 198, question: "ما حكم من سب الدين؟", answer: "من سب الدين أو استهزأ به فقد كفر، وإن كان يمزح أو يضحك.", hadith: "وَلَئِن سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ ۚ قُلْ أَبِاللَّهِ وَآيَاتِهِ وَرَسُولِهِ كُنتُمْ تَسْتَهْزِئُونَ (التوبة:65)", tags: ["سب", "دين", "استهزاء", "كفر"] },
    { id: 199, question: "ما حكم من أنكر حرفاً من القرآن؟", answer: "من أنكر حرفاً من القرآن أو زعم أنه ليس من عند الله فقد كفر.", hadith: "الم ذَٰلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ (البقرة:1-2)", tags: ["قرآن", "إنكار", "كفر", "عقيدة"] },
    { id: 200, question: "ما حكم من جحد فريضة مجمع عليها؟", answer: "من جحد فريضة مجمع عليها كالصلاة والزكاة والحج فهو كافر مرتد.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'بين الرجل وبين الشرك والكفر ترك الصلاة' رواه مسلم.", tags: ["فريضة", "جحد", "كفر", "عقيدة"] },
    { id: 201, question: "ما هو حكم الإرجاء؟", answer: "الإرجاء بدعة، وهو تأخير العمل عن الإيمان، أو تأخير تكفير صاحب الكبيرة، والراجح أن الإيمان قول وعمل واعتقاد.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الإيمان بضع وسبعون شعبة، فأفضلها قول لا إله إلا الله، وأدناها إماطة الأذى عن الطريق' متفق عليه.", tags: ["إرجاء", "إيمان", "عمل", "عقيدة"] },
    { id: 202, question: "ما هو حكم الطلاق ثلاثاً بلفظ واحد؟", answer: "الطلاق ثلاثاً بلفظ واحد يقع ثلاثاً عند جمهور العلماء، وعند ابن تيمية يقع واحدة، والأحوط اعتبار الثلاث.", hadith: "عن ابن عباس قال: 'كان الطلاق على عهد رسول الله صلى الله عليه وسلم وأبي بكر وسنتين من خلافة عمر طلاق الثلاث واحدة، فقال عمر بن الخطاب: إن الناس قد استعجلوا في أمر كانت لهم فيه أناة، فلو أمضيناه عليهم، فأمضاه عليهم' رواه مسلم.", tags: ["طلاق", "ثلاث", "فقه", "أسرة"] },
    { id: 203, question: "ما حكم إخفاء الحيض عن الزوج؟", answer: "لا يجوز للمرأة إخفاء الحيض عن زوجها، بل يجب إخباره لأنه يمنع الجماع.", hadith: "وَيَسْأَلُونَكَ عَنِ الْمَحِيضِ ۖ قُلْ هُوَ أَذًى فَاعْتَزِلُوا النِّسَاءَ فِي الْمَحِيضِ (البقرة:222)", tags: ["حيض", "زوج", "فقه", "أسرة"] },
    { id: 204, question: "ما حكم صيام يوم عاشوراء لمن عليه قضاء؟", answer: "يجوز صيام عاشوراء مع وجود قضاء، وهو أفضل من إخلاص القضاء وحده، والأفضل صيام القضاء والتطوع.", hadith: "عن أبي قتادة قال: قال رسول الله صلى الله عليه وسلم: 'صيام يوم عاشوراء أحتسب على الله أن يكفر السنة التي قبله' رواه مسلم.", tags: ["عاشوراء", "قضاء", "صيام", "فقه"] },
    { id: 205, question: "ما حكم سجود السهو؟", answer: "سجود السهو مشروع لتعويض النقص في الصلاة، ويسجد سجدتين قبل السلام أو بعده.", hadith: "عن ابن مسعود قال: 'صلى رسول الله صلى الله عليه وسلم الظهر خمساً، فقيل له: أزيد في الصلاة؟ قال: وما ذاك؟ قال: صليت خمساً، فسجد سجدتين بعد ما سلم' متفق عليه.", tags: ["سهو", "سجود", "صلاة", "فقه"] },
    { id: 206, question: "ما حكم سجود التلاوة؟", answer: "سجود التلاوة سنة عند قراءة آية السجدة، يسجد سجدة واحدة ولو خارج الصلاة.", hadith: "عن ابن عمر قال: 'كان النبي صلى الله عليه وسلم يقرأ علينا السورة فيها السجدة فيسجد ونسجد معه' متفق عليه.", tags: ["تلاوة", "سجود", "قرآن", "فقه"] },
    { id: 207, question: "ما حكم سجود الشكر؟", answer: "سجود الشكر سنة عند حصول نعمة أو اندفاع نقمة، يسجد سجدة واحدة شكراً لله.", hadith: "عن أبي بكر الصديق: 'أن النبي صلى الله عليه وسلم كان إذا جاءه أمر سرور أو بشر به خر ساجداً شكراً لله' رواه أبو داود.", tags: ["شكر", "سجود", "عبادات", "فقه"] },
    { id: 208, question: "ما حكم قراءة القرآن للحائض عن ظهر قلب؟", answer: "يجوز للحائض قراءة القرآن عن ظهر قلب على الراجح، بشرط عدم مس المصحف، والله أعلم.", hadith: "عن عائشة قالت: 'كان النبي صلى الله عليه وسلم يضع رأسه في حجري وأنا حائض فيقرأ القرآن' متفق عليه، وهل هي تسمع أو تقرأ؟ الراجح الجواز.", tags: ["حيض", "قرآن", "فقه", "طهارة"] },
    { id: 209, question: "ما حكم إعطاء الزكاة للأخ الفقير؟", answer: "يجوز إعطاء الزكاة للأخ الفقير، وللأخت الفقيرة، وللقريب الفقير، وهو أفضل من الأجنبي.", hadith: "عن سلمان بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'الصدقة على المسكين صدقة، وعلى ذي الرحم اثنتان: صدقة وصلة' رواه الترمذي.", tags: ["زكاة", "أخ", "فقر", "فقه"] },
    { id: 210, question: "ما حكم إعطاء الزكاة للابن الفقير؟", answer: "لا يجوز إعطاء الزكاة للأصل والفرع: للوالدين والأجداد والأولاد، لأن نفقتهم واجبة.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا تعطى الزكاة لغني ولا لذي مرة سوي' رواه أبو داود، والابن تجب نفقته على أبيه.", tags: ["زكاة", "ابن", "فقه", "أموال"] },
    { id: 211, question: "ما حكم منع الزكاة؟", answer: "منع الزكاة من كبائر الذنوب، وفيه وعيد شديد، ويقاتل مانعها حتى يؤديها.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'ما من صاحب ذهب ولا فضة لا يؤدي حقها إلا إذا كان يوم القيامة صفحت له صفائح من نار فأحمي عليها في نار جهنم فيكوى بها جنبه وجبينه وظهره' متفق عليه.", tags: ["زكاة", "منع", "حرام", "أموال"] },
    { id: 212, question: "ما هي الأموال التي تجب فيها الزكاة؟", answer: "تجب الزكاة في: الذهب والفضة، عروض التجارة، المواشي (الإبل، البقر، الغنم)، الزروع والثمار، الركاز والمعادن.", hadith: "عن أبي بكر الصديق قال: 'إن هذه الصدقة لا تحل لمحمد ولا لآل محمد، إنما هي أوساخ الناس' رواه مسلم.", tags: ["زكاة", "أموال", "فقه", "عبادات"] },
    { id: 213, question: "ما هو نصاب الذهب والفضة؟", answer: "نصاب الذهب 20 مثقالاً (85 جراماً)، ونصاب الفضة 200 درهم (595 جراماً)، وكل ما بلغ النصاب وحال عليه الحول تجب فيه الزكاة 2.5%.", hadith: "عن علي قال: قال رسول الله صلى الله عليه وسلم: 'فإذا كانت لك مائتا درهم وحال عليها الحول ففيها خمسة دراهم، وليس عليك شيء حتى يكون لك عشرون ديناراً، فإذا كان لك عشرون ديناراً وحال عليها الحول ففيها نصف دينار' رواه أبو داود.", tags: ["نصاب", "ذهب", "فضة", "زكاة"] },
    { id: 214, question: "ما هي زكاة الفطر ومقدارها؟", answer: "زكاة الفطر صاع من غالب قوت البلد، وتجب على كل مسلم يجد فضلاً عن قوته وقوت عياله يوم العيد، مقدارها 2.5 - 3 كيلو جرام تقريباً.", hadith: "عن ابن عمر قال: 'فرض رسول الله صلى الله عليه وسلم زكاة الفطر من رمضان صاعاً من تمر أو صاعاً من شعير على العبد والحر والذكر والأنثى والصغير والكبير من المسلمين' متفق عليه.", tags: ["زكاة", "فطر", "رمضان", "عبادات"] },
    { id: 215, question: "ما حكم دفع زكاة الفطر نقوداً؟", answer: "لا يجوز دفع زكاة الفطر نقوداً عند جمهور العلماء، ويجوز عند بعضهم للحاجة، والأحوط إخراجها طعاماً.", hadith: "عن أبي سعيد الخدري قال: 'كنا نخرج زكاة الفطر على عهد رسول الله صلى الله عليه وسلم صاعاً من طعام' متفق عليه، والطعام هو الأصل.", tags: ["زكاة", "فطر", "نقود", "فقه"] },
    { id: 216, question: "ما هو وقت إخراج زكاة الفطر؟", answer: "وقت وجوبها غروب شمس آخر يوم من رمضان، ويجوز إخراجها قبل العيد بيوم أو يومين، وآخر وقتها صلاة العيد.", hadith: "عن ابن عمر قال: 'كانوا يعطون زكاة الفطر قبل العيد بيوم أو يومين' متفق عليه.", tags: ["زكاة", "فطر", "وقت", "فقه"] },
    { id: 217, question: "ما حكم من نسي زكاة الفطر حتى بعد العيد؟", answer: "من نسي إخراج زكاة الفطر حتى بعد العيد فعليه إخراجها قضاء، وهي صدقة من الصدقات، ويأثم بالتأخير.", hadith: "عن ابن عباس قال: 'من أداها قبل الصلاة فهي زكاة مقبولة، ومن أداها بعد الصلاة فهي صدقة من الصدقات' رواه أبو داود.", tags: ["زكاة", "فطر", "قضاء", "فقه"] },
    { id: 218, question: "ما حكم إعطاء زكاة المال للأخ الفقير؟", answer: "يجوز إعطاء زكاة المال للأخ الفقير، وللأخت، وللقريب الفقير، وهو أفضل وأعظم أجراً.", hadith: "عن سلمان بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'الصدقة على المسكين صدقة، وعلى ذي الرحم ثنتان: صدقة وصلة' رواه الترمذي.", tags: ["زكاة", "أخ", "فقه", "أموال"] },
    { id: 219, question: "ما حكم إعطاء الزكاة للوالدين الفقيرين؟", answer: "لا يجوز إعطاء الزكاة للوالدين الفقيرين، لأن نفقتهما واجبة، فإذا أعطاهما الزكاة سقطت النفقة الواجبة.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا تعطى الزكاة لغني ولا لذي مرة سوي' رواه أبو داود، والوالدان تجب نفقتهما.", tags: ["زكاة", "والدين", "فقه", "أموال"] },
    { id: 220, question: "ما حكم إعطاء الزكاة للأبناء الفقراء؟", answer: "لا يجوز إعطاء الزكاة للأبناء، لأن الأب تجب عليه نفقتهم، فإذا أعطاهم الزكاة سقطت النفقة الواجبة.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'أنت ومالك لأبيك' رواه ابن ماجه، وهذا في النفقة الواجبة.", tags: ["زكاة", "أبناء", "فقه", "أموال"] },
    { id: 221, question: "ما حكم إخراج زكاة المال عن الغير؟", answer: "يجوز للرجل أن يخرج زكاة ماله عن غيره بإذنه، أو يتبرع بزكاة ماله لفقراء معينين.", hadith: "عن أبي موسى قال: قال النبي صلى الله عليه وسلم: 'كل مسلم عليه صدقة' متفق عليه، والزكاة عبادة، والأصل أن يخرجها المالك بنفسه.", tags: ["زكاة", "غير", "فقه", "أموال"] },
    { id: 222, question: "ما حكم الزكاة عن الدين؟", answer: "الدين الذي عند الناس له أحوال: إن كان على مليء ومرجو الأداء ففيه زكاة، وإن كان على معسر أو مماطل فلا زكاة فيه حتى يقبض.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا زكاة في مال حتى يحول عليه الحول' رواه الترمذي، والدين لم يحل عليه الحول عند المقرض.", tags: ["زكاة", "دين", "فقه", "أموال"] },
    { id: 223, question: "ما حكم زكاة الأسهم؟", answer: "زكاة الأسهم كزكاة عروض التجارة، تقوم قيمتها السوقية كل عام ويخرج 2.5%، ويحسب أيضًا أرباح الأسهم.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'فيما سقت السماء العشر، وفيما سقي بالرش والنضح نصف العشر' متفق عليه، قياساً على عروض التجارة.", tags: ["أسهم", "زكاة", "فقه", "أموال"] },
    { id: 224, question: "ما حكم زكاة السيارات المعدة للتجارة؟", answer: "السيارات المعدة للتجارة فيها الزكاة، تقوم قيمتها كل عام ويخرج 2.5%، وأما سيارات الاستعمال الشخصي فلا زكاة فيها.", hadith: "عن أبي ذر قال: قال رسول الله صلى الله عليه وسلم: 'ما من صاحب إبل لا يؤدي حقها...' ومثلها السيارات إذا كانت للتجارة.", tags: ["زكاة", "سيارات", "فقه", "أموال"] },
    { id: 225, question: "ما حكم زكاة العقار؟", answer: "العقار إذا كان للاستعمال الشخصي فلا زكاة فيه، وإذا كان للتجارة ففيه الزكاة، وإذا كان للإيجار فتزكى أرباحه فقط.", hadith: "عن عمر بن الخطاب قال: 'ما أديت زكاته فليس بكنز' رواه مالك، وهذا في كل المال.", tags: ["زكاة", "عقار", "فقه", "أموال"] },
    { id: 226, question: "ما حكم زكاة الحلي المباح؟", answer: "زكاة الحلي المباح للنساء فيه خلاف، والراجح أنه تجب فيه الزكاة لأنه مال نامٍ، والأحوط إخراجها.", hadith: "عن عبد الله بن عمرو قال: 'أن امرأة أتت رسول الله صلى الله عليه وسلم ومعها ابنة لها وفي يد ابنتها مسكتان غليظتان من ذهب، فقال لها: أتعطين زكاة هذا؟ قالت: لا، قال: أيسرك أن يسورك الله بهما يوم القيامة سوارين من نار؟' رواه أبو داود.", tags: ["زكاة", "حلي", "ذهب", "فقه"] },
    { id: 227, question: "ما حكم إخراج الزكاة لشراء كسوة الشتاء للفقراء؟", answer: "يجوز إخراج الزكاة لشراء كسوة الشتاء للفقراء، بل هو من أفضل وجوه الصدقة إذا كانوا محتاجين.", hadith: "وَيُطْعِمُونَ الطَّعَامَ عَلَىٰ حُبِّهِ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا (الإنسان:8)", tags: ["زكاة", "كسوة", "فقراء", "فقه"] },
    { id: 228, question: "ما حكم إخراج الزكاة للمجاهدين؟", answer: "المجاهدون في سبيل الله من مصارف الزكاة، ويعطون منها ما يعينهم على الجهاد ولو كانوا أغنياء.", hadith: "إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ... وَفِي سَبِيلِ اللَّهِ (التوبة:60)", tags: ["زكاة", "جهاد", "فقه", "أموال"] },
    { id: 229, question: "ما حكم إعطاء الزكاة لمن يستحقها ثم تبيّن غناه؟", answer: "إذا أعطى الزكاة لمن يظنه فقيراً فتبين غناه أو كفره أجزأته، ولا إعادة عليه لأنه عمل بظاهر الحال.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'قال رجل: لأتصدقن الليلة بصدقة، فخرج بصدقته فوضعها في يد زانية، فأصبحوا يتحدثون: تصدق على زانية، فقال: اللهم لك الحمد، لأتصدقن بصدقة، فخرج بصدقته فوضعها في يد غني، فأصبحوا يتحدثون: تصدق على غني، فقال: اللهم لك الحمد، لأتصدقن بصدقة، فخرج بصدقته فوضعها في يد سارق، فأصبحوا يتحدثون: تصدق على سارق، فأتى ربه فقال: أما صدقتك فقد قبلت، أما الزانية فلعلها تستعف بها عن زناها، وأما الغني فلعله يعتبر فينفق مما آتاه الله، وأما السارق فلعله يستعف بها عن سرقته' متفق عليه.", tags: ["زكاة", "خطأ", "فقه", "أموال"] },
    { id: 230, question: "ما حكم إعطاء الزكاة للأقارب الكفار؟", answer: "لا تجوز الزكاة للقريب الكافر، لأن الزكاة عبادة، والكافر لا يصح أن يكون مصرفاً لها، إلا المؤلفة قلوبهم.", hadith: "إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ (التوبة:60) وهم المسلمون.", tags: ["زكاة", "كافر", "فقه", "أموال"] },
    { id: 231, question: "ما حكم من حال عليه الحول ولم يخرج الزكاة؟", answer: "يجب إخراج الزكاة فوراً، والتوبة إلى الله، مع إخراج زكاة السنوات الماضية.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'ما من صاحب ذهب ولا فضة لا يؤدي حقها إلا إذا كان يوم القيامة صفحت له صفائح من نار' متفق عليه.", tags: ["زكاة", "تأخير", "فقه", "أموال"] },
    { id: 232, question: "ما حكم الصدقة على الجيران؟", answer: "الصدقة على الجيران مستحبة، ولها فضل عظيم، وتكون سبباً لدخول الجنة.", hadith: "عن عائشة قالت: قلت: يا رسول الله، إن لي جارين، فإلى أيهما أهدي؟ قال: 'إلى أقربهما منك باباً' رواه البخاري.", tags: ["صدقة", "جيران", "فقه", "أخلاق"] },
    { id: 233, question: "ما هي أحكام اللقطة؟", answer: "اللقطة مال ضائع، إن كان يسيراً فتعريفها سنة، وإن كان كثيراً وجب تعريفها حولاً، فإن جاء صاحبها وإلا فهي للملتقط كأمانة عنده.", hadith: "عن زيد بن خالد الجهني قال: سأل رجل رسول الله صلى الله عليه وسلم عن اللقطة، فقال: 'اعرف عفاصها ووكاءها، ثم عرفها سنة، فإن جاء صاحبها وإلا فشأنك بها' متفق عليه.", tags: ["لقطة", "مال", "فقه", "أموال"] },
    { id: 234, question: "ما حكم إحياء الموات؟", answer: "إحياء الموات (الأرض غير المملوكة) جائز، ومن أحيا أرضاً ميتة فهي له.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'من أحيا أرضاً ميتة فهي له' رواه الترمذي.", tags: ["موات", "أرض", "فقه", "أموال"] },
    { id: 235, question: "ما حكم شراء الأراضي البيضاء؟", answer: "شراء الأراضي البيضاء جائز، وهو من أنواع التجارة المباحة، بشرط أن تكون مملوكة شرعاً.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أراضي", "شراء", "فقه", "بيوع"] },
    { id: 236, question: "ما حكم بيع المقبرة؟", answer: "بيع المقبرة جائز إذا كانت ملكاً خاصاً، أما إذا كانت وقفاً فلا يجوز بيعها.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا تبنى المساجد على القبور، ولا تباع المقابر' رواه البيهقي.", tags: ["مقبرة", "بيع", "فقه", "جنائز"] },
    { id: 237, question: "ما حكم الشركة في المال؟", answer: "الشركة في المال جائزة وهي أنواع: شركة العنان (بالمال)، شركة الأبدان (بالعمل)، شركة المفاوضة (بالكل).", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'يد الله على الشريكين ما لم يخن أحدهما صاحبه' رواه أبو داود.", tags: ["شركة", "مال", "فقه", "بيوع"] },
    { id: 238, question: "ما حكم المضاربة؟", answer: "المضاربة جائزة، وهي دفع المال لآخر ليعمل به على جزء معلوم من الربح، والضمان على صاحب المال.", hadith: "عن العباس بن عبد المطلب قال: 'كان رسول الله صلى الله عليه وسلم يدفع المال مضاربة' رواه البيهقي.", tags: ["مضاربة", "استثمار", "فقه", "بيوع"] },
    { id: 239, question: "ما حكم المرابحة؟", answer: "المرابحة جائزة وهي بيع السلعة برأس مالها مضافاً إليه ربح معلوم، بشرط بيان رأس المال.", hadith: "عن ابن عمر قال: 'كان البيعة في عهد رسول الله صلى الله عليه وسلم على المرابحة' رواه ابن ماجه.", tags: ["مرابحة", "بيع", "فقه", "بيوع"] },
    { id: 240, question: "ما حكم شراء السيارة بالتقسيط؟", answer: "شراء السيارة بالتقسيط (البيع الآجل) جائز، بشرط أن يكون العقد من أول الأمر نقداً أو نسيئة بسعر محدد.", hadith: "عن ابن عباس قال: 'قدم رسول الله صلى الله عليه وسلم المدينة وهم يسلفون في الثمار السنة والسنتين، فقال: من أسلف في تمر فليسلف في كيل معلوم ووزن معلوم إلى أجل معلوم' متفق عليه.", tags: ["تقسيط", "سيارة", "فقه", "بيوع"] },
    { id: 241, question: "ما حكم بيع ما ليس عند الإنسان؟", answer: "بيع ما ليس عند الإنسان محرم، لأنه من بيع الغرر، وبيع المعدوم.", hadith: "عن حكيم بن حزام قال: قلت: يا رسول الله، يأتيني الرجل يريد البيع ليس عندي، أفأبتاع له من السوق؟ قال: 'لا تبع ما ليس عندك' رواه الترمذي.", tags: ["بيع", "غرر", "حرام", "بيوع"] },
    { id: 242, question: "ما حكم بيع الثمر قبل بدو صلاحه؟", answer: "بيع الثمر قبل بدو صلاحه (ظهور نضجه) محرم، لما فيه من الغرر.", hadith: "عن أنس قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الثمرة حتى تزهو' متفق عليه.", tags: ["ثمر", "بيع", "فقه", "بيوع"] },
    { id: 243, question: "ما حكم بيع العبد الآبق؟", answer: "بيع العبد الآبق محرم، لأنه غرر، والعبد غير مقدور على تسليمه.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم، والعبد الآبق من الغرر.", tags: ["عبد", "آبق", "بيع", "فقه"] },
    { id: 244, question: "ما حكم بيع اللبن في الضرع؟", answer: "بيع اللبن في الضرع محرم، لأنه غرر، واللبن غير معلوم المقدار.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع حبل الحبلة' متفق عليه، وهو من بيع الغرر.", tags: ["لبن", "ضرع", "بيع", "فقه"] },
    { id: 245, question: "ما حكم بيع السمك في الماء؟", answer: "بيع السمك في الماء محرم، لأنه غرر، والسمك غير مضمون الحصول عليه.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم.", tags: ["سمك", "ماء", "بيع", "فقه"] },
    { id: 246, question: "ما حكم بيع الحمل في بطن أمه؟", answer: "بيع الحمل في بطن أمه محرم، لأنه غرر، والحمل غير معلوم الحياة والصفة.", hadith: "عن ابن عباس قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الحمل حتى يضع' رواه الطبراني.", tags: ["حمل", "بيع", "فقه", "بيوع"] },
    { id: 247, question: "ما حكم بيع المزابنة؟", answer: "بيع المزابنة محرم، وهو بيع تمر بتمر، أو رطب بيابس، أو زبيب بعنب، على رؤوس النخل.", hadith: "عن سعد بن أبي وقاص قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع المزابنة والمحاقلة' رواه مسلم.", tags: ["مزابنة", "بيع", "حرام", "بيوع"] },
    { id: 248, question: "ما حكم بيع المحاقلة؟", answer: "بيع المحاقلة محرم، وهو بيع السنبل بالحبوب أو بيع الزرع في الأرض بالطعام.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن المزابنة والمحاقلة' متفق عليه.", tags: ["محاقلة", "بيع", "حرام", "بيوع"] },
    { id: 249, question: "ما حكم بيع الثنيا؟", answer: "بيع الثنيا (استثناء جزء من المبيع) محرم إذا كان مجهولاً، لأنه غرر، إلا إذا كان معلوماً كاستثناء حبة أو شاة.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الثنيا' رواه مالك.", tags: ["ثنيا", "بيع", "فقه", "بيوع"] },
    { id: 250, question: "ما حكم السلم (البيع الآجل)؟", answer: "السلم جائز، وهو بيع عين موصوفة في الذمة بثمن مقبوض في المجلس، إلى أجل معلوم.", hadith: "عن ابن عباس قال: 'أشهد أن السلف المضمون إلى أجل معلوم قد أحله الله في كتابه وأذن فيه' رواه الحاكم.", tags: ["سلم", "بيع", "آجل", "فقه"] },
    { id: 251, question: "ما حكم بيع الوفاء؟", answer: "بيع الوفاء محرم، وهو بيع العين مع شرط الرد بعد قضاء الدين، وهو حيلة على الربا.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل سلف وبيع' رواه الترمذي.", tags: ["بيع", "وفاء", "حرام", "بيوع"] },
    { id: 252, question: "ما حكم بيع الأمانة؟", answer: "بيع الأمانة (كشف رأس المال) جائز، وهو من أنواع البيع المشروعة، كالمرابحة والتولية.", hadith: "عن ابن عمر: 'أن رسول الله صلى الله عليه وسلم نهى عن بيع الولاء وعن هبته' متفق عليه، أما بيع الأمانة فجائز.", tags: ["أمانة", "بيع", "فقه", "بيوع"] },
    { id: 253, question: "ما حكم بيع العينة؟", answer: "بيع العينة محرم، وهو أن يبيع سلعة بثمن مؤجل ثم يشتريها بثمن أقل نقداً.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'إذا تبايعتم بالعينة، وأخذتم أذناب البقر، ورضيتم بالزرع، وتركتم الجهاد، سلط الله عليكم ذلاً لا ينزعه حتى ترجعوا إلى دينكم' رواه أبو داود.", tags: ["عينة", "بيع", "حرام", "بيوع"] },
    { id: 254, question: "ما حكم بيع التقسيط في البيوع المحرمة؟", answer: "لا يجوز بيع الخمر أو الخنزير أو الأصنام أو غيرها من المحرمات، سواء كان نقداً أو تقسيطاً.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["تقسيط", "محرمات", "بيع", "فقه"] },
    { id: 255, question: "ما حكم شراء الذهب والفضة بالتقسيط؟", answer: "لا يجوز شراء الذهب والفضة بالتقسيط، لأنه ربا النسيئة، ويجب التقابض في المجلس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب، والفضة بالفضة، والبر بالبر، والشعير بالشعير، والتمر بالتمر، والملح بالملح، مثلاً بمثل، سواءً بسواء، يداً بيد، فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["ذهب", "فضة", "تقسيط", "فقه"] },
    { id: 256, question: "ما حكم بيع الورق النقدي بالورق النقدي متفاضلاً؟", answer: "لا يجوز بيع العملات الورقية متفاضلاً (دولار بدينارين) مع التأجيل، أما يداً بيد فيجوز بالتفاضل خلافاً للراجح.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["عملات", "بيع", "ربا", "فقه"] },
    { id: 257, question: "ما حكم تأخير قبض الثمن في البيع؟", answer: "تأخير قبض الثمن إذا كان البيع نقداً محرم، لأنه بيع دين بدين، أما إذا كان البيع مؤجلاً فالثمن مؤخر بأجل معلوم.", hadith: "عن ابن عباس قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الدين بالدين' رواه البيهقي.", tags: ["ثمن", "تأخير", "بيع", "فقه"] },
    { id: 258, question: "ما حكم بيع الدين على الغير؟", answer: "بيع الدين على الغير جائز عند جمهور العلماء، وهو بيع الحق الثابت في الذمة، كبيع الشيكات والسندات.", hadith: "عن ابن عباس قال: 'من أسلم في شيء فلا يصرفه إلى غيره' رواه أبو داود، وهذا دليل على جواز بيع الحق.", tags: ["دين", "بيع", "فقه", "بيوع"] },
    { id: 259, question: "ما حكم بيع الكفيل؟", answer: "بيع الكفيل غير جائز، لأنه لا يملك العين المبيعة، والكفالة توثيق وليس تمليكاً.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل سلف وبيع، ولا شرطان في بيع، ولا ربح ما لم يضمن، ولا بيع ما ليس عندك' رواه الترمذي.", tags: ["كفيل", "بيع", "فقه", "بيوع"] },
    { id: 260, question: "ما حكم بيع الغائب؟", answer: "بيع الغائب (ما ليس تحت يد البائع) جائز إذا كان موصوفاً، بشرط أن يرى أو يوصف وصفاً يرفع الجهالة.", hadith: "عن حكيم بن حزام قال: قلت: يا رسول الله، يأتيني الرجل يريد البيع ليس عندي، أفأبتاع له من السوق؟ قال: 'لا تبع ما ليس عندك' رواه الترمذي.", tags: ["غائب", "بيع", "فقه", "بيوع"] },
    { id: 261, question: "ما حكم بيع الأعيان النجسة؟", answer: "بيع الأعيان النجسة كالخمر والخنزير والميتة محرم، وثمنها سحت، ولا يجوز الانتفاع بها.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["نجاسة", "بيع", "حرام", "فقه"] },
    { id: 262, question: "ما حكم بيع الآلات الموسيقية؟", answer: "بيع الآلات الموسيقية محرم، لأنها مما يعين على الحرام واللهو المحرم.", hadith: "عن أبي مالك الأشعري قال: قال رسول الله صلى الله عليه وسلم: 'ليكونن من أمتي أقوام يستحلون الحر والحرير والخمر والمعازف' رواه البخاري.", tags: ["موسيقى", "بيع", "حرام", "فقه"] },
    { id: 263, question: "ما حكم بيع الدم؟", answer: "بيع الدم محرم، والدم نجس، وثمنه حرام، والعلاج به للضرورة جائز بأخذه بلا ثمن.", hadith: "عن أنس قال: 'إن رسول الله صلى الله عليه وسلم قال: إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه، والدم داخل في الميتة.", tags: ["دم", "بيع", "حرام", "فقه"] },
    { id: 264, question: "ما حكم بيع الكفن؟", answer: "بيع الكفن جائز، وهو من البيوع المباحة، ولا بأس بالربح فيه، والتجارة به جائزة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275) وهذا من عموم البيع المباح.", tags: ["كفن", "بيع", "فقه", "بيوع"] },
    { id: 265, question: "ما حكم بيع الرهن؟", answer: "بيع الرهن جائز إذا حل أجل الدين ولم يوف المرتهن، ويباع الرهن بحضرة صاحبه أو بإذن القاضي.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الرهن مركوب ومحلوب' رواه أبو داود، وللمرتهن الانتفاع بالرهن بإذن الراهن، وبيعه عند الحاجة.", tags: ["رهن", "بيع", "فقه", "بيوع"] },
    { id: 266, question: "ما حكم بيع الوقف؟", answer: "بيع الوقف لا يجوز إلا في حالة واحدة: إذا تعطلت منافعه ولم يمكن إصلاحه، فيباع ويشترى بدله.", hadith: "عن عمر بن الخطاب قال: 'لا يباع أصل الوقف ولا يوهب ولا يورث' رواه البيهقي.", tags: ["وقف", "بيع", "فقه", "أموال"] },
    { id: 267, question: "ما حكم بيع مال اليتيم؟", answer: "بيع مال اليتيم جائز للحاجة والمصلحة، بشروط: أن يكون البيع لصالح اليتيم، وبإذن الولي الشرعي.", hadith: "وَلَا تَقْرَبُوا مَالَ الْيَتِيمِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ (الأنعام:152)", tags: ["يتيم", "بيع", "فقه", "أموال"] },
    { id: 268, question: "ما حكم بيع الثمار قبل بدو صلاحها؟", answer: "بيع الثمار قبل بدو صلاحها محرم، لما فيه من الغرر، والثمار غير مضمونة التمام.", hadith: "عن أنس قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الثمرة حتى تزهو' متفق عليه.", tags: ["ثمار", "بيع", "فقه", "بيوع"] },
    { id: 269, question: "ما حكم بيع العنب لمن يعصره خمراً؟", answer: "بيع العنب لمن يعصره خمراً محرم، لأنه إعانة على الإثم والعدوان.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["عنب", "خمر", "بيع", "فقه"] },
    { id: 270, question: "ما حكم بيع السلاح لأهل الفتنة؟", answer: "بيع السلاح لمن يقاتل به المسلمين أو أهل العدل محرم، وهو إعانة على الإثم.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا السلاح في الفتنة' رواه الطبراني.", tags: ["سلاح", "فتنة", "بيع", "فقه"] },
    { id: 271, question: "ما حكم النهي عن بيع الحاضر للبادي؟", answer: "بيع الحاضر للبادي محرم، وهو أن يبيع سكان الحضر لسكان البادية ليرفع السعر، ويدع البادية يبيعون بأنفسهم.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الحاضر للبادي' متفق عليه.", tags: ["حاضر", "بادي", "بيع", "فقه"] },
    { id: 272, question: "ما حكم التلقي؟", answer: "التلقي (تلقى السلع قبل وصولها للسوق) محرم، لأنه ظلم للبائع وحرمة للتجارة.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن التلقي' متفق عليه.", tags: ["تلقي", "بيع", "حرام", "فقه"] },
    { id: 273, question: "ما حكم الاحتكار؟", answer: "احتكار الطعام في وقت الحاجة محرم، وهو من كبائر الذنوب، وفيه وعيد شديد.", hadith: "عن معمر بن عبد الله قال: قال رسول الله صلى الله عليه وسلم: 'لا يحتكر إلا خاطئ' رواه مسلم.", tags: ["احتكار", "طعام", "حرام", "فقه"] },
    { id: 274, question: "ما حكم الغش في البيع؟", answer: "الغش في البيع محرم، وهو من كبائر الذنوب، وفيه غش المسلمين وخداعهم.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["غش", "بيع", "حرام", "فقه"] },
    { id: 275, question: "ما حكم التدليس في البيع؟", answer: "التدليس في البيع محرم، كإظهار السلعة بأحسن مما هي عليه، أو إخفاء عيوبها.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'المسلم أخو المسلم، ولا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["تدليس", "بيع", "حرام", "فقه"] },
    { id: 276, question: "ما حكم النجش؟", answer: "النجش محرم، وهو زيادة الثمن في السلعة بدون رغبة في الشراء، ليغري بها غيره.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن النجش' متفق عليه.", tags: ["نجش", "بيع", "حرام", "فقه"] },
    { id: 277, question: "ما حكم خيار المجلس؟", answer: "خيار المجلس ثابت للمتبايعين، لكل منهما الفسخ ما لم يتفرقا من المجلس، ولو بعد البيع.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'البيِّعان بالخيار ما لم يتفرقا، إلا بيع الخيار' متفق عليه.", tags: ["خيار", "مجلس", "بيع", "فقه"] },
    { id: 278, question: "ما حكم خيار الشرط؟", answer: "خيار الشرط جائز، وهو اشتراط أحد المتعاقدين أو كلاهما الخيار في فسخ العقد مدة معلومة، كثلاثة أيام.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'البيِّعان بالخيار ما لم يتفرقا، إلا بيع الخيار' متفق عليه.", tags: ["خيار", "شرط", "بيع", "فقه"] },
    { id: 279, question: "ما حكم خيار العيب؟", answer: "خيار العيب ثابت للمشتري إذا وجد بالسلعة عيباً لم يعلم به وقت العقد، وله الرد أو الأرش.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'المسلم أخو المسلم، ولا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["خيار", "عيب", "بيع", "فقه"] },
    { id: 280, question: "ما حكم خيار الرؤية؟", answer: "خيار الرؤية ثابت للمشتري إذا اشترى شيئاً لم يره، وله الفسخ بعد رؤيته، لأنه قد يختلف عن وصفه.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'من اشترى شيئاً لم يره فهو بالخيار إذا رآه' رواه الطبراني.", tags: ["خيار", "رؤية", "بيع", "فقه"] },
    { id: 281, question: "ما حكم خيار الغبن؟", answer: "خيار الغبن ثابت للمغبون إذا كان الغبن فاحشاً، وتوفرت فيه شروط، ويسمى خيار التدليس.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا ضرر ولا ضرار' رواه ابن ماجه، والغبن الفاحش ضرر.", tags: ["خيار", "غبن", "بيع", "فقه"] },
    { id: 282, question: "ما هو الربا؟", answer: "الربا نوعان: ربا النسيئة (تأخير البدلين)، وربا الفضل (تفاضل البدلين في الأصناف الستة: الذهب، الفضة، البر، الشعير، التمر، الملح).", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب، والفضة بالفضة، والبر بالبر، والشعير بالشعير، والتمر بالتمر، والملح بالملح، مثلاً بمثل، سواءً بسواء، يداً بيد، فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["ربا", "أنواع", "فقه", "بيوع"] },
    { id: 283, question: "ما حكم الربا في البيوع غير المنصوص عليها؟", answer: "الربا في البيوع غير المنصوص عليها يكون بالقياس على الأصناف الستة، فكل ما كان مكيلاً أو موزوناً ويدخله الربا.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الذهب بالذهب إلا مثلاً بمثل، ولا تشفوا بعضها على بعض، ولا تبيعوا الورق بالورق إلا مثلاً بمثل، ولا تشفوا بعضها على بعض، ولا تبيعوا منها غائباً بناجز' متفق عليه.", tags: ["ربا", "قياس", "فقه", "بيوع"] },
    { id: 284, question: "ما حكم الورق النقدي؟", answer: "الورق النقدي (العملات) حكمها حكم النقود، ويجري فيها الربا، فبيعها بجنسها يجب التقابض وعدم التفاضل، وبغير جنسها يجوز التفاضل مع التقابض.", hadith: "عن مالك قال: 'العملة في عهد النبي صلى الله عليه وسلم كانت الذهب والفضة، وورقنا هذا اليوم بمنزلتهما'، وهذا قياس.", tags: ["عملات", "نقود", "ربا", "فقه"] },
    { id: 285, question: "ما حكم صرف العملات؟", answer: "صرف العملات (تغيير عملة بأخرى) يجوز يداً بيد، ولا يجوز تأجيل القبض، ويجوز التفاضل إن اختلف الجنس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["صرف", "عملات", "فقه", "بيوع"] },
    { id: 286, question: "ما حكم الشيكات الآجلة؟", answer: "الشيكات الآجلة جائزة إذا كانت مدعومة برصيد حقيقي، وهي وعد بدفع مؤجل، وبيعها بالخصم (خصم الشيك) حرام.", hadith: "عن ابن عباس قال: 'من أسلم في شيء فلا يصرفه إلى غيره' رواه أبو داود، والشيك لا يصرف لآخر بخصم.", tags: ["شيكات", "آجلة", "فقه", "بيوع"] },
    { id: 287, question: "ما حكم السندات؟", answer: "السندات ذات العائد الثابت (الفائدة) محرمة لأنها قرض ربوي، وأما السندات الإسلامية (الصكوك) فجائزة إذا كانت متوافقة مع الشريعة.", hadith: "الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ (البقرة:275)", tags: ["سندات", "ربا", "فقه", "بيوع"] },
    { id: 288, question: "ما حكم التأمين التكافلي؟", answer: "التأمين التكافلي جائز، وهو نظام تعاوني قائم على التبرع والتكافل، وليس تأميناً تجارياً.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'مثل المؤمنين في توادهم وتراحمهم كمثل الجسد الواحد' متفق عليه.", tags: ["تكافل", "تأمين", "فقه", "بيوع"] },
    { id: 289, question: "ما حكم بطاقات الائتمان؟", answer: "بطاقات الائتمان جائزة إذا لم تكن بفائدة، وإذا سدد المستخدم الدين في الوقت المحدد بدون فوائد، وأما مع الفائدة فحرام.", hadith: "عن جابر قال: 'لعن رسول الله صلى الله عليه وسلم آكل الربا وموكله وكاتبه وشاهديه' رواه مسلم.", tags: ["بطاقات", "ائتمان", "فقه", "بيوع"] },
    { id: 290, question: "ما حكم القروض الحسنة؟", answer: "القرض الحسن (بدون فائدة) جائز، بل هو من أفضل القربات، وفيه أجر عظيم.", hadith: "مَّن ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً (البقرة:245)", tags: ["قرض", "حسن", "فقه", "بيوع"] },
    { id: 291, question: "ما حكم الغرر؟", answer: "الغرر (الجهالة المؤدية للنزاع) محرم في البيوع، والغرر اليسير المعتاد معفو عنه.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم.", tags: ["غرر", "بيع", "حرام", "فقه"] },
    { id: 292, question: "ما حكم بيع الثمر قبل بدو صلاحه للمعلوم؟", answer: "بيع الثمر قبل بدو صلاحه مع استثناء ما يصلح جائز، كبيع الثمر على أن للبائع الثمر غير الصالح.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الثمرة حتى يبدو صلاحها، ويأكل منه' متفق عليه.", tags: ["ثمر", "بيع", "فقه", "بيوع"] },
    { id: 293, question: "ما حكم بيع الزرع قبل اشتداد الحب؟", answer: "بيع الزرع قبل اشتداد الحب فيه تفصيل: إن كان للبقاء جاز، وإن كان للحصاد فلا يجوز حتى يبدو صلاحه.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع السنبل حتى يبيض ويأمن العاهة' رواه مسلم.", tags: ["زرع", "بيع", "فقه", "بيوع"] },
    { id: 294, question: "ما حكم بيع الأصول الثمار قبل بدو صلاحها؟", answer: "بيع الأصول (النخل والعنب) مع ثمارها قبل بدو صلاحها جائز، لأن الثمار تابعة للأصول.", hadith: "عن جابر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الثمرة حتى تشقح'، وفي رواية: 'ولا تباع النخل حتى يبدو صلاحها' متفق عليه.", tags: ["أصول", "ثمار", "بيع", "فقه"] },
    { id: 295, question: "ما حكم الاستصناع؟", answer: "الاستصناع (طلب صنع شيء بمواصفات) جائز، وهو عقد على شيء موصوف في الذمة مع تحديد الأجل والثمن.", hadith: "عن سهل بن سعد قال: 'جاءت امرأة إلى رسول الله صلى الله عليه وسلم فقالت: يا رسول الله، إني قد وهبت لك نفسي، فقامت طويلاً، فقام رجل فقال: زوجنيها إن لم تكن لك بها حاجة، فقال: هل عندك شيء تصدقها؟ قال: ما عندي إلا إزاري هذا، قال: إن أعطيتها إياه جلست ولا إزار لك، قال: فأمره النبي صلى الله عليه وسلم أن يعلمها سوراً من القرآن' متفق عليه، وهذا استصناع للتعليم.", tags: ["استصناع", "عقد", "فقه", "بيوع"] },
    { id: 296, question: "ما حكم الجعالة؟", answer: "الجعالة جائزة، وهي عقد على عمل مجهول بجعل معلوم، كمن يقول: من رد ضالتي فله كذا.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من وجد جملة ضالاً فليعرّفه، فإن جاء صاحبه وإلا فليأكله' متفق عليه، وللآخذ الجعالة.", tags: ["جعالة", "عقد", "فقه", "بيوع"] },
    { id: 297, question: "ما حكم الإجارة؟", answer: "الإجارة (استئجار) جائزة، وهي عقد على منفعة معلومة بأجر معلوم، كاستئجار الدار والسيارة.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'أجر الأجير قبل أن يجف عرقه' رواه ابن ماجه.", tags: ["إجارة", "استئجار", "فقه", "بيوع"] },
    { id: 298, question: "ما حكم إجارة الأجير المشترك؟", answer: "إجارة الأجير المشترك (الذي يعمل لعدة أشخاص) جائزة، ولا يجوز له الانصراف إلى غيره إلا بإذن.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'أعطوا الأجير أجره قبل أن يجف عرقه' رواه ابن ماجه.", tags: ["إجارة", "أجير", "فقه", "بيوع"] },
    { id: 299, question: "ما حكم إجارة الأرض البيضاء؟", answer: "إجارة الأرض البيضاء جائزة لزراعتها أو بنائها، بشرط تحديد الأجرة والمدة والغرض.", hadith: "عن ابن عمر قال: 'أعطى رسول الله صلى الله عليه وسلم خيبر بشطر ما يخرج منها من زرع أو ثمر' متفق عليه.", tags: ["إجارة", "أرض", "فقه", "بيوع"] },
    { id: 300, question: "ما حكم إجارة الحيوان للحمل؟", answer: "إجارة الحيوان للحمل جائزة، بشرط تحديد الحمولة والمسافة والأجرة، وعدم تحميله ما لا يطيق.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا ضرر ولا ضرار' رواه ابن ماجه، وتحميل الحيوان ما لا يطيق ضرر.", tags: ["إجارة", "حيوان", "فقه", "بيوع"] },
    { id: 301, question: "ما حكم إجارة الدواب للحرب؟", answer: "إجارة الدواب للحرب جائزة للجهاد في سبيل الله، وهي من القربات.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'من اغبرت قدماه في سبيل الله حرمه الله على النار' رواه البخاري.", tags: ["إجارة", "دواب", "جهاد", "فقه"] },
    { id: 302, question: "ما حكم إجارة السفن؟", answer: "إجارة السفن جائزة لنقل البضائع والركاب، بشرط تحديد الحمولة والأجرة والمدة.", hadith: "عن ابن عمر قال: 'كان النبي صلى الله عليه وسلم يكري سفنه' رواه الطبراني.", tags: ["إجارة", "سفن", "فقه", "بيوع"] },
    { id: 303, question: "ما حكم إجارة العبيد؟", answer: "إجارة العبيد جائزة للعمل، ومال الإجارة للسيد، والأجير العبد لا يملك أجره.", hadith: "عن ابن عمر قال: 'أذن رسول الله صلى الله عليه وسلم في إجارة العبيد' رواه البيهقي.", tags: ["إجارة", "عبيد", "فقه", "بيوع"] },
    { id: 304, question: "ما حكم إجارة الطبيب؟", answer: "إجارة الطبيب جائزة للعلاج، ويعتبر من عقد الإجارة، ويتقاضى أجراً على عمله.", hadith: "عن رفاعة بن رافع قال: قال رسول الله صلى الله عليه وسلم: 'إن أفضل الكسب كسب يد العامل إذا نصح' رواه أحمد، والطبيب من العاملين.", tags: ["إجارة", "طبيب", "فقه", "بيوع"] },
    { id: 305, question: "ما حكم إجارة المعلم؟", answer: "إجارة المعلم جائزة، وتعليم القرآن والعلوم النافعة من أفضل الأعمال، ويجوز أخذ الأجر عليه.", hadith: "عن عبادة بن الصامت قال: علمت ناساً من أهل الصفة القرآن، فأهدى إلي رجل قوساً، فذكرت للنبي صلى الله عليه وسلم فقال: 'إن سرك أن تطوق بها طوقاً من نار فاقبلها' رواه أبو داود، وهذا في أجر تعليم القرآن، والأرجح الجواز مع الكراهة.", tags: ["إجارة", "معلم", "فقه", "بيوع"] },
    { id: 306, question: "ما حكم إجارة البيت؟", answer: "إجارة البيت جائزة، وهي من المعاملات المشروعة، مع تحديد المدة والأجرة.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا تكر المزارع، وأكر الدور' رواه ابن ماجه.", tags: ["إجارة", "بيت", "فقه", "بيوع"] },
    { id: 307, question: "ما حكم إجارة العامل المشترك؟", answer: "إجارة العامل المشترك (الذي يعمل لعدة جهات) جائزة، بشرط ألا يتعارض عمله مع مصلحة صاحب العمل.", hadith: "عن ابن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'من كان له أجير فليعلمه أجره' رواه الطبراني.", tags: ["إجارة", "عامل", "فقه", "بيوع"] },
    { id: 308, question: "ما حكم الرهن في الإجارة؟", answer: "الرهن في الإجارة جائز لتوثيق الحق، كأن يرهن المستأجر شيئاً لصاحب العين المستأجرة.", hadith: "وَإِن كُنتُمْ عَلَىٰ سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَّقْبُوضَةٌ (البقرة:283)", tags: ["رهن", "إجارة", "فقه", "بيوع"] },
    { id: 309, question: "ما حكم عقد السلم؟", answer: "السلم جائز، وهو بيع عين موصوفة في الذمة بثمن مقبوض في المجلس إلى أجل معلوم، كشراء طن قمح يسلم بعد شهر.", hadith: "عن ابن عباس قال: 'أشهد أن السلف المضمون إلى أجل معلوم قد أحله الله في كتابه وأذن فيه' رواه الحاكم.", tags: ["سلم", "عقد", "فقه", "بيوع"] },
    { id: 310, question: "ما هي أركان السلم؟", answer: "أركان السلم: المسلم (المشتري)، المسلم إليه (البائع)، رأس المال (الثمن)، المُسلم فيه (السلعة)، الصيغة، الأجل.", hadith: "عن ابن عباس قال: 'من أسلم في شيء فلا يصرفه إلى غيره' رواه أبو داود.", tags: ["سلم", "أركان", "فقه", "بيوع"] },
    { id: 311, question: "ما حكم السلم في الحيوان؟", answer: "السلم في الحيوان جائز، بشرط وصفه وصفاً يرفع الجهالة، كأن يقول: أشتري منك جملاً بمواصفات كذا وكذا.", hadith: "عن ابن عباس قال: 'لا بأس بالسلف في الحيوان' رواه البيهقي.", tags: ["سلم", "حيوان", "فقه", "بيوع"] },
    { id: 312, question: "ما حكم بيع الخيار؟", answer: "بيع الخيار (وهو حب الخيار) جائز، لأنه من الخضروات المباحة، والتجارة فيه حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["خيار", "بيع", "فقه", "بيوع"] },
    { id: 313, question: "ما حكم بيع الثلج؟", answer: "بيع الثلج جائز، وهو من المباحات، والتجارة فيه حلال، إذا كان مصدره ماء طاهراً.", hadith: "عن عائشة قالت: قال رسول الله صلى الله عليه وسلم: 'الماء من الماء' رواه مسلم، والماء طهور.", tags: ["ثلج", "بيع", "فقه", "بيوع"] },
    { id: 314, question: "ما حكم بيع الماء؟", answer: "بيع الماء جائز إذا كان في أوعية، أو من آبار مملوكة، أما الماء المباح كالأنهار فلا يباع.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا تمنعوا فضل الماء لتمنعوا به فضل الكلأ' رواه البخاري.", tags: ["ماء", "بيع", "فقه", "بيوع"] },
    { id: 315, question: "ما حكم بيع الكتب الدينية؟", answer: "بيع الكتب الدينية جائز، وهو من التجارة المباحة، مع الكراهة في بيع المصحف بثمن مرتفع.", hadith: "عن عبد الله بن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'من باع مصحفاً فليتصدق بثمنه' رواه الدارقطني، والراجح الجواز مع الكراهة.", tags: ["كتب", "دينية", "بيع", "فقه"] },
    { id: 316, question: "ما حكم بيع السجائر؟", answer: "بيع السجائر محرم، لأنها محرمة الاستعمال، وثمنها سحت، والإعانة على الإثم محرمة.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["سجائر", "بيع", "حرام", "فقه"] },
    { id: 317, question: "ما حكم بيع المناشف المزينة بصور ذوات الأرواح؟", answer: "بيع المناشف المزينة بصور ذوات الأرواح محرم، لأنها مما حرم استعمالها، والبيع إعانة على الحرام.", hadith: "عن عائشة قالت: 'قدم رسول الله صلى الله عليه وسلم من سفر وقد سترت على بابي درنوكاً فيه الخيل ذوات الأجنحة، فأمرني فنزعته' متفق عليه.", tags: ["صور", "مناشف", "بيع", "فقه"] },
    { id: 318, question: "ما حكم بيع الأجهزة التي تستقبل القنوات الفضائية المحرمة؟", answer: "بيع الأجهزة التي تستقبل القنوات المحرمة مع العلم بأنها تستعمل في الحرام محرم، أما بيعها بشرط عدم استعمالها في الحرام فجائز.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه، وكل ما أعين على الحرام.", tags: ["أجهزة", "فضائيات", "بيع", "فقه"] },
    { id: 319, question: "ما حكم بيع أجهزة التصوير؟", answer: "بيع أجهزة التصوير جائز إذا كانت تستعمل في المباح، كالتصوير للتعريف والتعليم، أما إذا كانت للتصوير المحرم فحرام.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه، والبيع إعانة على الحرام.", tags: ["تصوير", "أجهزة", "بيع", "فقه"] },
    { id: 320, question: "ما حكم بيع الآلات الحربية للأعداء؟", answer: "بيع الآلات الحربية للأعداء الذين يحاربون المسلمين محرم، لأنه إعانة على الإثم والعدوان.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا السلاح في الفتنة' رواه الطبراني.", tags: ["آلات", "حربية", "بيع", "فقه"] },
    { id: 321, question: "ما حكم بيع المصحف للكافر؟", answer: "بيع المصحف للكافر جائز إذا رجي إسلامه أو ليدرسه باحترام، أما إذا كان يستهين به فلا يجوز.", hadith: "عن ابن عباس قال: 'لا تبيعوا المصحف على المشركين إلا أن ترجوا إسلامهم' رواه الطبراني.", tags: ["مصحف", "كافر", "بيع", "فقه"] },
    { id: 322, question: "ما حكم بيع ما يستحيل إلى خمر؟", answer: "بيع ما يستحيل إلى خمر كالعنب لمن يعصره خمراً محرم، لأنه إعانة على الإثم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["خمر", "بيع", "فقه", "بيوع"] },
    { id: 323, question: "ما حكم بيع السماد؟", answer: "بيع السماد جائز، وهو من المواد المباحة التي تنتفع بها الأراضي الزراعية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سماد", "بيع", "فقه", "بيوع"] },
    { id: 324, question: "ما حكم بيع النفط؟", answer: "بيع النفط جائز، وهو من الموارد الطبيعية المباحة، والتجارة فيه حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["نفط", "بيع", "فقه", "بيوع"] },
    { id: 325, question: "ما حكم بيع الكهرباء؟", answer: "بيع الكهرباء جائز، وهي سلعة منفعة، ويجوز التعاقد على بيعها بشرط تحديد الكمية والثمن.", hadith: "عن ابن عباس قال: 'لا بأس ببيع الماء والنار' رواه البيهقي، والكهرباء من جنس الماء والنار من حيث المنفعة.", tags: ["كهرباء", "بيع", "فقه", "بيوع"] },
    { id: 326, question: "ما حكم بيع الغاز؟", answer: "بيع الغاز جائز، وهو من المواد المباحة، ويجوز التعاقد عليه كغيره من السلع.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["غاز", "بيع", "فقه", "بيوع"] },
    { id: 327, question: "ما حكم بيع قطع الغيار المسروقة؟", answer: "بيع قطع الغيار المسروقة محرم، لأنه بيع مال الغير بغير إذنه، وهو من أكل المال بالباطل.", hadith: "يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا أَمْوَالَكُم بَيْنَكُم بِالْبَاطِلِ (النساء:29)", tags: ["غيار", "مسروق", "بيع", "فقه"] },
    { id: 328, question: "ما حكم بيع الأجهزة المستعملة؟", answer: "بيع الأجهزة المستعملة جائز، بشرط بيان عيوبها للمشتري، وعدم الغش والتدليس.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'المسلم أخو المسلم، ولا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["مستعملة", "أجهزة", "بيع", "فقه"] },
    { id: 329, question: "ما حكم بيع السلعة المرهونة؟", answer: "لا يجوز بيع السلعة المرهونة إلا بإذن الراهن (صاحب السلعة)، أو بعد حلول الأجل دون سداد.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الرهن مركوب ومحلوب' رواه أبو داود، والبيع لا يجوز بغير إذن.", tags: ["مرهونة", "سلعة", "بيع", "فقه"] },
    { id: 330, question: "ما حكم بيع العينة المصرفي؟", answer: "بيع العينة المصرفي محرم، وهو أن يشتري البنك سلعة من شخص بثمن مؤجل ثم يبيعها له بثمن أقل نقداً.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'إذا تبايعتم بالعينة... فانتظروا الساعة' رواه أبو داود.", tags: ["عينة", "مصرفي", "بيع", "فقه"] },
    { id: 331, question: "ما حكم المرابحة للآمر بالشراء؟", answer: "المرابحة للآمر بالشراء (فى البنوك الإسلامية) جائزة إذا تمت بشروطها: أن يشتري البنك السلعة ثم يبيعها بمرابحة.", hadith: "عن ابن عمر قال: 'كان البيعة في عهد رسول الله صلى الله عليه وسلم على المرابحة' رواه ابن ماجه.", tags: ["مرابحة", "آمر", "بيع", "فقه"] },
    { id: 332, question: "ما حكم الإجارة المنتهية بالتمليك؟", answer: "الإجارة المنتهية بالتمليك جائزة بشروط، وتسمى الإجارة ثم البيع، ويكون العقدان منفصلين.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'أوفوا بالعقود' رواه البخاري.", tags: ["إجارة", "تمليك", "فقه", "بيوع"] },
    { id: 333, question: "ما حكم الصكوك الإسلامية؟", answer: "الصكوك الإسلامية جائزة إذا كانت متوافقة مع الشريعة، وهي بديلة عن السندات الربوية، وتقوم على أصول حقيقية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["صكوك", "إسلامية", "فقه", "بيوع"] },
    { id: 334, question: "ما حكم الاستثمار في صناديق المؤشرات؟", answer: "الاستثمار في صناديق المؤشرات جائز إذا كانت مكونات الصندوق من أسهم شركات مباحة، وألا تتعامل بالربا.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["استثمار", "صناديق", "فقه", "بيوع"] },
    { id: 335, question: "ما حكم شراء الذهب والفضة بالتقسيط البنكي؟", answer: "شراء الذهب والفضة بالتقسيط البنكي حرام، لأنه ربا النسيئة، ويجب التقابض في مجلس العقد.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["ذهب", "فضة", "تقسيط", "فقه"] },
    { id: 336, question: "ما حكم بيع الحلي المصنوعة من الذهب المستعمل؟", answer: "بيع الحلي المصنوعة من الذهب المستعمل جائز، ولو كان ثمناً أكثر من قيمته الذاتية (أجرة الصنعة) مع التقابض في المجلس.", hadith: "عن فضالة بن عبيد قال: 'أتي رسول الله صلى الله عليه وسلم بقلادة فيها خرز وذهب، تباع باثني عشر ديناراً، فقطعها وجعل الذهب لوحده والخرز لوحده' رواه أبو داود.", tags: ["حلي", "ذهب", "بيع", "فقه"] },
    { id: 337, question: "ما حكم بيع الذهب بالذهب مع أجرة الصنعة؟", answer: "بيع الذهب بالذهب مع أجرة الصنعة لا يجوز إلا مع المفاضلة يداً بيد، والزيادة لا تجوز لأنه ربا الفضل.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الذهب بالذهب إلا مثلاً بمثل، ولا تشفوا بعضها على بعض' متفق عليه.", tags: ["ذهب", "صنعة", "بيع", "فقه"] },
    { id: 338, question: "ما حكم بيع الفضة بالفضة متفاضلاً؟", answer: "بيع الفضة بالفضة متفاضلاً حرام، لأنه ربا الفضل، ويجب التساوي مع التقابض في المجلس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الفضة بالفضة مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["فضة", "بيع", "ربا", "فقه"] },
    { id: 339, question: "ما حكم بيع البر بالبر متفاضلاً؟", answer: "بيع البر (القمح) بالبر متفاضلاً حرام، لأنه من الأصناف الستة، ويجب التماثل والتقابض.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["بر", "قمح", "بيع", "فقه"] },
    { id: 340, question: "ما حكم بيع الشعير بالشعير متفاضلاً؟", answer: "بيع الشعير بالشعير متفاضلاً حرام، لأنه من الأصناف الستة، ويجب التماثل والتقابض.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الشعير بالشعير مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["شعير", "بيع", "ربا", "فقه"] },
    { id: 341, question: "ما حكم بيع التمر بالتمر متفاضلاً؟", answer: "بيع التمر بالتمر متفاضلاً حرام، لأنه من الأصناف الستة، ويجب التماثل والتقابض.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'التمر بالتمر مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["تمر", "بيع", "ربا", "فقه"] },
    { id: 342, question: "ما حكم بيع الملح بالملح متفاضلاً؟", answer: "بيع الملح بالملح متفاضلاً حرام، لأنه من الأصناف الستة، ويجب التماثل والتقابض.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الملح بالملح مثلاً بمثل، سواءً بسواء، يداً بيد' رواه مسلم.", tags: ["ملح", "بيع", "ربا", "فقه"] },
    { id: 343, question: "ما حكم بيع اللحم باللحم متفاضلاً؟", answer: "بيع اللحم باللحم متفاضلاً جائز، لأنه ليس من الأصناف الستة ولا مكيلاً ولا موزوناً في العادة.", hadith: "عن ابن عباس قال: 'لا بأس بلحم بلحم يداً بيد، وإن كان متفاضلاً' رواه البيهقي.", tags: ["لحم", "بيع", "فقه", "بيوع"] },
    { id: 344, question: "ما حكم بيع الخبز بالخبز متفاضلاً؟", answer: "بيع الخبز بالخبز متفاضلاً جائز، لأنه ليس من الأصناف الستة، ويدخله الصنعة.", hadith: "عن ابن عباس قال: 'لا بأس بطعام بطعام يداً بيد، وإن كان متفاضلاً' رواه البيهقي.", tags: ["خبز", "بيع", "فقه", "بيوع"] },
    { id: 345, question: "ما حكم بيع الزيت بالزيت متفاضلاً؟", answer: "بيع الزيت بالزيت متفاضلاً حرام إن كان مكيلاً متحداً في الجودة، وإن اختلف الجنس جاز التفاضل.", hadith: "عن أبي سعيد الخدري قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الزيت بالزيت متفاضلاً' رواه البيهقي.", tags: ["زيت", "بيع", "فقه", "بيوع"] },
    { id: 346, question: "ما حكم بيع اللبن باللبن متفاضلاً؟", answer: "بيع اللبن باللبن متفاضلاً جائز على الراجح، لأنه ليس مما يدخله الربا، والخلاف فيه ضعيف.", hadith: "عن ابن عباس قال: 'لا بأس باللبن باللبن يدا بيد، وإن كان متفاضلاً' رواه الطبراني.", tags: ["لبن", "بيع", "فقه", "بيوع"] },
    { id: 347, question: "ما حكم بيع البيض بالبيض متفاضلاً؟", answer: "بيع البيض بالبيض متفاضلاً جائز، لأنه ليس مما يدخله الربا، والخلاف فيه مرجوح.", hadith: "عن ابن عمر قال: 'لا بأس بالبيض بالبيض، وإن كان متفاضلاً' رواه البيهقي.", tags: ["بيض", "بيع", "فقه", "بيوع"] },
    { id: 348, question: "ما حكم بيع الخضراوات بالخضراوات متفاضلاً؟", answer: "بيع الخضراوات بالخضراوات متفاضلاً جائز، لأنها ليست مكيلة ولا موزونة في العادة، وليست من الأصناف الستة.", hadith: "عن ابن عباس قال: 'لا بأس بالخبز بالخبز، واللحم باللحم، والبطيخ بالبطيخ، يداً بيد، وإن كان متفاضلاً' رواه الطبراني.", tags: ["خضراوات", "بيع", "فقه", "بيوع"] },
    { id: 349, question: "ما حكم بيع السكر بالسكر متفاضلاً؟", answer: "بيع السكر بالسكر متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا البر بالبر إلا مثلاً بمثل' متفق عليه، والسكر مقيس عليه.", tags: ["سكر", "بيع", "فقه", "بيوع"] },
    { id: 350, question: "ما حكم بيع الأرز بالأرز متفاضلاً؟", answer: "بيع الأرز بالأرز متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل' رواه مسلم، والأرز مقيس عليه.", tags: ["أرز", "بيع", "فقه", "بيوع"] },
    { id: 351, question: "ما حكم بيع العدس بالعدس متفاضلاً؟", answer: "بيع العدس بالعدس متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل' رواه مسلم، والعدس من جنس البر.", tags: ["عدس", "بيع", "فقه", "بيوع"] },
    { id: 352, question: "ما حكم بيع الحمص بالحمص متفاضلاً؟", answer: "بيع الحمص بالحمص متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل' رواه مسلم، والحمص من الحبوب المكيلة.", tags: ["حمص", "بيع", "فقه", "بيوع"] },
    { id: 353, question: "ما حكم بيع الفول بالفول متفاضلاً؟", answer: "بيع الفول بالفول متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل' رواه مسلم، والفول من الحبوب.", tags: ["فول", "بيع", "فقه", "بيوع"] },
    { id: 354, question: "ما حكم بيع الذرة بالذرة متفاضلاً؟", answer: "بيع الذرة بالذرة متفاضلاً حرام، لأنه مكيل ويدخله الربا قياساً على البر.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'البر بالبر مثلاً بمثل' رواه مسلم، والذرة من الحبوب.", tags: ["ذرة", "بيع", "فقه", "بيوع"] },
    { id: 355, question: "ما حكم بيع الدقيق بالدقيق متفاضلاً؟", answer: "بيع الدقيق بالدقيق متفاضلاً حرام، لأنه من جنس الحبوب ويدخله الصنعة، والراجح التحريم.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الطعام بالطعام متفاضلاً' رواه الطبراني.", tags: ["دقيق", "بيع", "فقه", "بيوع"] },
    { id: 356, question: "ما حكم بيع العسل بالعسل متفاضلاً؟", answer: "بيع العسل بالعسل متفاضلاً حرام على الراجح، لأنه مكيل ويدخله الربا.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع العسل بالعسل متفاضلاً' رواه البيهقي.", tags: ["عسل", "بيع", "فقه", "بيوع"] },
    { id: 357, question: "ما حكم بيع الخل بالخل متفاضلاً؟", answer: "بيع الخل بالخل متفاضلاً جائز، لأنه ليس مما يدخله الربا، والخل من التوابل.", hadith: "عن ابن عباس قال: 'لا بأس بالخل بالخل يداً بيد، وإن كان متفاضلاً' رواه الطبراني.", tags: ["خل", "بيع", "فقه", "بيوع"] },
    { id: 358, question: "ما حكم بيع الزبيب بالزبيب متفاضلاً؟", answer: "بيع الزبيب بالزبيب متفاضلاً حرام، لأنه من جنس التمر في كونه مكيلاً وفيه الربا.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الزبيب بالزبيب متفاضلاً' رواه البيهقي.", tags: ["زبيب", "بيع", "فقه", "بيوع"] },
    { id: 359, question: "ما حكم بيع التين بالتين متفاضلاً؟", answer: "بيع التين بالتين متفاضلاً جائز على الراجح، لأنه ليس مما يدخله الربا، والخلاف فيه مرجوح.", hadith: "عن ابن عباس قال: 'لا بأس بالتين بالتين، وإن كان متفاضلاً' رواه الطبراني.", tags: ["تين", "بيع", "فقه", "بيوع"] },
    { id: 360, question: "ما حكم بيع الرطب بالتمر متفاضلاً؟", answer: "بيع الرطب بالتمر متفاضلاً جائز، لأن الرطب فاكهة والتمر فاكهة مجففة، والتفاضل جائز مع التقابض.", hadith: "عن سعد بن أبي وقاص قال: سمعت رسول الله صلى الله عليه وسلم يسأل عن شراء الرطب بالتمر، فقال: 'أينقص الرطب إذا يبس؟' قالوا: نعم، فنهى عن ذلك' رواه أبو داود، والنهي محمول على الكراهة عند الجمهور.", tags: ["رطب", "تمر", "بيع", "فقه"] },
    { id: 361, question: "ما حكم بيع العنب بالزبيب متفاضلاً؟", answer: "بيع العنب بالزبيب متفاضلاً جائز على الراجح، لأن العنب فاكهة طازجة والزبيب مجفف.", hadith: "عن ابن عباس قال: 'لا بأس بالعنب بالزبيب يدا بيد، وإن كان متفاضلاً' رواه الطبراني.", tags: ["عنب", "زبيب", "بيع", "فقه"] },
    { id: 362, question: "ما حكم بيع الرطب بالعنب متفاضلاً؟", answer: "بيع الرطب بالعنب متفاضلاً جائز، لأنهما مختلفان في الجنس، والتفاضل جائز مع التقابض.", hadith: "عن ابن عباس قال: 'لا بأس بالرطب بالعنب يدا بيد، وإن كان متفاضلاً' رواه الطبراني.", tags: ["رطب", "عنب", "بيع", "فقه"] },
    { id: 363, question: "ما حكم بيع الشعير بالبر متفاضلاً؟", answer: "بيع الشعير بالبر متفاضلاً جائز مع التقابض، لأنهما مختلفان في الجنس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["شعير", "بر", "بيع", "فقه"] },
    { id: 364, question: "ما حكم بيع الذهب بالفضة متفاضلاً؟", answer: "بيع الذهب بالفضة متفاضلاً جائز مع التقابض في المجلس، لأنهما مختلفان في الجنس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["ذهب", "فضة", "بيع", "فقه"] },
    { id: 365, question: "ما حكم بيع الذهب بالورق النقدي متفاضلاً؟", answer: "بيع الذهب بالورق النقدي متفاضلاً جائز مع التقابض في المجلس، لأنهما مختلفان في الجنس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["ذهب", "نقد", "بيع", "فقه"] },
    { id: 366, question: "ما حكم بيع الفضة بالورق النقدي متفاضلاً؟", answer: "بيع الفضة بالورق النقدي متفاضلاً جائز مع التقابض في المجلس، لأنهما مختلفان في الجنس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["فضة", "نقد", "بيع", "فقه"] },
    { id: 367, question: "ما حكم بيع الذهب بالذهب مع تأخير القبض؟", answer: "بيع الذهب بالذهب مع تأخير القبض حرام، لأنه ربا النسيئة، ويجب التقابض في المجلس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... يداً بيد' رواه مسلم.", tags: ["ذهب", "تأخير", "ربا", "فقه"] },
    { id: 368, question: "ما حكم بيع العملات بجنسها مع تأخير القبض؟", answer: "بيع العملات بجنسها مع تأخير القبض حرام، لأنه ربا النسيئة، ويجب التقابض في المجلس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... يداً بيد' رواه مسلم، والعملات حكمها حكم الذهب والفضة.", tags: ["عملات", "تأخير", "ربا", "فقه"] },
    { id: 369, question: "ما حكم بيع العملات بغير جنسها مع تأخير القبض؟", answer: "بيع العملات بغير جنسها مع تأخير القبض حرام، لأنه ربا النسيئة، ويجب التقابض في المجلس.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'فإذا اختلفت هذه الأصناف فبيعوا كيف شئتم إذا كان يداً بيد' رواه مسلم.", tags: ["عملات", "تأخير", "ربا", "فقه"] },
    { id: 370, question: "ما حكم بيع العسل بالعسل مع تأخير القبض؟", answer: "بيع العسل بالعسل مع تأخير القبض حرام على الراجح، لأنه يدخله الربا، ويجب التقابض.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع العسل بالعسل متفاضلاً، وعن بيع العسل بالعسل نسيئة' رواه البيهقي.", tags: ["عسل", "تأخير", "فقه", "بيوع"] },
    { id: 371, question: "ما حكم بيع الدراهم بالدنانير متفاضلاً؟", answer: "بيع الدراهم (الفضة) بالدنانير (الذهب) متفاضلاً جائز مع التقابض في المجلس، لأنهما مختلفان.", hadith: "عن مالك بن أوس قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الدينار بالدينارين، ولا الدرهم بالدرهمين' رواه مسلم، وهذا في صرف الجنس الواحد.", tags: ["دراهم", "دنانير", "بيع", "فقه"] },
    { id: 372, question: "ما حكم بيع الذهب بالذهب مع أجرة الصياغة؟", answer: "بيع الذهب بالذهب مع أجرة الصياغة لا يجوز إلا مع المساواة في الوزن، وأجرة الصنعة تعتبر هبة أو تبرعاً.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الذهب بالذهب إلا مثلاً بمثل، ولا تشفوا بعضها على بعض' متفق عليه.", tags: ["ذهب", "صياغة", "بيع", "فقه"] },
    { id: 373, question: "ما حكم بيع الذهب المكسور بالذهب المصوغ؟", answer: "بيع الذهب المكسور (السبيكة) بالذهب المصوغ (المصنع) لا يجوز إلا مع المساواة في الوزن، والتفاضل حرام.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الذهب بالذهب إلا مثلاً بمثل' متفق عليه.", tags: ["ذهب", "مكسور", "مصوغ", "فقه"] },
    { id: 374, question: "ما حكم بيع الملابس الجديدة بالملابس المستعملة؟", answer: "بيع الملابس الجديدة بالملابس المستعملة جائز، مع مراعاة التفاضل بالسعر، وليس فيها ربا.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ملابس", "بيع", "فقه", "بيوع"] },
    { id: 375, question: "ما حكم بيع السيارة الجديدة بالسيارة المستعملة؟", answer: "بيع السيارة الجديدة بالسيارة المستعملة جائز، مع التفاضل في السعر، وهو من البيوع الجائزة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سيارة", "بيع", "فقه", "بيوع"] },
    { id: 376, question: "ما حكم بيع السيارات بالتقسيط مع زيادة الثمن؟", answer: "بيع السيارات بالتقسيط مع زيادة الثمن جائز، لأنه بيع آجل، والزيادة مقابل الأجل، وليست ربا.", hadith: "عن ابن عباس قال: 'لا بأس بالنسيئة، والزيادة في الثمن مقابل الأجل' رواه البيهقي.", tags: ["سيارات", "تقسيط", "بيع", "فقه"] },
    { id: 377, question: "ما حكم بيع المنازل بالتقسيط؟", answer: "بيع المنازل بالتقسيط جائز، مع زيادة الثمن مقابل الأجل، وهو من البيوع المشروعة.", hadith: "عن ابن عباس قال: 'لا بأس بالنسيئة' رواه البيهقي.", tags: ["منازل", "تقسيط", "بيع", "فقه"] },
    { id: 378, question: "ما حكم بيع الأرض بالتقسيط؟", answer: "بيع الأرض بالتقسيط جائز، مع زيادة الثمن مقابل الأجل، بشرط أن يكون العقد صحيحاً خالياً من الربا.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من ابتاع طعاماً فلا يبعه حتى يستوفيه' رواه مسلم، والبيع بالتقسيط جائز.", tags: ["أرض", "تقسيط", "بيع", "فقه"] },
    { id: 379, question: "ما حكم بيع الثلاجة بالتقسيط؟", answer: "بيع الثلاجة بالتقسيط جائز، مع زيادة الثمن مقابل الأجل، وهو من البيوع المشروعة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ثلاجة", "تقسيط", "بيع", "فقه"] },
    { id: 380, question: "ما حكم بيع الأجهزة الإلكترونية بالتقسيط؟", answer: "بيع الأجهزة الإلكترونية بالتقسيط جائز، مع زيادة الثمن مقابل الأجل، بشرط ألا يكون فيها محرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تقسيط", "بيع", "فقه"] },
    { id: 381, question: "ما حكم شراء السلعة بالتقسيط ثم بيعها بنقد؟", answer: "شراء السلعة بالتقسيط ثم بيعها بنقد جائز، بشرط أن يقبضها أولاً ثم يبيعها، ولا يكون قد اشترط البيع من أول الأمر.", hadith: "عن حكيم بن حزام قال: قلت: يا رسول الله، إني أبتاع البيعة، فما يحل لي منها وما يحرم؟ قال: 'لا تبع ما ليس عندك' رواه الترمذي.", tags: ["تقسيط", "بيع", "فقه", "بيوع"] },
    { id: 382, question: "ما حكم السلم الموازي؟", answer: "السلم الموازي (بيع السلم قبل قبضه) لا يجوز، لأنه بيع ما ليس عندك، وهو من بيع الغرر.", hadith: "عن حكيم بن حزام قال: قال رسول الله صلى الله عليه وسلم: 'لا تبع ما ليس عندك' رواه الترمذي.", tags: ["سلم", "موازي", "بيع", "فقه"] },
    { id: 383, question: "ما حكم تورق المصرفي؟", answer: "تورق المصرفي (التورق المنظم) فيه خلاف، والراجح أنه لا يجوز لما فيه من حيلة على الربا.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'إذا تبايعتم بالعينة... فانتظروا الساعة' رواه أبو داود.", tags: ["تورق", "مصرفي", "فقه", "بيوع"] },
    { id: 384, question: "ما حكم الإيجار المنتهي بالتمليك في البنوك الإسلامية؟", answer: "الإيجار المنتهي بالتمليك في البنوك الإسلامية جائز إذا كان العقدان منفصلين: عقد إجارة ثم عقد بيع.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'أوفوا بالعقود' رواه البخاري.", tags: ["إيجار", "تمليك", "فقه", "بيوع"] },
    { id: 385, question: "ما حكم المرابحة في البنوك الإسلامية؟", answer: "المرابحة في البنوك الإسلامية جائزة بشروطها: أن يشتري البنك السلعة أولاً ثم يبيعها بمرابحة معلومة.", hadith: "عن ابن عمر قال: 'كان البيعة في عهد رسول الله صلى الله عليه وسلم على المرابحة' رواه ابن ماجه.", tags: ["مرابحة", "بنوك", "فقه", "بيوع"] },
    { id: 386, question: "ما حكم المشاركة المتناقصة في البنوك الإسلامية؟", answer: "المشاركة المتناقصة جائزة، وهي أن يشارك البنك العميل في شراء عقار، ثم يشتري العميل حصة البنك تدريجياً.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["مشاركة", "متناقصة", "فقه", "بيوع"] },
    { id: 387, question: "ما حكم المضاربة في البنوك الإسلامية؟", answer: "المضاربة في البنوك الإسلامية جائزة، وهي أن يقدم البنك المال للعميل ليعمل به على جزء من الربح.", hadith: "عن العباس بن عبد المطلب قال: 'كان رسول الله صلى الله عليه وسلم يدفع المال مضاربة' رواه البيهقي.", tags: ["مضاربة", "بنوك", "فقه", "بيوع"] },
    { id: 388, question: "ما حكم صكوك الاستثمار؟", answer: "صكوك الاستثمار جائزة إذا كانت متوافقة مع الشريعة، وتقوم على أصول حقيقية، وليست ديوناً.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["صكوك", "استثمار", "فقه", "بيوع"] },
    { id: 389, question: "ما حكم السندات الحكومية؟", answer: "السندات الحكومية التقليدية (ذات الفائدة) محرمة، لأنها قرض ربوي، وأما السندات الإسلامية فجائزة.", hadith: "الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ (البقرة:275)", tags: ["سندات", "حكومية", "فقه", "بيوع"] },
    { id: 390, question: "ما حكم تداول الأسهم في البورصة؟", answer: "تداول الأسهم جائز إذا كانت الشركة مباحة، ولا تتعامل بالربا، وأما البيع على المكشوف فحرام.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["أسهم", "بورصة", "فقه", "بيوع"] },
    { id: 391, question: "ما حكم المضاربة في الأسهم؟", answer: "المضاربة في الأسهم جائزة إذا كانت في شركات مباحة، وأما المضاربة اليومية (الداي ترايد) ففيها إشكال.", hadith: "عن ابن عمر قال: 'لا تبيعوا ما ليس عندكم' رواه الترمذي، والداي ترايد فيه بيع ما لم يقبض.", tags: ["مضاربة", "أسهم", "فقه", "بيوع"] },
    { id: 392, question: "ما حكم الخيارات في الأسواق المالية؟", answer: "الخيارات (Options) محرمة، لأنها بيع ما ليس عندك، وفيها غرر كبير وميسر.", hadith: "عن حكيم بن حزام قال: قال رسول الله صلى الله عليه وسلم: 'لا تبع ما ليس عندك' رواه الترمذي.", tags: ["خيارات", "مالية", "فقه", "بيوع"] },
    { id: 393, question: "ما حكم العقود الآجلة؟", answer: "العقود الآجلة (Futures) محرمة، لأنها بيع ما ليس عندك، وفيها غرر وميسر، وهي من كبائر المحرمات.", hadith: "عن أبي هريرة قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم.", tags: ["آجلة", "عقود", "فقه", "بيوع"] },
    { id: 394, question: "ما حكم التحوط في الأسواق المالية؟", answer: "التحوط (Hedging) جائز للضرورة وللحاجة الملحة، بشرط ألا يكون في عقود محرمة، ويجوز التحوط بالعقود الإسلامية.", hadith: "فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ (البقرة:173)", tags: ["تحوط", "مالية", "فقه", "بيوع"] },
    { id: 395, question: "ما حكم صفقات المقايضة؟", answer: "صفقات المقايضة (بضاعة ببضاعة) جائزة، بشرط التقابض في المجلس وعدم التأجيل، وعدم الغرر.", hadith: "عن ابن عمر قال: 'نهى رسول الله صلى الله عليه وسلم عن بيع الغرر' رواه مسلم.", tags: ["مقايضة", "صفقات", "فقه", "بيوع"] },
    { id: 396, question: "ما حكم بيع الديون للغير؟", answer: "بيع الديون للغير جائز عند الجمهور، بشرط أن يكون الدين ثابتاً حالاً، ويباع بسعر أقل، والخلاف فيه واسع.", hadith: "عن ابن عباس قال: 'من أسلم في شيء فلا يصرفه إلى غيره' رواه أبو داود، وهذا ليس بصريح في النهي.", tags: ["ديون", "بيع", "فقه", "بيوع"] },
    { id: 397, question: "ما حكم التخصيم؟", answer: "التخصيم (بيع الديون بخصم) جائز عند كثير من العلماء، بشرط أن يكون الدين حالاً وثابتاً، والخطر فيه مرتفع.", hadith: "عن ابن عباس قال: 'من أسلم في شيء فلا يصرفه إلى غيره' رواه أبو داود، ولا يصح النهي.", tags: ["تخصيم", "فقه", "بيوع", "ديون"] },
    { id: 398, question: "ما حكم شراء بطاقات الشحن بالتقسيط؟", answer: "شراء بطاقات الشحن بالتقسيط جائز، بشرط أن لا يكون فيه ربا، وأن يكون الثمن معلوماً والأجل محدداً.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["بطاقات", "شحن", "فقه", "بيوع"] },
    { id: 399, question: "ما حكم بيع الهدايا التذكارية التي فيها صور؟", answer: "بيع الهدايا التذكارية التي فيها صور ذوات الأرواح محرم، لأنها تشجع على التصوير المحرم.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["هدايا", "صور", "بيع", "فقه"] },
    { id: 400, question: "ما حكم بيع التحف والآثار؟", answer: "بيع التحف والآثار جائز إذا لم تكن ثمينة لها قداسة، أو كانت من آثار الكفار التي تروج لشركهم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تحف", "آثار", "بيع", "فقه"] },
    { id: 401, question: "ما حكم بيع الأصنام والتماثيل؟", answer: "بيع الأصنام والتماثيل التي تعبد من دون الله محرم، وثمنها سحت، ويجب كسرها وإتلافها.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["أصنام", "تماثيل", "بيع", "فقه"] },
    { id: 402, question: "ما حكم بيع الصلبان؟", answer: "بيع الصلبان محرم، لأنها شعار الكفر، ويجب كسرها وإتلافها، ولا يجوز بيعها.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه، والصلبان من جنس الأصنام.", tags: ["صلبان", "بيع", "فقه", "حرام"] },
    { id: 403, question: "ما حكم بيع أدوات الكفر والشرك؟", answer: "بيع أدوات الكفر والشرك كالصلبان والأصنام محرم، لأنه إعانة على الكفر وإشهار لشعاراتهم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أدوات", "كفر", "بيع", "فقه"] },
    { id: 404, question: "ما حكم بيع أجزاء الحيوان المحرمة؟", answer: "بيع أجزاء الحيوان المحرم كالدهن والشحم من الميتة محرم، وثمنه سحت، إلا ما كان من الخنزير والكلب.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["حيوان", "محرم", "بيع", "فقه"] },
    { id: 405, question: "ما حكم بيع الزيت النجس؟", answer: "بيع الزيت النجس محرم، لأنه عين نجسة، والانتفاع به غير جائز، وثمنه محرم.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه، والزيت النجس من جنس الميتة.", tags: ["زيت", "نجس", "بيع", "فقه"] },
    { id: 406, question: "ما حكم بيع الفرش النجسة؟", answer: "بيع الفرش النجسة محرم، لنجاستها، إلا إذا أمكن تطهيرها وإزالة النجاسة.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["فرش", "نجسة", "بيع", "فقه"] },
    { id: 407, question: "ما حكم بيع الأواني التي تستعمل في الخمر؟", answer: "بيع الأواني التي تستعمل في الخمر لمن يصنع الخمر محرم، لأنه إعانة على الإثم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أواني", "خمر", "بيع", "فقه"] },
    { id: 408, question: "ما حكم بيع الأواني التي فيها تصاوير؟", answer: "بيع الأواني التي فيها تصاوير ذوات الأرواح محرم، لأنها تشجع على التصوير المحرم.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["أواني", "تصاوير", "بيع", "فقه"] },
    { id: 409, question: "ما حكم بيع السجاد الذي فيه صور؟", answer: "بيع السجاد الذي فيه صور ذوات الأرواح محرم، لأنه من المعلوم أن الصور محرمة، والبيع إعانة عليها.", hadith: "عن عائشة قالت: 'قدم رسول الله صلى الله عليه وسلم من سفر وقد سترت على بابي درنوكاً فيه الخيل ذوات الأجنحة، فأمرني فنزعته' متفق عليه.", tags: ["سجاد", "صور", "بيع", "فقه"] },
    { id: 410, question: "ما حكم بيع الأواني الفخارية التي كانت تستعمل للخمر؟", answer: "بيع الأواني الفخارية التي كانت تستعمل للخمر جائز إذا غسلت وأزيلت عنها النجاسة، واستعملت في المباح.", hadith: "عن جابر قال: 'نهى رسول الله صلى الله عليه وسلم عن الدباء والمزفت والنقير' رواه مسلم، وهذا في أواني الخمر، والنهي للكراهة عند الجمهور.", tags: ["أواني", "فخارية", "بيع", "فقه"] },
    { id: 411, question: "ما حكم بيع الذهب المخلوط بغيره؟", answer: "بيع الذهب المخلوط بغيره (كالنحاس) جائز إذا كان الغالب هو الذهب، ويباع بقيمته مع بيان الخلط.", hadith: "عن أبي سعيد الخدري قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا الذهب بالذهب إلا مثلاً بمثل' متفق عليه، والخلط يمنع من التماثل.", tags: ["ذهب", "مخلوط", "بيع", "فقه"] },
    { id: 412, question: "ما حكم بيع الفضة المخلوطة؟", answer: "بيع الفضة المخلوطة بغيرها جائز، بشرط بيان الخلط، ويكون العقد على المجموع مع جهالة يسيرة.", hadith: "عن ابن عباس قال: 'لا بأس ببيع الفضة المخلوطة بالذهب إذا كان يداً بيد' رواه البيهقي.", tags: ["فضة", "مخلوطة", "بيع", "فقه"] },
    { id: 413, question: "ما حكم بيع الحلي المصنوعة من الذهب والفضة معاً؟", answer: "بيع الحلي المصنوعة من الذهب والفضة معاً جائز، مع بيان الوزن والثمن، ويباع بالوزن أو بالقطعة.", hadith: "عن ابن عمر قال: 'لا بأس بالحلي المصنوع من الذهب والفضة يباع مرابحة' رواه البيهقي.", tags: ["حلي", "ذهب", "فضة", "بيع"] },
    { id: 414, question: "ما حكم بيع المجوهرات بالتقسيط؟", answer: "بيع المجوهرات بالتقسيط جائز إذا كانت من غير الذهب والفضة (كاللؤلؤ والماس)، أما الذهب والفضة فلا.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... يداً بيد' رواه مسلم، والذهب والفضة لا يجوز فيهما النسيئة.", tags: ["مجوهرات", "تقسيط", "بيع", "فقه"] },
    { id: 415, question: "ما حكم بيع الألماس بالتقسيط؟", answer: "بيع الألماس بالتقسيط جائز، لأنه ليس من الأصناف الربوية، ولا يدخله الربا.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ألماس", "تقسيط", "بيع", "فقه"] },
    { id: 416, question: "ما حكم بيع اللؤلؤ بالتقسيط؟", answer: "بيع اللؤلؤ بالتقسيط جائز، لأنه ليس من الأصناف الربوية، ويجوز بيعه بثمن مؤجل.", hadith: "عن ابن عباس قال: 'لا بأس باللؤلؤ باللؤلؤ نسيئة' رواه البيهقي.", tags: ["لؤلؤ", "تقسيط", "بيع", "فقه"] },
    { id: 417, question: "ما حكم بيع الياقوت والزمرد بالتقسيط؟", answer: "بيع الياقوت والزمرد بالتقسيط جائز، لأنهما من الأحجار الكريمة، وليست من الأصناف الربوية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ياقوت", "زمرد", "بيع", "فقه"] },
    { id: 418, question: "ما حكم بيع الساعات الثمينة بالتقسيط؟", answer: "بيع الساعات الثمينة بالتقسيط جائز، بشرط ألا يكون في صنعتها ذهب أو فضة يباع بجنسه نسيئة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ساعات", "تقسيط", "بيع", "فقه"] },
    { id: 419, question: "ما حكم بيع الأثاث بالتقسيط؟", answer: "بيع الأثاث بالتقسيط جائز، مع زيادة الثمن مقابل الأجل، وهو من البيوع المشروعة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أثاث", "تقسيط", "بيع", "فقه"] },
    { id: 420, question: "ما حكم بيع الأجهزة الكهربائية بالتقسيط؟", answer: "بيع الأجهزة الكهربائية بالتقسيط جائز، بشرط تحديد الأجل والثمن، وعدم الغرر.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كهربائية", "بيع", "فقه"] },
    { id: 421, question: "ما حكم بيع الكتب بالتقسيط؟", answer: "بيع الكتب بالتقسيط جائز، وهو من البيوع المشروعة، بشرط عدم بيع الكتب المحرمة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["كتب", "تقسيط", "بيع", "فقه"] },
    { id: 422, question: "ما حكم بيع المواد الغذائية بالتقسيط؟", answer: "بيع المواد الغذائية بالتقسيط جائز إذا كان الثمن معلوماً والأجل محدداً، وليست من الأصناف الربوية.", hadith: "عن ابن عباس قال: 'لا بأس ببيع الطعام بالطعام نسيئة إذا كان مختلفاً' رواه البيهقي.", tags: ["مواد", "غذائية", "بيع", "فقه"] },
    { id: 423, question: "ما حكم بيع الدواء بالتقسيط؟", answer: "بيع الدواء بالتقسيط جائز، لأنه من السلع المباحة، ولا ربا فيه ما لم يكن من الأصناف الربوية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["دواء", "تقسيط", "بيع", "فقه"] },
    { id: 424, question: "ما حكم بيع مواد البناء بالتقسيط؟", answer: "بيع مواد البناء بالتقسيط جائز، مع تحديد الثمن والأجل، وليس فيها ربا.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مواد", "بناء", "بيع", "فقه"] },
    { id: 425, question: "ما حكم بيع المصنوعات الجلدية بالتقسيط؟", answer: "بيع المصنوعات الجلدية بالتقسيط جائز، بشرط ألا تكون من جلود الخنزير أو الميتة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["جلدية", "تقسيط", "بيع", "فقه"] },
    { id: 426, question: "ما حكم بيع العطور بالتقسيط؟", answer: "بيع العطور بالتقسيط جائز، بشرط ألا تحتوي على كحول مسكر، وألا تكون مستوردة من أموال الربا.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["عطور", "تقسيط", "بيع", "فقه"] },
    { id: 427, question: "ما حكم بيع مستحضرات التجميل بالتقسيط؟", answer: "بيع مستحضرات التجميل بالتقسيط جائز، بشرط ألا تكون محرمة كالتي فيها مواد نجسة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تجميل", "تقسيط", "بيع", "فقه"] },
    { id: 428, question: "ما حكم بيع الأدوات الرياضية بالتقسيط؟", answer: "بيع الأدوات الرياضية بالتقسيط جائز، بشرط ألا تستعمل في محرم كالميسر.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["رياضية", "أدوات", "بيع", "فقه"] },
    { id: 429, question: "ما حكم بيع أدوات الصيد بالتقسيط؟", answer: "بيع أدوات الصيد بالتقسيط جائز، بشرط أن تكون لأغراض مباحة كالصيد للأكل.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["صيد", "أدوات", "بيع", "فقه"] },
    { id: 430, question: "ما حكم بيع معدات الصيدلة بالتقسيط؟", answer: "بيع معدات الصيدلة بالتقسيط جائز، لأنه من المباحات، ولا ربا فيها.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["معدات", "صيدلة", "بيع", "فقه"] },
    { id: 431, question: "ما حكم بيع الأجهزة الطبية بالتقسيط؟", answer: "بيع الأجهزة الطبية بالتقسيط جائز، بشرط أن تكون حلال الاستعمال، والبيع من العقود الجائزة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طبية", "بيع", "فقه"] },
    { id: 432, question: "ما حكم بيع السيارات المملوكة للبنوك بالتقسيط؟", answer: "بيع السيارات المملوكة للبنوك بالتقسيط جائز إذا كان البنك إسلامياً، أما البنوك الربوية فبيعها محرم.", hadith: "عن جابر قال: 'لعن رسول الله صلى الله عليه وسلم آكل الربا وموكله وكاتبه وشاهديه' رواه مسلم.", tags: ["سيارات", "بنوك", "بيع", "فقه"] },
    { id: 433, question: "ما حكم بيع الميتة للكلاب؟", answer: "بيع الميتة للكلاب المدربة أو للصقور جائز، أما بيعها للمسلمين لغير هذه الحاجة فلا.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' فقيل: يا رسول الله، أرأيت شحوم الميتة فإنه يدهن بها السفن ويدهن بها الجلود، فقال: 'لا، هو حرام' رواه البخاري.", tags: ["ميتة", "بيع", "فقه", "حيوانات"] },
    { id: 434, question: "ما حكم بيع الخنزير للكافر؟", answer: "بيع الخنزير للكافر جائز عند بعض العلماء، والأفضل تركه، وعند الجمهور لا يجوز مطلقاً.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه، وهذا عام في المسلم والكافر.", tags: ["خنزير", "بيع", "كافر", "فقه"] },
    { id: 435, question: "ما حكم بيع الخمر للكافر؟", answer: "بيع الخمر للكافر محرم، لأنه إعانة على الإثم، والكافر مخاطب بفروع الشريعة.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'إن الله حرم بيع الخمر والميتة والخنزير والأصنام' متفق عليه.", tags: ["خمر", "كافر", "بيع", "فقه"] },
    { id: 436, question: "ما حكم بيع المصحف للكافر؟", answer: "بيع المصحف للكافر جائز إذا كان سيحترمه ويدرسه، أما إذا كان يستهين به فلا يجوز.", hadith: "عن ابن عباس قال: 'لا تبيعوا المصحف على المشركين إلا أن ترجوا إسلامهم' رواه الطبراني.", tags: ["مصحف", "كافر", "بيع", "فقه"] },
    { id: 437, question: "ما حكم بيع السلاح للكافر؟", answer: "بيع السلاح للكافر الذي يحارب المسلمين محرم، أما إذا كان كافراً غير محارب فيجوز.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'لا تبيعوا السلاح في الفتنة' رواه الطبراني، والكافر المحارب من الفتنة.", tags: ["سلاح", "كافر", "بيع", "فقه"] },
    { id: 438, question: "ما حكم بيع العلم للكافر؟", answer: "بيع العلم وتعليم الكافر العلوم النافعة جائز، بل قد يكون واجباً إذا كان فيه مصلحة.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من علم علماً فعلمه كان له مثل أجر العامل' رواه ابن ماجه.", tags: ["علم", "كافر", "بيع", "فقه"] },
    { id: 439, question: "ما حكم بيع الأرض التي فيها وقف؟", answer: "لا يجوز بيع أرض الوقف، إلا إذا تعطلت منافعها وتعذر إصلاحها، فيباع ويشترى بدله.", hadith: "عن عمر بن الخطاب قال: 'لا يباع أصل الوقف ولا يوهب ولا يورث' رواه البيهقي.", tags: ["أرض", "وقف", "بيع", "فقه"] },
    { id: 440, question: "ما حكم بيع مال اليتيم بدون حاجة؟", answer: "لا يجوز بيع مال اليتيم إلا للحاجة والمصلحة، كأن يتلف المال أو يكون فيه ضرر.", hadith: "وَلَا تَقْرَبُوا مَالَ الْيَتِيمِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ (الأنعام:152)", tags: ["يتيم", "مال", "بيع", "فقه"] },
    { id: 441, question: "ما حكم بيع الأسهم بعد ارتفاع سعرها؟", answer: "بيع الأسهم بعد ارتفاع سعرها جائز، وهو من الأرباح المباحة، بشرط أن تكون الشركة مباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسهم", "بيع", "فقه", "أرباح"] },
    { id: 442, question: "ما حكم بيع الأسهم وقت النزول؟", answer: "بيع الأسهم وقت النزول جائز، وهو من البيوع المشروعة، وليس من الاحتكار المذموم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسهم", "نزول", "بيع", "فقه"] },
    { id: 443, question: "ما حكم بيع الذهب المستعمل في السوق؟", answer: "بيع الذهب المستعمل جائز، بشرط أن يكون معلوماً وزناً وثمناً، والتقابض في المجلس، وعدم التفاضل في الجنس الواحد.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... مثلاً بمثل' رواه مسلم.", tags: ["ذهب", "مستعمل", "بيع", "فقه"] },
    { id: 444, question: "ما حكم بيع السلعة بثمنين ثمن نقد وثمن نسيئة؟", answer: "بيع السلعة بثمنين (نقداً أرخص ونسيئة أغلى) جائز، بشرط أن يختار البائع والمشتري أحد الثمنين وقت العقد.", hadith: "عن ابن عباس قال: 'لا بأس بأن يبيع الرجل سلعة بنقد وبنظرة' رواه البيهقي.", tags: ["سلعة", "ثمنين", "بيع", "فقه"] },
    { id: 445, question: "ما حكم بيع السلعة بشرط أن يبيع البائع سلعة أخرى؟", answer: "بيع السلعة بشرط أن يبيع البائع سلعة أخرى (شرطان في بيع) محرم، لأنه من البيوع المنهي عنها.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل سلف وبيع، ولا شرطان في بيع، ولا ربح ما لم يضمن، ولا بيع ما ليس عندك' رواه الترمذي.", tags: ["شرطان", "بيع", "فقه", "حرام"] },
    { id: 446, question: "ما حكم بيع السلعة بشرط أن يشتريها البائع مرة أخرى؟", answer: "بيع السلعة بشرط أن يشتريها البائع مرة أخرى (بيع الوفاء) محرم، لأنه من البيوع المنهي عنها.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل سلف وبيع، ولا شرطان في بيع' رواه الترمذي.", tags: ["بيع", "وفاء", "حرام", "فقه"] },
    { id: 447, question: "ما حكم بيع السلعة بشرط أن يقرضه البائع؟", answer: "بيع السلعة بشرط أن يقرضه البائع (سلف وبيع) محرم، لأنه من البيوع المنهي عنها.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل سلف وبيع' رواه الترمذي.", tags: ["سلف", "بيع", "حرام", "فقه"] },
    { id: 448, question: "ما حكم بيع السلعة بشرط أن يهدي له شيئاً؟", answer: "بيع السلعة بشرط أن يهدي له شيئاً (شرط الهدية) جائز، إذا كانت الهدية معروفة وليست رشوة.", hadith: "عن أنس قال: 'كان النبي صلى الله عليه وسلم يقبل الهدية ويثيب عليها' رواه البخاري.", tags: ["هدية", "بيع", "شرط", "فقه"] },
    { id: 449, question: "ما حكم بيع السلعة على أنها من بلد معين وهي ليست كذلك؟", answer: "بيع السلعة على أنها من بلد معين مع العلم بأنها من بلد آخر (غش) محرم، لأنه كذب وتدليس.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["غش", "بلد", "بيع", "حرام"] },
    { id: 450, question: "ما حكم بيع السلعة على أنها جديدة وهي مستعملة؟", answer: "بيع السلعة على أنها جديدة وهي مستعملة (تدليس) محرم، لأنه كذب وغش.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'المسلم أخو المسلم، ولا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["جديدة", "مستعملة", "بيع", "فقه"] },
    { id: 451, question: "ما حكم بيع السلعة المعيبة مع بيان العيب؟", answer: "بيع السلعة المعيبة مع بيان العيب جائز، بشرط أن يرضى المشتري بالعيب، وأن ينقص الثمن.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["معيبة", "بيع", "فقه", "عيب"] },
    { id: 452, question: "ما حكم بيع السلعة الممنوعة قانوناً؟", answer: "بيع السلعة الممنوعة قانوناً محرم، إذا كان القانون يمنعها لحكمة شرعية، أما إذا كان ظلماً فيحرم احتياطاً.", hadith: "أَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ وَأُولِي الْأَمْرِ مِنكُمْ (النساء:59)", tags: ["ممنوعة", "قانون", "بيع", "فقه"] },
    { id: 453, question: "ما حكم بيع سلعة مغشوشة؟", answer: "بيع السلعة المغشوشة محرم، لأنه غش وتدليس، ويأثم فاعله، وعليه تبعة الغش.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["مغشوشة", "بيع", "حرام", "فقه"] },
    { id: 454, question: "ما حكم بيع المنتجات المقلدة؟", answer: "بيع المنتجات المقلدة (التي تشبه علامات تجارية معروفة) محرم، لأنه غش وتدليس، وفيه ظلم لأصحاب الحقوق.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["مقلدة", "منتجات", "بيع", "فقه"] },
    { id: 455, question: "ما حكم بيع السلعة التي انتهت صلاحيتها؟", answer: "بيع السلعة التي انتهت صلاحيتها محرم، لأنه غش وتدليس، وفيه ضرر على المشتري.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا ضرر ولا ضرار' رواه ابن ماجه.", tags: ["صلاحية", "بيع", "فقه", "غش"] },
    { id: 456, question: "ما حكم بيع المستورد دون بيان بلد المنشأ؟", answer: "بيع المستورد دون بيان بلد المنشأ جائز، إلا إذا اشترط المشتري بلداً معيناً وغُشّ فيه، فيحرم.", hadith: "عن عقبة بن عامر قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل لمسلم باع من أخيه بيعاً فيه عيب إلا بينه' رواه ابن ماجه.", tags: ["مستورد", "بلد", "بيع", "فقه"] },
    { id: 457, question: "ما حكم بيع السلعة على أنها صناعة يدوية وهي صناعة آلية؟", answer: "بيع السلعة على أنها صناعة يدوية وهي صناعة آلية حرام، لأنه كذب وغش.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["يدوية", "آلية", "بيع", "فقه"] },
    { id: 458, question: "ما حكم بيع السلعة المستوردة من بلد عدواني؟", answer: "بيع السلعة المستوردة من بلد عدواني جائز، إذا لم تكن من الأسلحة المحرمة، أو مما يدعم عدوانهم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["مستوردة", "عدواني", "بيع", "فقه"] },
    { id: 459, question: "ما حكم بيع سلعة عليها صور؟", answer: "بيع السلعة التي عليها صور ذوات الأرواح محرم، لأنه تشجيع على التصوير والصور المحرمة.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["صور", "سلعة", "بيع", "فقه"] },
    { id: 460, question: "ما حكم بيع الألعاب التي فيها صور؟", answer: "بيع الألعاب التي فيها صور ذوات الأرواح محرم، للأطفال أو غيرهم، لأنها تعود على الصور.", hadith: "عن عائشة قالت: 'قدم رسول الله صلى الله عليه وسلم من سفر وقد سترت على بابي درنوكاً فيه الخيل ذوات الأجنحة، فأمرني فنزعته' متفق عليه.", tags: ["ألعاب", "صور", "بيع", "فقه"] },
    { id: 461, question: "ما حكم بيع السيارات التي فيها تماثيل؟", answer: "بيع السيارات التي فيها تماثيل (مجسمات لذوات أرواح) محرم، لأنه من الترويج للصور والتماثيل.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["سيارات", "تماثيل", "بيع", "فقه"] },
    { id: 462, question: "ما حكم بيع البخور الذي فيه روائح كحولية؟", answer: "بيع البخور الذي فيه روائح كحولية مسكرة جائز إذا كانت الروائح غير مسكرة، أما إذا كان الكحول مسكراً فيحرم.", hadith: "ما أسكر كثيره فقليله حرام. رواه أبو داود.", tags: ["بخور", "كحول", "بيع", "فقه"] },
    { id: 463, question: "ما حكم بيع معطرات الجو التي فيها كحول؟", answer: "بيع معطرات الجو التي فيها كحول طبي (غير مسكر) جائز، لأنه ليس مسكراً ولا قصد به الإسكار.", hadith: "عن أنس قال: كان النبي صلى الله عليه وسلم 'يعجبه الطيب' رواه البخاري.", tags: ["معطرات", "كحول", "بيع", "فقه"] },
    { id: 464, question: "ما حكم بيع الصابون المعطر بالكحول؟", answer: "بيع الصابون المعطر بالكحول جائز، لأن الكحول فيه للتعقيم والتعطير، وليس للإسكار.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'الطهور شطر الإيمان' رواه مسلم، والصابون من الطهور.", tags: ["صابون", "كحول", "بيع", "فقه"] },
    { id: 465, question: "ما حكم بيع الأدوية التي تحتوي على كحول؟", answer: "بيع الأدوية التي تحتوي على كحول (للاستعمال الخارجي) جائز، لأنه للضرورة والعلاج.", hadith: "فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ (البقرة:173)", tags: ["أدوية", "كحول", "بيع", "فقه"] },
    { id: 466, question: "ما حكم بيع مستحضرات التجميل التي فيها كحول؟", answer: "بيع مستحضرات التجميل التي فيها كحول طبي (للتعقيم) جائز، أما التي فيها كحول مسكر فلا.", hadith: "ما أسكر كثيره فقليله حرام. رواه أبو داود.", tags: ["تجميل", "كحول", "بيع", "فقه"] },
    { id: 467, question: "ما حكم بيع ملابس فيها حرير؟", answer: "بيع ملابس فيها حرير للرجال محرم، وللنساء جائز، فلا يجوز بيعها للرجل مع علمه بتحريمها.", hadith: "عن عمر بن الخطاب قال: قال رسول الله صلى الله عليه وسلم: 'لا تلبسوا الحرير فإن من لبسه في الدنيا لم يلبسه في الآخرة' متفق عليه.", tags: ["حرير", "ملابس", "بيع", "فقه"] },
    { id: 468, question: "ما حكم بيع ملابس فيها ذهب للرجال؟", answer: "بيع ملابس مطرزة بالذهب للرجال محرم، لأنه إعانة على لبس الذهب المحرم.", hadith: "عن علي بن أبي طالب قال: أخذ رسول الله صلى الله عليه وسلم حريراً فجعله في يمينه وذهباً فجعله في شماله ثم قال: 'إن هذين حرام على ذكور أمتي' رواه أبو داود.", tags: ["ذهب", "ملابس", "رجال", "فقه"] },
    { id: 469, question: "ما حكم بيع الملابس القصيرة؟", answer: "بيع الملابس القصيرة (التي لا تستر العورة) جائز إذا كان المشتري سيلبسها في المنزل أو يسترها، أو يبيعها لغير المسلم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ملابس", "قصيرة", "بيع", "فقه"] },
    { id: 470, question: "ما حكم بيع الأزياء الشفافة؟", answer: "بيع الأزياء الشفافة للمسلمات محرم، لأنها تعين على إظهار العورة، ولغير المسلمات جائز.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أزياء", "شفافة", "بيع", "فقه"] },
    { id: 471, question: "ما حكم بيع المجلات التي فيها صور عارية؟", answer: "بيع المجلات التي فيها صور عارية محرم، لأنها فاحشة وتدعو للزنا، وإعانة على الحرام.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["مجلات", "عارية", "بيع", "فقه"] },
    { id: 472, question: "ما حكم بيع الأفلام الجنسية؟", answer: "بيع الأفلام الجنسية محرم، وهو من كبائر الذنوب، وإعانة على الزنا والفواحش.", hadith: "إِنَّ الَّذِينَ يُحِبُّونَ أَن تَشِيعَ الْفَاحِشَةُ فِي الَّذِينَ آمَنُوا لَهُمْ عَذَابٌ أَلِيمٌ (النور:19)", tags: ["أفلام", "جنسية", "بيع", "فقه"] },
    { id: 473, question: "ما حكم بيع الأقراص المقرصنة؟", answer: "بيع الأقراص المقرصنة محرم، لأنه أكل للمال بالباطل، وظلم لأصحاب الحقوق.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل مال امرئ مسلم إلا بطيب نفس منه' رواه أحمد.", tags: ["مقرصنة", "أقراص", "بيع", "فقه"] },
    { id: 474, question: "ما حكم بيع البرامج المقرصنة؟", answer: "بيع البرامج المقرصنة محرم، لأنه أكل للمال بالباطل، وهو سرقة وانتهاك للحقوق.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل مال امرئ مسلم إلا بطيب نفس منه' رواه أحمد.", tags: ["برامج", "مقرصنة", "بيع", "فقه"] },
    { id: 475, question: "ما حكم بيع الكتب المقرصنة؟", answer: "بيع الكتب المقرصنة محرم، لأنه أكل للمال بالباطل، وظلم للمؤلف والناشر.", hadith: "عن ابن مسعود قال: قال رسول الله صلى الله عليه وسلم: 'من سبق إلى ما لا يحل له فهو آثم' رواه البخاري.", tags: ["كتب", "مقرصنة", "بيع", "فقه"] },
    { id: 476, question: "ما حكم بيع المحتوى الرقمي المقرصن؟", answer: "بيع المحتوى الرقمي المقرصن محرم، لأنه انتهاك للحقوق الفكرية وأكل للمال بالباطل.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'لا يحل مال امرئ مسلم إلا بطيب نفس منه' رواه أحمد.", tags: ["محتوى", "رقمي", "بيع", "فقه"] },
    { id: 477, question: "ما حكم بيع الشهادات المزورة؟", answer: "بيع الشهادات المزورة محرم، وهو غش وكذب، وتعاون على الإثم والعدوان.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'من غشنا فليس منا' رواه مسلم.", tags: ["شهادات", "مزورة", "بيع", "فقه"] },
    { id: 478, question: "ما حكم بيع الأدوات التي تغش بها الموازين؟", answer: "بيع الأدوات التي تغش بها الموازين محرم، لأنه إعانة على الغش وأكل أموال الناس بالباطل.", hadith: "وَيْلٌ لِّلْمُطَفِّفِينَ (المطففين:1)", tags: ["أدوات", "موازين", "بيع", "فقه"] },
    { id: 479, question: "ما حكم بيع آلات التصوير الخفية؟", answer: "بيع آلات التصوير الخفية التي تستعمل في التصوير المحرم محرم، لأنه إعانة على انتهاك الحرمات.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["تصوير", "خفية", "بيع", "فقه"] },
    { id: 480, question: "ما حكم بيع أجهزة التنصت؟", answer: "بيع أجهزة التنصت محرم إذا استعملت في انتهاك الخصوصية، وإلا فلا بأس بها للضرورة الأمنية.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["تنصت", "أجهزة", "بيع", "فقه"] },
    { id: 481, question: "ما حكم بيع الحشيش المخدر؟", answer: "بيع الحشيش والمخدرات محرم، وهو من كبائر الذنوب، وثمنه سحت، وفيه عقوبة شديدة.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'كل مسكر خمر وكل مسكر حرام' رواه مسلم.", tags: ["حشيش", "مخدرات", "بيع", "فقه"] },
    { id: 482, question: "ما حكم بيع الحبوب المهلوسة؟", answer: "بيع الحبوب المهلوسة المخدرة محرم، لأنها تضر بالعقل وتؤدي إلى المهالك.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'كل مسكر خمر وكل مسكر حرام' رواه مسلم.", tags: ["حبوب", "مهلوسة", "بيع", "فقه"] },
    { id: 483, question: "ما حكم بيع مواد الإدمان؟", answer: "بيع مواد الإدمان (كالكوكايين والهيروين) محرم، وهو من كبائر الذنوب، ويدخل تحت قاعدة كل مسكر حرام.", hadith: "عن ابن عمر قال: قال رسول الله صلى الله عليه وسلم: 'كل مسكر خمر وكل مسكر حرام' رواه مسلم.", tags: ["إدمان", "مواد", "بيع", "فقه"] },
    { id: 484, question: "ما حكم بيع الغاز المسيل للدموع؟", answer: "بيع الغاز المسيل للدموع جائز للاستعمال المشروع، كاستخدامه للدفاع عن النفس أو لأغراض أمنية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["غاز", "مسيل", "بيع", "فقه"] },
    { id: 485, question: "ما حكم بيع الأسلحة البيضاء؟", answer: "بيع الأسلحة البيضاء (السكاكين والخناجر) جائز للاستعمال المشروع، ومحرم لمن يستعملها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسلحة", "بيضاء", "بيع", "فقه"] },
    { id: 486, question: "ما حكم بيع الأسلحة النارية للأفراد؟", answer: "بيع الأسلحة النارية للأفراد جائز بشروط: للدفاع عن النفس، بترخيص، وعدم بيعها للمجرمين والمفسدين.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أسلحة", "نارية", "بيع", "فقه"] },
    { id: 487, question: "ما حكم بيع الألعاب النارية؟", answer: "بيع الألعاب النارية جائز، بشرط ألا تضر بالآخرين، وألا تكون سببا في الإزعاج أو الحرائق.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ألعاب", "نارية", "بيع", "فقه"] },
    { id: 488, question: "ما حكم بيع الحيوانات الضالة؟", answer: "بيع الحيوانات الضالة (التي لا يعرف صاحبها) جائز بعد تعريفها لمدة سنة، فإن لم يأت صاحبها فهي للملتقط.", hadith: "عن زيد بن خالد الجهني قال: سأل رجل رسول الله صلى الله عليه وسلم عن اللقطة، فقال: 'اعرف عفاصها ووكاءها، ثم عرفها سنة، فإن جاء صاحبها وإلا فشأنك بها' متفق عليه.", tags: ["حيوانات", "ضالة", "بيع", "فقه"] },
    { id: 489, question: "ما حكم بيع الكلاب للصيد؟", answer: "بيع الكلاب للصيد والحرث والماشية جائز، وثمنها حلال، وهي استثناء من النهي العام.", hadith: "عن أبي هريرة قال: قال رسول الله صلى الله عليه وسلم: 'ثمن الكلب حرام'، واستثنى من ذلك كلب الصيد والحرث. رواه مسلم.", tags: ["كلاب", "صيد", "بيع", "فقه"] },
    { id: 490, question: "ما حكم بيع الفيلة؟", answer: "بيع الفيلة جائز، لأنها من الحيوانات المباحة، ويمكن استخدامها في العمل والنقل.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["فيلة", "بيع", "فقه", "حيوانات"] },
    { id: 491, question: "ما حكم بيع الأسود والنمور؟", answer: "بيع الأسود والنمور جائز، لأنها حلال العين، ويمكن تربيتها في حدائق الحيوان، أو للزينة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسود", "نمور", "بيع", "فقه"] },
    { id: 492, question: "ما حكم بيع القرود؟", answer: "بيع القرود جائز، لأنها حلال العين، ويمكن تربيتها في المنزل أو في حدائق الحيوان.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["قرود", "بيع", "فقه", "حيوانات"] },
    { id: 493, question: "ما حكم بيع الطيور المغردة؟", answer: "بيع الطيور المغردة جائز، كالعندليب والبلبل، لأنها من الطيور المباحة للاقتناء والاستمتاع بصوتها.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["طيور", "مغردة", "بيع", "فقه"] },
    { id: 494, question: "ما حكم بيع الطيور الجارحة؟", answer: "بيع الطيور الجارحة كالصقور والنسور جائز، للصيد والتدريب، وثمنها حلال.", hadith: "عن عبد الله بن عمر قال: قال رسول الله صلى الله عليه وسلم: 'من اقتنى كلباً إلا كلب صيد أو كلب ماشية فإنه ينقص من أجره كل يوم قيراطان' متفق عليه، والطيور الجارحة بمنزلة كلب الصيد.", tags: ["طيور", "جوارح", "بيع", "فقه"] },
    { id: 495, question: "ما حكم بيع أسماك الزينة؟", answer: "بيع أسماك الزينة جائز، وهي من الحيوانات المباحة، واقتناؤها جائز للزينة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسماك", "زينة", "بيع", "فقه"] },
    { id: 496, question: "ما حكم بيع الحشرات للزينة؟", answer: "بيع الحشرات للزينة (كالفراشات والعقارب) جائز، لأنها حلال العين، ويمكن تربيتها في أحواض زجاجية.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["حشرات", "زينة", "بيع", "فقه"] },
    { id: 497, question: "ما حكم بيع النمل؟", answer: "بيع النمل جائز للاستفادة منه في الأبحاث أو الزينة، وليس فيه محذور شرعي.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["نمل", "بيع", "فقه", "حيوانات"] },
    { id: 498, question: "ما حكم بيع ديدان القز؟", answer: "بيع ديدان القز جائز، للاستفادة من حريرها في صناعة المنسوجات المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ديدان", "قز", "بيع", "فقه"] },
    { id: 499, question: "ما حكم بيع العسل مع الشمع؟", answer: "بيع العسل مع الشمع (أقراص العسل) جائز، وهو من المنتجات الطبيعية المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["عسل", "شمع", "بيع", "فقه"] },
    { id: 500, question: "ما حكم بيع حليب الإبل؟", answer: "بيع حليب الإبل جائز، وهو من الأطعمة المباحة، وفيه بركة ومنفعة.", hadith: "عن أنس قال: 'أتى النبي صلى الله عليه وسلم أعرابي فسأله عن البول في المسجد، فقال: لا تبالوا، ثم دعا بدلو من ماء فصبه عليه' متفق عليه، وإباحة الحليب ثابتة.", tags: ["حليب", "إبل", "بيع", "فقه"] },
    { id: 501, question: "ما حكم بيع الجلود المدبوغة؟", answer: "بيع الجلود المدبوغة جائزة، إذا كانت من حيوان مباح، ودبغها يطهرها عند الجمهور.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'أيما إهاب دبغ فقد طهر' رواه مسلم.", tags: ["جلود", "مدبوغة", "بيع", "فقه"] },
    { id: 502, question: "ما حكم بيع الصوف والوبر؟", answer: "بيع الصوف والوبر جائز، لأنه من الحيوانات المباحة، ويمكن غزله واستعماله في الملابس.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["صوف", "وبر", "بيع", "فقه"] },
    { id: 503, question: "ما حكم بيع الريش؟", answer: "بيع الريش جائز، كريش النعام والطاووس، للزينة أو الصناعة، وليس فيه محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ريش", "بيع", "فقه", "طيور"] },
    { id: 504, question: "ما حكم بيع العظام؟", answer: "بيع العظام جائز، إذا كانت من حيوان ميت مذكى أو من حيوان حي، والمنفعة فيها مباحة.", hadith: "عن جابر قال: قال رسول الله صلى الله عليه وسلم: 'لا تنتفعوا من الميتة بإهاب ولا عصب' رواه أبو داود، والعظام ليست داخلة في النهي.", tags: ["عظام", "بيع", "فقه", "حيوانات"] },
    { id: 505, question: "ما حكم بيع القرن والعاج؟", answer: "بيع القرن والعاج جائز إذا كان من فيل أو حيوان مذكى، أما إذا كان من ميتة فلا.", hadith: "عن ابن عباس قال: قال رسول الله صلى الله عليه وسلم: 'أيما إهاب دبغ فقد طهر' رواه مسلم، والعاج من جنس الإهاب.", tags: ["قرن", "عاج", "بيع", "فقه"] },
    { id: 506, question: "ما حكم بيع الكهرمان؟", answer: "بيع الكهرمان (العنبر) جائز، وهو من الأحجار الكريمة، وثمنه حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["كهرمان", "عنبر", "بيع", "فقه"] },
    { id: 507, question: "ما حكم بيع المرجان؟", answer: "بيع المرجان جائز، وهو من الأحجار الكريمة، ويمكن استخدامه في الزينة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مرجان", "بيع", "فقه", "زينة"] },
    { id: 508, question: "ما حكم بيع الأصداف البحرية؟", answer: "بيع الأصداف البحرية جائز، وهي من المباحات، ويمكن استخدامها في الزينة والديكور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أصداف", "بحرية", "بيع", "فقه"] },
    { id: 509, question: "ما حكم بيع اللؤلؤ الطبيعي؟", answer: "بيع اللؤلؤ الطبيعي جائز، وهو من الثمين المباح، وثمنه حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["لؤلؤ", "طبيعي", "بيع", "فقه"] },
    { id: 510, question: "ما حكم بيع الذهب الملبون؟", answer: "بيع الذهب الملبون (المشغول) جائز، مع بيان الوزن والثمن، وعدم التفاضل في الجنس الواحد.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... مثلاً بمثل' رواه مسلم.", tags: ["ذهب", "ملبون", "بيع", "فقه"] },
    { id: 511, question: "ما حكم بيع السبائك الذهبية؟", answer: "بيع السبائك الذهبية جائز، بشرط التساوي في الوزن والتقابض في المجلس، والتفاضل حرام.", hadith: "عن عبادة بن الصامت قال: قال رسول الله صلى الله عليه وسلم: 'الذهب بالذهب... مثلاً بمثل' رواه مسلم.", tags: ["سبائك", "ذهب", "بيع", "فقه"] },
    { id: 512, question: "ما حكم بيع العملات المعدنية القديمة؟", answer: "بيع العملات المعدنية القديمة (التحف) جائز، إذا كانت من غير الذهب والفضة، أو كانت من الذهب والفضة ولكن كتحف لا كعملات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["عملات", "قديمة", "بيع", "فقه"] },
    { id: 513, question: "ما حكم بيع الطوابع البريدية القديمة؟", answer: "بيع الطوابع البريدية القديمة (كتحف) جائز، وهو من البيوع المباحة، وليس فيها ربا.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["طوابع", "بريدية", "بيع", "فقه"] },
    { id: 514, question: "ما حكم بيع بطاقات الهاتف المستعملة؟", answer: "بيع بطاقات الهاتف المستعملة (التي انتهت قيمتها) كتحف جائز، لأنه لا قيمة لها إلا كتذكار.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["بطاقات", "هاتف", "بيع", "فقه"] },
    { id: 515, question: "ما حكم بيع التحف الثمينة؟", answer: "بيع التحف الثمينة (كالأثريات) جائز، بشرط ألا تكون مما يعبد من دون الله، أو من رموز الكفر.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تحف", "ثمينة", "بيع", "فقه"] },
    { id: 516, question: "ما حكم بيع الأعشاب الطبية؟", answer: "بيع الأعشاب الطبية جائز، وهو من النباتات المباحة، والتداوي بها جائز.", hadith: "عن أسامة بن شريك قال: قال رسول الله صلى الله عليه وسلم: 'تداووا عباد الله فإن الله لم يضع داء إلا وضع له دواء' رواه الترمذي.", tags: ["أعشاب", "طبية", "بيع", "فقه"] },
    { id: 517, question: "ما حكم بيع البذور المعدلة وراثياً؟", answer: "بيع البذور المعدلة وراثياً جائز، ما لم تثبت أضرارها القاطعة، والأصل الإباحة حتى يثبت الضرر.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["بذور", "معدلة", "بيع", "فقه"] },
    { id: 518, question: "ما حكم بيع الأسمدة الكيماوية؟", answer: "بيع الأسمدة الكيماوية جائز، للاستفادة منها في الزراعة، وليس فيها محذور شرعي.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أسمدة", "كيماوية", "بيع", "فقه"] },
    { id: 519, question: "ما حكم بيع المبيدات الحشرية؟", answer: "بيع المبيدات الحشرية جائز، لقتل الحشرات الضارة، وليس فيها محذور شرعي.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مبيدات", "حشرية", "بيع", "فقه"] },
    { id: 520, question: "ما حكم بيع المواد المسرطنة؟", answer: "بيع المواد المسرطنة التي تضر بالصحة محرم، لأنها تؤدي إلى التهلكة، والإضرار بالنفس محرم.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["مواد", "مسرطنة", "بيع", "فقه"] },
    { id: 521, question: "ما حكم بيع مواد التنظيف السامة؟", answer: "بيع مواد التنظيف السامة (كالكلور والمواد الكاوية) جائز، مع التحذير من أضرارها، والبيع بغرض الاستعمال المباح.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["تنظيف", "سامة", "بيع", "فقه"] },
    { id: 522, question: "ما حكم بيع المواد المشعة؟", answer: "بيع المواد المشعة (النووية) محرم إلا للضرورة وبإذن الدولة، لأنها قد تؤدي إلى دمار وفتن عظيمة.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["مواد", "مشعة", "بيع", "فقه"] },
    { id: 523, question: "ما حكم بيع المواد المتفجرة؟", answer: "بيع المواد المتفجرة للأفراد محرم، لأنها سبب في الفساد والدمار، وللدولة فقط بالترخيص.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["مواد", "متفجرة", "بيع", "فقه"] },
    { id: 524, question: "ما حكم بيع القنابل اليدوية؟", answer: "بيع القنابل اليدوية للأفراد محرم، لأنها من الأسلحة الخطيرة، وتسبب الفوضى والقتل.", hadith: "وَلَا تَقْتُلُوا النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ (الإسراء:33)", tags: ["قنابل", "يدوية", "بيع", "فقه"] },
    { id: 525, question: "ما حكم بيع الذخيرة؟", answer: "بيع الذخيرة للأفراد جائز بشروط: للدفاع عن النفس، وبترخيص، وعدم بيعها للإرهابيين والمجرمين.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["ذخيرة", "بيع", "فقه", "دفاع"] },
    { id: 526, question: "ما حكم بيع الخوذ العسكرية؟", answer: "بيع الخوذ العسكرية جائز، للاستعمال الشخصي في الدفاع أو للرياضة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["خوذ", "عسكرية", "بيع", "فقه"] },
    { id: 527, question: "ما حكم بيع السترات الواقية من الرصاص؟", answer: "بيع السترات الواقية من الرصاص جائز، للدفاع عن النفس، وللجيش والشرطة، ولا بأس بها.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["سترات", "واقية", "بيع", "فقه"] },
    { id: 528, question: "ما حكم بيع أجهزة كشف الكذب؟", answer: "بيع أجهزة كشف الكذب جائز، للاستعمال المشروع في التحقيقات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كذب", "بيع", "فقه"] },
    { id: 529, question: "ما حكم بيع أجهزة مراقبة الأطفال؟", answer: "بيع أجهزة مراقبة الأطفال جائز، لحراسة الأطفال ورعايتهم، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مراقبة", "أطفال", "بيع", "فقه"] },
    { id: 530, question: "ما حكم بيع أجهزة تحديد المواقع؟", answer: "بيع أجهزة تحديد المواقع (GPS) جائز، للاستخدام في الملاحة والعمل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تحديد", "مواقع", "بيع", "فقه"] },
    { id: 531, question: "ما حكم بيع أجهزة الإنذار؟", answer: "بيع أجهزة الإنذار جائز، للحماية والسلامة، وليس فيها محذور شرعي.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["إنذار", "أجهزة", "بيع", "فقه"] },
    { id: 532, question: "ما حكم بيع كاميرات المراقبة؟", answer: "بيع كاميرات المراقبة جائز، للاستعمال المشروع في حفظ الأمن والممتلكات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["كاميرات", "مراقبة", "بيع", "فقه"] },
    { id: 533, question: "ما حكم بيع أجهزة الكمبيوتر؟", answer: "بيع أجهزة الكمبيوتر جائز، وهي من الأجهزة المباحة، ويستعمل معظمها في الخير.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["كمبيوتر", "أجهزة", "بيع", "فقه"] },
    { id: 534, question: "ما حكم بيع الهواتف المحمولة؟", answer: "بيع الهواتف المحمولة جائز، وهي من الأجهزة المباحة، ويمكن استخدامها في الخير والشر.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["هواتف", "محمولة", "بيع", "فقه"] },
    { id: 535, question: "ما حكم بيع الأجهزة اللوحية؟", answer: "بيع الأجهزة اللوحية (التابلت) جائز، كأجهزة الكمبيوتر، وهي من المباحات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "لوحية", "بيع", "فقه"] },
    { id: 536, question: "ما حكم بيع الساعات الرقمية؟", answer: "بيع الساعات الرقمية جائز، إذا لم تكن من الذهب أو الحرير للرجال، وهي من المباحات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ساعات", "رقمية", "بيع", "فقه"] },
    { id: 537, question: "ما حكم بيع النظارات الطبية؟", answer: "بيع النظارات الطبية جائز، وهي من أجهزة العلاج، وتصح المعاملة فيها.", hadith: "عن أسامة بن شريك قال: قال رسول الله صلى الله عليه وسلم: 'تداووا عباد الله فإن الله لم يضع داء إلا وضع له دواء' رواه الترمذي.", tags: ["نظارات", "طبية", "بيع", "فقه"] },
    { id: 538, question: "ما حكم بيع العدسات اللاصقة؟", answer: "بيع العدسات اللاصقة جائز، إذا كانت للعلاج أو الزينة المباحة، ولا ضرر فيها.", hadith: "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ (البقرة:195)", tags: ["عدسات", "لاصقة", "بيع", "فقه"] },
    { id: 539, question: "ما حكم بيع الأطراف الصناعية؟", answer: "بيع الأطراف الصناعية (كالذراع والرجل) جائز، للمحتاجين، وهو من الإعانة على الخير.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["أطراف", "صناعية", "بيع", "فقه"] },
    { id: 540, question: "ما حكم بيع السماعات الطبية؟", answer: "بيع السماعات الطبية (لمن يعاني ضعف السمع) جائز، وهي من الأجهزة العلاجية المباحة.", hadith: "عن أسامة بن شريك قال: قال رسول الله صلى الله عليه وسلم: 'تداووا عباد الله' رواه الترمذي.", tags: ["سماعات", "طبية", "بيع", "فقه"] },
    { id: 541, question: "ما حكم بيع الكراسي المتحركة؟", answer: "بيع الكراسي المتحركة جائز، لذوي الاحتياجات الخاصة، وبيعها من الإعانة على البر.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["كراسي", "متحركة", "بيع", "فقه"] },
    { id: 542, question: "ما حكم بيع أجهزة قياس الضغط؟", answer: "بيع أجهزة قياس الضغط جائز، وهي من الأجهزة الطبية المباحة، ولا محذور فيها.", hadith: "عن أسامة بن شريك قال: قال رسول الله صلى الله عليه وسلم: 'تداووا عباد الله' رواه الترمذي.", tags: ["أجهزة", "ضغط", "بيع", "فقه"] },
    { id: 543, question: "ما حكم بيع أجهزة السكر؟", answer: "بيع أجهزة قياس السكر جائز، وهي من الأجهزة الطبية المباحة، وبيعها حلال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "سكر", "بيع", "فقه"] },
    { id: 544, question: "ما حكم بيع أجهزة التنفس؟", answer: "بيع أجهزة التنفس (البخاخات) جائز، للمرضى، وهي من الأجهزة العلاجية المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تنفس", "بيع", "فقه"] },
    { id: 545, question: "ما حكم بيع أدوات الحقن؟", answer: "بيع أدوات الحقن (المحاقن) جائز، للاستعمال الطبي المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أدوات", "حقن", "بيع", "فقه"] },
    { id: 546, question: "ما حكم بيع الإبر الطبية؟", answer: "بيع الإبر الطبية جائز، للعلاج، والإعانة على البر، وليس فيها محذور.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["إبر", "طبية", "بيع", "فقه"] },
    { id: 547, question: "ما حكم بيع الأدوات الجراحية؟", answer: "بيع الأدوات الجراحية جائز، للأطباء والمستشفيات، وهي من المباحات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أدوات", "جراحية", "بيع", "فقه"] },
    { id: 548, question: "ما حكم بيع المعدات المخبرية؟", answer: "بيع المعدات المخبرية جائز، للمعامل والأبحاث، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["معدات", "مخبرية", "بيع", "فقه"] },
    { id: 549, question: "ما حكم بيع المجاهر؟", answer: "بيع المجاهر (الميكروسكوبات) جائز، للاستخدام في التعليم والأبحاث، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مجاهر", "بيع", "فقه", "أجهزة"] },
    { id: 550, question: "ما حكم بيع التلسكوبات؟", answer: "بيع التلسكوبات جائز، لمراقبة النجوم، والتعليم، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تلسكوبات", "بيع", "فقه", "أجهزة"] },
    { id: 551, question: "ما حكم بيع آلات التصوير؟", answer: "بيع آلات التصوير جائز، إذا كانت تستعمل في المباح، كالتصوير للتعريف أو التعليم، أما للتصوير المحرم فلا.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه، والبيع إعانة على الحرام.", tags: ["تصوير", "آلات", "بيع", "فقه"] },
    { id: 552, question: "ما حكم بيع كاميرات الفيديو؟", answer: "بيع كاميرات الفيديو جائز، للتصوير المباح (تعليمي، تعريف، توثيق)، محرم للتصوير المحرم.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه.", tags: ["كاميرات", "فيديو", "بيع", "فقه"] },
    { id: 553, question: "ما حكم بيع الميكروفونات؟", answer: "بيع الميكروفونات جائز، للاستخدام في الخطابة والتعليم والوعظ، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ميكروفونات", "بيع", "فقه", "أجهزة"] },
    { id: 554, question: "ما حكم بيع السماعات؟", answer: "بيع السماعات جائز، للاستماع إلى المباح (القرآن، الوعظ، التعليم)، وأما استعمالها في الحرام فمنع.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سماعات", "بيع", "فقه", "أجهزة"] },
    { id: 555, question: "ما حكم بيع مكبرات الصوت؟", answer: "بيع مكبرات الصوت جائز، للأذان والخطب والتعليم، وهي من المباحات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مكبرات", "صوت", "بيع", "فقه"] },
    { id: 556, question: "ما حكم بيع الأقراص المدمجة (CD) الفارغة؟", answer: "بيع الأقراص المدمجة الفارغة جائز، لأنها أداة مباحة، ولا يؤثم البائع باستعمالها في الحرام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أقراص", "مدمجة", "بيع", "فقه"] },
    { id: 557, question: "ما حكم بيع أشرطة التسجيل الفارغة؟", answer: "بيع أشرطة التسجيل الفارغة جائز، وهي من الأدوات المباحة، يباح شراؤها.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أشرطة", "تسجيل", "بيع", "فقه"] },
    { id: 558, question: "ما حكم بيع أجهزة التسجيل؟", answer: "بيع أجهزة التسجيل جائز، لتسجيل العلم والدروس والمحاضرات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تسجيل", "بيع", "فقه"] },
    { id: 559, question: "ما حكم بيع أجهزة العرض (البروجيكتور)؟", answer: "بيع أجهزة العرض جائز، للاستخدام في التعليم والعرض، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "عرض", "بيع", "فقه"] },
    { id: 560, question: "ما حكم بيع السبورات البيضاء؟", answer: "بيع السبورات البيضاء جائز، للتعليم والكتابة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سبورات", "بيضاء", "بيع", "فقه"] },
    { id: 561, question: "ما حكم بيع الأقلام والأدوات المكتبية؟", answer: "بيع الأقلام والأدوات المكتبية جائز، وهي من المباحات، ويمكن استعمالها في الخير والشر.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أقلام", "مكتبية", "بيع", "فقه"] },
    { id: 562, question: "ما حكم بيع الورق والكراسات؟", answer: "بيع الورق والكراسات جائز، للكتابة والتعليم، وهي من المباحات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ورق", "كراسات", "بيع", "فقه"] },
    { id: 563, question: "ما حكم بيع الطابعات؟", answer: "بيع الطابعات جائز، للطباعة المباحة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["طابعات", "بيع", "فقه", "أجهزة"] },
    { id: 564, question: "ما حكم بيع آلات التصوير المستندات؟", answer: "بيع آلات التصوير المستندات جائز، للاستخدام في التصوير المباح، كالكتب والمستندات.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["تصوير", "مستندات", "بيع", "فقه"] },
    { id: 565, question: "ما حكم بيع آلات الفاكس؟", answer: "بيع آلات الفاكس جائز، للاتصالات والمراسلات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["فاكس", "آلات", "بيع", "فقه"] },
    { id: 566, question: "ما حكم بيع أجهزة الترجمة الفورية؟", answer: "بيع أجهزة الترجمة الفورية جائز، لتسهيل التواصل بين اللغات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ترجمة", "بيع", "فقه"] },
    { id: 567, question: "ما حكم بيع القواميس الإلكترونية؟", answer: "بيع القواميس الإلكترونية جائز، لتعلم اللغات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["قواميس", "إلكترونية", "بيع", "فقه"] },
    { id: 568, question: "ما حكم بيع الأجهزة التعليمية للأطفال؟", answer: "بيع الأجهزة التعليمية للأطفال جائز، لتعليمهم العلوم النافعة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تعليمية", "بيع", "فقه"] },
    { id: 569, question: "ما حكم بيع ألعاب الأطفال التعليمية؟", answer: "بيع ألعاب الأطفال التعليمية جائز، لتعليمهم الحروف والأرقام، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ألعاب", "تعليمية", "بيع", "فقه"] },
    { id: 570, question: "ما حكم بيع الألعاب العادية للأطفال؟", answer: "بيع الألعاب العادية للأطفال جائز، بشرط ألا تكون على شكل تماثيل ذوات أرواح، أو فيها صور محرمة.", hadith: "عن ابن عباس قال: قال النبي صلى الله عليه وسلم: 'كل مصور في النار' متفق عليه، والألعاب المجسمة داخلة في ذلك.", tags: ["ألعاب", "أطفال", "بيع", "فقه"] },
    { id: 571, question: "ما حكم بيع الدمى التي على شكل حيوانات؟", answer: "بيع الدمى التي على شكل حيوانات (مجسمات) جائز للأطفال الصغار، للهو البريء، والخلاف فيه واسع.", hadith: "عن عائشة قالت: 'كنت ألعب بالبنات عند النبي صلى الله عليه وسلم' متفق عليه، والدمى داخلة في ذلك.", tags: ["دمى", "حيوانات", "بيع", "فقه"] },
    { id: 572, question: "ما حكم بيع عرائس الأطفال؟", answer: "بيع عرائس الأطفال (الدمى) جائز للصغار، للهو والتسلية، كما كان للصحابة.", hadith: "عن عائشة قالت: 'كنت ألعب بالبنات عند النبي صلى الله عليه وسلم' متفق عليه.", tags: ["عرائس", "أطفال", "بيع", "فقه"] },
    { id: 573, question: "ما حكم بيع ألعاب الفيديو المحتوية على محرم؟", answer: "بيع ألعاب الفيديو المحتوية على صور عارية أو موسيقى أو قمار محرم، لأنه إعانة على الحرام.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["فيديو", "ألعاب", "بيع", "فقه"] },
    { id: 574, question: "ما حكم بيع ألعاب الحاسوب المحرمة؟", answer: "بيع ألعاب الحاسوب التي فيها محرمات (كالقمار والصور العارية) محرم، وهو إعانة على الإثم.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["حاسوب", "ألعاب", "بيع", "فقه"] },
    { id: 575, question: "ما حكم بيع أجهزة الألعاب الإلكترونية؟", answer: "بيع أجهزة الألعاب الإلكترونية (بلاي ستيشن) جائز إذا استعملت في الألعاب المباحة، محرمة إذا استعملت في المحرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ألعاب", "بيع", "فقه"] },
    { id: 576, question: "ما حكم بيع سيارات الألعاب الكهربائية؟", answer: "بيع سيارات الألعاب الكهربائية (للأطفال) جائز، للهو المباح، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سيارات", "ألعاب", "بيع", "فقه"] },
    { id: 577, question: "ما حكم بيع الدراجات الهوائية؟", answer: "بيع الدراجات الهوائية جائز، للرياضة والنقل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["دراجات", "هوائية", "بيع", "فقه"] },
    { id: 578, question: "ما حكم بيع الدراجات النارية؟", answer: "بيع الدراجات النارية جائز، للنقل والتنقل، مع الالتزام بالضوابط الشرعية في الاستعمال.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["دراجات", "نارية", "بيع", "فقه"] },
    { id: 579, question: "ما حكم بيع السيارات الكهربائية؟", answer: "بيع السيارات الكهربائية جائز، وهي من وسائل النقل المباحة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سيارات", "كهربائية", "بيع", "فقه"] },
    { id: 580, question: "ما حكم بيع السيارات الهجينة؟", answer: "بيع السيارات الهجينة (بنزين - كهرباء) جائز، لأنها وسيلة نقل مباحة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["سيارات", "هجينة", "بيع", "فقه"] },
    { id: 581, question: "ما حكم بيع القوارب واليخوت؟", answer: "بيع القوارب واليخوت جائز، للنقل والسياحة، بشرط ألا تستعمل في محرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["قوارب", "يخوت", "بيع", "فقه"] },
    { id: 582, question: "ما حكم بيع الطائرات الخاصة؟", answer: "بيع الطائرات الخاصة جائز، للنقل الشخصي، وهي من وسائل النقل المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["طائرات", "خاصة", "بيع", "فقه"] },
    { id: 583, question: "ما حكم بيع الحافلات؟", answer: "بيع الحافلات جائز، لنقل الركاب، وهي من وسائل النقل المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["حافلات", "بيع", "فقه", "نقل"] },
    { id: 584, question: "ما حكم بيع الشاحنات؟", answer: "بيع الشاحنات جائز، لنقل البضائع، وهي من وسائل النقل المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["شاحنات", "بيع", "فقه", "نقل"] },
    { id: 585, question: "ما حكم بيع مقطورات الجرارات؟", answer: "بيع مقطورات الجرارات جائز، للاستخدام في الزراعة والنقل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مقطورات", "جرارات", "بيع", "فقه"] },
    { id: 586, question: "ما حكم بيع الآلات الزراعية؟", answer: "بيع الآلات الزراعية (جرارات، حصادات) جائز، للاستخدام في الزراعة المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["آلات", "زراعية", "بيع", "فقه"] },
    { id: 587, question: "ما حكم بيع مضخات المياه؟", answer: "بيع مضخات المياه جائز، لري الأراضي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مضخات", "مياه", "بيع", "فقه"] },
    { id: 588, question: "ما حكم بيع مواتير الكهرباء؟", answer: "بيع مواتير الكهرباء جائز، للاستخدام في تشغيل الآلات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مواتير", "كهرباء", "بيع", "فقه"] },
    { id: 589, question: "ما حكم بيع المولدات الكهربائية؟", answer: "بيع المولدات الكهربائية جائز، لتوليد الكهرباء، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مولدات", "كهربائية", "بيع", "فقه"] },
    { id: 590, question: "ما حكم بيع المحولات الكهربائية؟", answer: "بيع المحولات الكهربائية جائز، للاستخدام في تحويل التيار، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["محولات", "كهربائية", "بيع", "فقه"] },
    { id: 591, question: "ما حكم بيع الكوابل والأسلاك؟", answer: "بيع الكوابل والأسلاك الكهربائية جائز، للاستخدام في التمديدات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["كوابل", "أسلاك", "بيع", "فقه"] },
    { id: 592, question: "ما حكم بيع البطاريات؟", answer: "بيع البطاريات الجافة والسائلة جائز، للاستخدام في تشغيل الأجهزة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["بطاريات", "بيع", "فقه", "أجهزة"] },
    { id: 593, question: "ما حكم بيع اللمبات الكهربائية؟", answer: "بيع اللمبات الكهربائية جائز، للإضاءة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["لمبات", "كهربائية", "بيع", "فقه"] },
    { id: 594, question: "ما حكم بيع أجهزة التكييف؟", answer: "بيع أجهزة التكييف (المكيفات) جائز، للتبريد والتدفئة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تكييف", "بيع", "فقه"] },
    { id: 595, question: "ما حكم بيع الثلاجات؟", answer: "بيع الثلاجات جائز، لحفظ الأطعمة، وهي من الأجهزة المباحة.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ثلاجات", "بيع", "فقه", "أجهزة"] },
    { id: 596, question: "ما حكم بيع الغسالات؟", answer: "بيع الغسالات جائز، لتنظيف الملابس، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["غسالات", "بيع", "فقه", "أجهزة"] },
    { id: 597, question: "ما حكم بيع المجففات؟", answer: "بيع المجففات (للملابس) جائز، لتجفيف الملابس، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مجففات", "بيع", "فقه", "أجهزة"] },
    { id: 598, question: "ما حكم بيع المكانس الكهربائية؟", answer: "بيع المكانس الكهربائية جائز، لتنظيف المنازل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مكانس", "كهربائية", "بيع", "فقه"] },
    { id: 599, question: "ما حكم بيع أجهزة المطبخ (الخلاطات، العصارات)؟", answer: "بيع أجهزة المطبخ (كالخلاطات والعصارات) جائز، لتحضير الطعام، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مطبخ", "أجهزة", "بيع", "فقه"] },
    { id: 600, question: "ما حكم بيع أفران الميكروويف؟", answer: "بيع أفران الميكروويف جائز، لتسخين الطعام، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أفران", "ميكروويف", "بيع", "فقه"] },
    { id: 601, question: "ما حكم بيع الأفران الكهربائية؟", answer: "بيع الأفران الكهربائية جائز، للطهي والخبز، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أفران", "كهربائية", "بيع", "فقه"] },
    { id: 602, question: "ما حكم بيع المواقد الكهربائية؟", answer: "بيع المواقد الكهربائية جائز، للطهي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["مواقد", "كهربائية", "بيع", "فقه"] },
    { id: 603, question: "ما حكم بيع غلايات الماء؟", answer: "بيع غلايات الماء (الكهربائية) جائز، لتسخين الماء، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["غلايات", "ماء", "بيع", "فقه"] },
    { id: 604, question: "ما حكم بيع المحامص الكهربائية؟", answer: "بيع المحامص الكهربائية جائز، لتحميص الخبز، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["محامص", "كهربائية", "بيع", "فقه"] },
    { id: 605, question: "ما حكم بيع ماكينات القهوة؟", answer: "بيع ماكينات القهوة جائز، لتحضير القهوة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["ماكينات", "قهوة", "بيع", "فقه"] },
    { id: 606, question: "ما حكم بيع أجهزة صنع الثلج؟", answer: "بيع أجهزة صنع الثلج جائز، لصنع الثلج، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ثلج", "بيع", "فقه"] },
    { id: 607, question: "ما حكم بيع أجهزة تنقية المياه؟", answer: "بيع أجهزة تنقية المياه جائز، لتنقية المياه من الشوائب، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تنقية", "بيع", "فقه"] },
    { id: 608, question: "ما حكم بيع أجهزة تحلية المياه؟", answer: "بيع أجهزة تحلية المياه (لإزالة الملوحة) جائز، للحصول على مياه صالحة للشرب.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحلية", "بيع", "فقه"] },
    { id: 609, question: "ما حكم بيع أجهزة التبريد الصناعية؟", answer: "بيع أجهزة التبريد الصناعية (للمصانع والمخازن) جائز، لحفظ المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تبريد", "بيع", "فقه"] },
