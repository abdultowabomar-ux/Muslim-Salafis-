    { id: 912, question: "ما حكم بيع أجهزة قياس الضغط داخل العين؟", answer: "بيع أجهزة قياس الضغط داخل العين جائز، لمرضى العيون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 913, question: "ما حكم بيع أجهزة قياس حدة البصر؟", answer: "بيع أجهزة قياس حدة البصر جائز، لفحص العيون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 914, question: "ما حكم بيع أجهزة قياس النظر (كمبيوتر)؟", answer: "بيع أجهزة قياس النظر (كمبيوتر طبي) جائز، لفحص العيون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قياس", "بيع", "فقه"] },
    { id: 915, question: "ما حكم بيع أجهزة تصوير قاع العين؟", answer: "بيع أجهزة تصوير قاع العين جائز، للكشف على العيون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 916, question: "ما حكم بيع أجهزة تصوير الشبكية؟", answer: "بيع أجهزة تصوير الشبكية جائز، للكشف على العيون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 917, question: "ما حكم بيع أجهزة الليزر لتصحيح النظر؟", answer: "بيع أجهزة الليزر (لتصحيح النظر) جائز، للعلاج، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 918, question: "ما حكم بيع أجهزة الليزر للجلد؟", answer: "بيع أجهزة الليزر (لإزالة الشعر، تفتيح البشرة) جائز، للعلاج والزينة المباحة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 919, question: "ما حكم بيع أجهزة الليزر للصناعة؟", answer: "بيع أجهزة الليزر للصناعة (قطع، حفر) جائز، للاستخدام الصناعي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 920, question: "ما حكم بيع أجهزة الليزر للاتصالات؟", answer: "بيع أجهزة الليزر للاتصالات (ألياف بصرية) جائز، للاتصالات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 921, question: "ما حكم بيع أجهزة الليزر للقياس؟", answer: "بيع أجهزة الليزر للقياس (مسافات) جائز، للقياس الهندسي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 922, question: "ما حكم بيع أجهزة الليزر للترفيه؟", answer: "بيع أجهزة الليزر للترفيه (عروض ضوئية) جائز، بشرط ألا تستعمل في محرم، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 923, question: "ما حكم بيع أجهزة الليزر العسكرية؟", answer: "بيع أجهزة الليزر العسكرية (توجيه، تحديد) للجيش فقط، وللأفراد محرم لما فيها من ضرر.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "ليزر", "بيع", "فقه"] },
    { id: 924, question: "ما حكم بيع أجهزة الرؤية الليلية (الليزر)؟", answer: "بيع أجهزة الرؤية الليلية (بالتقنيات المختلفة) جائز، للاستخدام المشروع (مراقبة، أمن)، محرم للاستخدام المحرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "رؤية", "بيع", "فقه"] },
    { id: 925, question: "ما حكم بيع أجهزة التصوير الحراري بالليزر؟", answer: "بيع أجهزة التصوير الحراري بالليزر جائز، للاستخدام المشروع (طب، صناعة)، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 926, question: "ما حكم بيع أجهزة المسح ثلاثي الأبعاد (ليزر)؟", answer: "بيع أجهزة المسح ثلاثي الأبعاد (بالليزر) جائز، للهندسة والطب، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "مسح", "بيع", "فقه"] },
    { id: 927, question: "ما حكم بيع أجهزة الطباعة ثلاثية الأبعاد؟", answer: "بيع أجهزة الطباعة ثلاثية الأبعاد جائز، للاستخدام المشروع (صناعة، طب)، محرم إذا استعملت في طباعة تماثيل وأصنام.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طباعة", "بيع", "فقه"] },
    { id: 928, question: "ما حكم بيع أجهزة التصنيع الإضافي؟", answer: "بيع أجهزة التصنيع الإضافي (تصنيع رقمي) جائز، للصناعة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصنيع", "بيع", "فقه"] },
    { id: 929, question: "ما حكم بيع أجهزة التحكم الرقمي (CNC)؟", answer: "بيع أجهزة التحكم الرقمي (CNC) جائز، للصناعة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحكم", "بيع", "فقه"] },
    { id: 930, question: "ما حكم بيع أجهزة التحكم المنطقي القابل للبرمجة (PLC)؟", answer: "بيع أجهزة التحكم المنطقي القابل للبرمجة (PLC) جائز، للتحكم الصناعي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحكم", "بيع", "فقه"] },
    { id: 931, question: "ما حكم بيع أجهزة التحكم في العمليات الصناعية (DCS)؟", answer: "بيع أجهزة التحكم في العمليات الصناعية (DCS) جائز، للمصانع الكبيرة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحكم", "بيع", "فقه"] },
    { id: 932, question: "ما حكم بيع أجهزة التحكم الموزع؟", answer: "بيع أجهزة التحكم الموزع (للمصانع) جائز، للتحكم، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحكم", "بيع", "فقه"] },
    { id: 933, question: "ما حكم بيع أجهزة الأتمتة الصناعية؟", answer: "بيع أجهزة الأتمتة الصناعية (روبوتات، أذرع آلية) جائز، للصناعة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "أتمتة", "بيع", "فقه"] },
    { id: 934, question: "ما حكم بيع أجهزة الروبوتات التعليمية؟", answer: "بيع أجهزة الروبوتات التعليمية جائز، لتعليم الطلاب، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "روبوتات", "بيع", "فقه"] },
    { id: 935, question: "ما حكم بيع أجهزة الروبوتات المنزلية؟", answer: "بيع أجهزة الروبوتات المنزلية (مكانس آلية) جائز، للاستخدام المنزلي، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "روبوتات", "بيع", "فقه"] },
    { id: 936, question: "ما حكم بيع أجهزة الطائرات بدون طيار (درون)؟", answer: "بيع أجهزة الطائرات بدون طيار (درون) جائز، للاستخدام المشروع (تصوير، مراقبة، توصيل)، محرم للتجسس والتصوير المحرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طائرات", "بيع", "فقه"] },
    { id: 937, question: "ما حكم بيع أجهزة الطائرات بدون طيار للتصوير الجوي؟", answer: "بيع أجهزة الطائرات بدون طيار للتصوير الجوي جائز، للتصوير المباح (خرائط، عقارات)، محرم للتصوير المحرم.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تصوير", "بيع", "فقه"] },
    { id: 938, question: "ما حكم بيع أجهزة الطائرات بدون طيار للزراعة؟", answer: "بيع أجهزة الطائرات بدون طيار للزراعة (رش، مراقبة) جائز، للاستخدام الزراعي المباح، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طائرات", "بيع", "فقه"] },
    { id: 939, question: "ما حكم بيع أجهزة الطائرات بدون طيار للتوصيل؟", answer: "بيع أجهزة الطائرات بدون طيار للتوصيل (طرود، بضائع) جائز، للاستخدام المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طائرات", "بيع", "فقه"] },
    { id: 940, question: "ما حكم بيع أجهزة الطائرات بدون طيار العسكرية؟", answer: "بيع أجهزة الطائرات بدون طيار العسكرية (مسلحة) للجيش فقط، وللأفراد محرم، لما فيها من ضرر.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "طائرات", "بيع", "فقه"] },
    { id: 941, question: "ما حكم بيع أجهزة الطائرات بدون طيار للتجسس؟", answer: "بيع أجهزة الطائرات بدون طيار للتجسس (على الناس) محرم، لأنه إعانة على انتهاك الخصوصية وأكل أموال الناس بالباطل.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "طائرات", "بيع", "فقه"] },
    { id: 942, question: "ما حكم بيع أجهزة تشويش الإشارات؟", answer: "بيع أجهزة تشويش الإشارات (جيمر) محرم، لأنها تضر بالآخرين وتعطل الاتصالات، وهو ضرر محرم.", hadith: "لا ضرر ولا ضرار. رواه ابن ماجه.", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 943, question: "ما حكم بيع أجهزة كشف الرادار؟", answer: "بيع أجهزة كشف الرادار (للسيارات) محرم، لأنها تستعمل للتهرب من القانون والضرر بالآخرين.", hadith: "لا ضرر ولا ضرار. رواه ابن ماجه.", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 944, question: "ما حكم بيع أجهزة تعطيل الرادار؟", answer: "بيع أجهزة تعطيل الرادار محرم، لأنها تستعمل للتهرب من القانون والضرر بالآخرين.", hadith: "لا ضرر ولا ضرار. رواه ابن ماجه.", tags: ["أجهزة", "تعطيل", "بيع", "فقه"] },
    { id: 945, question: "ما حكم بيع أجهزة فتح الأبواب بدون مفتاح؟", answer: "بيع أجهزة فتح الأبواب بدون مفتاح (لاقطات) محرم، لأنها تستعمل في السرقة والاعتداء على ممتلكات الغير.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "فتح", "بيع", "فقه"] },
    { id: 946, question: "ما حكم بيع أجهزة نسخ المفاتيح؟", answer: "بيع أجهزة نسخ المفاتيح جائز، للاستخدام المشروع (نسخ مفاتيح المنزل)، محرم لنسخ مفاتيح الغير بدون إذن.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "نسخ", "بيع", "فقه"] },
    { id: 947, question: "ما حكم بيع أجهزة فتح السيارات (سارق)؟", answer: "بيع أجهزة فتح السيارات (لاقطات إشارة) محرم، لأنها تستعمل في سرقة السيارات.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "فتح", "بيع", "فقه"] },
    { id: 948, question: "ما حكم بيع أجهزة تشفير القنوات الفضائية؟", answer: "بيع أجهزة تشفير القنوات الفضائية (للفك) محرم، لأنها تستعمل في اختراق حقوق الآخرين.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تشفير", "بيع", "فقه"] },
    { id: 949, question: "ما حكم بيع أجهزة فك التشفير؟", answer: "بيع أجهزة فك التشفير (للبث الفضائي) محرم، لأنها تستعمل في انتهاك حقوق البث.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "فك", "بيع", "فقه"] },
    { id: 950, question: "ما حكم بيع أجهزة كشف العملات المزيفة؟", answer: "بيع أجهزة كشف العملات المزيفة جائز، للكشف عن التزوير، وهو من الإعانة على البر.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 951, question: "ما حكم بيع أجهزة كشف التزوير؟", answer: "بيع أجهزة كشف التزوير (مستندات، عملات) جائز، للكشف عن التزوير، وليس فيها محذور.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ (المائدة:2)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 952, question: "ما حكم بيع أجهزة عد النقود؟", answer: "بيع أجهزة عد النقود جائز، لتسهيل العد، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "عد", "بيع", "فقه"] },
    { id: 953, question: "ما حكم بيع أجهزة فرز العملات؟", answer: "بيع أجهزة فرز العملات (تمييز الفئات) جائز، لتسهيل التعامل، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "فرز", "بيع", "فقه"] },
    { id: 954, question: "ما حكم بيع أجهزة تغليف العملات؟", answer: "بيع أجهزة تغليف العملات (لف النقود) جائز، لتنظيم العملات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تغليف", "بيع", "فقه"] },
    { id: 955, question: "ما حكم بيع أجهزة تخزين العملات (خزائن)؟", answer: "بيع أجهزة تخزين العملات (خزائن حديدية) جائز، لحفظ الأموال، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تخزين", "بيع", "فقه"] },
    { id: 956, question: "ما حكم بيع أجهزة نقل الأموال (ناقلات)؟", answer: "بيع أجهزة نقل الأموال (سيارات مصفحة) جائز، لنقل الأموال، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "نقل", "بيع", "فقه"] },
    { id: 957, question: "ما حكم بيع أجهزة الصراف الآلي (ATM)؟", answer: "بيع أجهزة الصراف الآلي جائز، لسحب الأموال، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "صراف", "بيع", "فقه"] },
    { id: 958, question: "ما حكم بيع أجهزة نقاط البيع (POS)؟", answer: "بيع أجهزة نقاط البيع (POS) جائز، للدفع الإلكتروني، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "نقاط", "بيع", "فقه"] },
    { id: 959, question: "ما حكم بيع أجهزة قراءة الباركود؟", answer: "بيع أجهزة قراءة الباركود جائز، لتسجيل المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قراءة", "بيع", "فقه"] },
    { id: 960, question: "ما حكم بيع أجهزة طباعة الباركود؟", answer: "بيع أجهزة طباعة الباركود جائز، لطباعة ملصقات المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "طباعة", "بيع", "فقه"] },
    { id: 961, question: "ما حكم بيع أجهزة مسح الباركود؟", answer: "بيع أجهزة مسح الباركود (سكانر) جائز، لقراءة المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "مسح", "بيع", "فقه"] },
    { id: 962, question: "ما حكم بيع أجهزة تسجيل المبيعات (كاشير)؟", answer: "بيع أجهزة تسجيل المبيعات (كاشير) جائز، لتسجيل المعاملات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تسجيل", "بيع", "فقه"] },
    { id: 963, question: "ما حكم بيع أجهزة إدارة المخزون؟", answer: "بيع أجهزة إدارة المخزون جائز، لتنظيم المخزون، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "إدارة", "بيع", "فقه"] },
    { id: 964, question: "ما حكم بيع أجهزة تتبع المخزون (RFID)؟", answer: "بيع أجهزة تتبع المخزون (RFID) جائز، لتتبع المنتجات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تتبع", "بيع", "فقه"] },
    { id: 965, question: "ما حكم بيع أجهزة قراءة البطاقات (RFID reader)؟", answer: "بيع أجهزة قراءة البطاقات (RFID reader) جائز، للقراءة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قراءة", "بيع", "فقه"] },
    { id: 966, question: "ما حكم بيع أجهزة كتابة البطاقات (RFID writer)؟", answer: "بيع أجهزة كتابة البطاقات (RFID writer) جائز، للاستخدام المشروع (كتابة بيانات)، محرم للاستخدام غير المشروع (تزوير).", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كتابة", "بيع", "فقه"] },
    { id: 967, question: "ما حكم بيع أجهزة تشفير البطاقات؟", answer: "بيع أجهزة تشفير البطاقات جائز، لحماية البيانات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تشفير", "بيع", "فقه"] },
    { id: 968, question: "ما حكم بيع أجهزة فك تشفير البطاقات؟", answer: "بيع أجهزة فك تشفير البطاقات (لاقتحام الأنظمة) محرم، لأنها تستعمل في الاختراق والاعتداء.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "تشفير", "بيع", "فقه"] },
    { id: 969, question: "ما حكم بيع أجهزة قراءة البصمة (سكانر)؟", answer: "بيع أجهزة قراءة البصمة (سكانر) جائز، للتعرف على الهوية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "قراءة", "بيع", "فقه"] },
    { id: 970, question: "ما حكم بيع أجهزة التعرف على الوجه؟", answer: "بيع أجهزة التعرف على الوجه جائز، للتعرف على الهوية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تعرف", "بيع", "فقه"] },
    { id: 971, question: "ما حكم بيع أجهزة التعرف على قزحية العين؟", answer: "بيع أجهزة التعرف على قزحية العين جائز، للتعرف على الهوية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تعرف", "بيع", "فقه"] },
    { id: 972, question: "ما حكم بيع أجهزة التعرف على الصوت؟", answer: "بيع أجهزة التعرف على الصوت جائز، للتعرف على الهوية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تعرف", "بيع", "فقه"] },
    { id: 973, question: "ما حكم بيع أجهزة التحكم الصوتي؟", answer: "بيع أجهزة التحكم الصوتي (مساعدات منزلية) جائز، للتحكم في الأجهزة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تحكم", "بيع", "فقه"] },
    { id: 974, question: "ما حكم بيع أجهزة الاستشعار عن بعد؟", answer: "بيع أجهزة الاستشعار عن بعد (أجهزة تحكم) جائز، للتحكم عن بعد، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 975, question: "ما حكم بيع أجهزة الاستشعار اللاسلكي؟", answer: "بيع أجهزة الاستشعار اللاسلكي (مجسات لاسلكية) جائز، للاستخدام في المنازل والمصانع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 976, question: "ما حكم بيع أجهزة الاستشعار البيئي؟", answer: "بيع أجهزة الاستشعار البيئي (لقياس التلوث) جائز، للمحافظة على البيئة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 977, question: "ما حكم بيع أجهزة الاستشعار الزراعي؟", answer: "بيع أجهزة الاستشعار الزراعي (لقياس رطوبة التربة) جائز، للزراعة، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 978, question: "ما حكم بيع أجهزة الاستشعار الطبي؟", answer: "بيع أجهزة الاستشعار الطبي (لقياس العلامات الحيوية) جائز، للعلاج، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 979, question: "ما حكم بيع أجهزة الاستشعار الصناعي؟", answer: "بيع أجهزة الاستشعار الصناعي (للمصانع) جائز، للتحكم في العمليات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 980, question: "ما حكم بيع أجهزة الاستشعار العسكري؟", answer: "بيع أجهزة الاستشعار العسكري للجيش فقط، وللأفراد محرم لما فيها من ضرر.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 981, question: "ما حكم بيع أجهزة الاستشعار الأمني؟", answer: "بيع أجهزة الاستشعار الأمني (للكشف عن المتفجرات) للجهات الأمنية جائز، وللأفراد محرم لخطورتها.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "استشعار", "بيع", "فقه"] },
    { id: 982, question: "ما حكم بيع أجهزة الكشف عن المخدرات؟", answer: "بيع أجهزة الكشف عن المخدرات للجهات الرسمية جائز، وللأفراد محرم، لما فيها من إعانة على التهريب.", hadith: "وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ وَلَا تَعَاوَنُوا عَلَى الْإِثْمِ وَالْعُدْوَانِ (المائدة:2)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 983, question: "ما حكم بيع أجهزة الكشف عن المتفجرات؟", answer: "بيع أجهزة الكشف عن المتفجرات للجهات الأمنية فقط، لأنها خطيرة وتقع في أيدي غير المختصين.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 984, question: "ما حكم بيع أجهزة الكشف عن الألغام؟", answer: "بيع أجهزة الكشف عن الألغام للجيش وللفرق الهندسية جائز، وللأفراد محرم لخطورتها.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 985, question: "ما حكم بيع أجهزة التشويش على المتفجرات؟", answer: "بيع أجهزة التشويش على المتفجرات للجيش والشرطة جائز، وللأفراد محرم.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 986, question: "ما حكم بيع أجهزة التشويش على الاتصالات؟", answer: "بيع أجهزة التشويش على الاتصالات محرم للأفراد، وللجهات الأمنية بترخيص جائز.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 987, question: "ما حكم بيع أجهزة التشويش على الطائرات بدون طيار؟", answer: "بيع أجهزة التشويش على الطائرات بدون طيار للجهات الأمنية جائز، للأفراد محرم.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 988, question: "ما حكم بيع أجهزة التشويش على أجهزة التتبع؟", answer: "بيع أجهزة التشويش على أجهزة التتبع للأفراد محرم، للجهات الرسمية بترخيص.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 989, question: "ما حكم بيع أجهزة التشويش على أجهزة الاستشعار؟", answer: "بيع أجهزة التشويش على أجهزة الاستشعار (لأغراض أمنية) للجهات المختصة، للأفراد محرم.", hadith: "وَأَعِدُّوا لَهُم مَّا اسْتَطَعْتُم مِّن قُوَّةٍ (الأنفال:60)", tags: ["أجهزة", "تشويش", "بيع", "فقه"] },
    { id: 990, question: "ما حكم بيع أجهزة الحماية من التشويش؟", answer: "بيع أجهزة الحماية من التشويش (لحماية الإشارات) جائز، للاستخدام المشروع، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "حماية", "بيع", "فقه"] },
    { id: 991, question: "ما حكم بيع أجهزة التشفير للحماية من الاختراق؟", answer: "بيع أجهزة التشفير للحماية من الاختراق جائز، لحماية البيانات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "تشفير", "بيع", "فقه"] },
    { id: 992, question: "ما حكم بيع أجهزة الجدار الناري (فايروول)؟", answer: "بيع أجهزة الجدار الناري (فايروول) جائز، لحماية الشبكات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "جدار", "بيع", "فقه"] },
    { id: 993, question: "ما حكم بيع أجهزة كشف الاختراق (IDS)؟", answer: "بيع أجهزة كشف الاختراق (IDS) جائز، لحماية الشبكات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "كشف", "بيع", "فقه"] },
    { id: 994, question: "ما حكم بيع أجهزة منع الاختراق (IPS)؟", answer: "بيع أجهزة منع الاختراق (IPS) جائز، لحماية الشبكات، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "منع", "بيع", "فقه"] },
    { id: 995, question: "ما حكم بيع أجهزة إدارة الهوية والوصول؟", answer: "بيع أجهزة إدارة الهوية والوصول (للشركات) جائز، لتنظيم الدخول، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "إدارة", "بيع", "فقه"] },
    { id: 996, question: "ما حكم بيع أجهزة المصادقة الثنائية؟", answer: "بيع أجهزة المصادقة الثنائية (لحماية الحسابات) جائز، لحماية الأموال، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "مصادقة", "بيع", "فقه"] },
    { id: 997, question: "ما حكم بيع أجهزة توليد الرموز المؤقتة (Token)؟", answer: "بيع أجهزة توليد الرموز المؤقتة (Token) جائز، للحماية، وليس فيها محذور.", hadith: "وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا (البقرة:275)", tags: ["أجهزة", "توليد", "بيع", "فقه"] },
